/-! ## Chapter 19 Introduction: Fine Ultrafilters and Hyperfinite Approximation (p. 259) -/

/-- Goldblatt Ch. 19 Introduction (p. 259; cf. §14.3): The **fine ultrafilter** on the directed
poset `Finset α` of finite subsets of `α`, extending `Filter.atTop` so that for every `a : α`,
`{F : Finset α | a ∈ F}` belongs to the ultrafilter. -/
def fineUltrafilter (α : Type*) : Ultrafilter (Finset α) :=
  Ultrafilter.of (Filter.atTop : Filter (Finset α))

/-- `fineUltrafilter α` refines `Filter.atTop` on `Finset α` (Goldblatt p. 259). -/
theorem fineUltrafilter_le_atTop (α : Type*) :
    (fineUltrafilter α : Filter (Finset α)) ≤ Filter.atTop :=
  Ultrafilter.of_le Filter.atTop

/-- Every finite subset `S : Finset α` is contained in `F` for `fineUltrafilter α`-almost all `F`
(Goldblatt p. 259). -/
theorem eventually_subset_fineUltrafilter {α : Type*} (S : Finset α) :
    ∀ᶠ F in (fineUltrafilter α : Filter (Finset α)), S ⊆ F :=
  fineUltrafilter_le_atTop α (Filter.eventually_ge_atTop S)

/-- Every standard element `a : α` belongs to `F` for `fineUltrafilter α`-almost all `F : Finset α`
(Goldblatt p. 259). -/
theorem eventually_mem_fineUltrafilter {α : Type*} (a : α) :
    ∀ᶠ F in (fineUltrafilter α : Filter (Finset α)), a ∈ F := by
  refine (eventually_subset_fineUltrafilter ({a} : Finset α)).mono fun F hF ↦ ?_
  exact Finset.singleton_subset_iff.mp hF

/-- Ultrapower `*α = Germ (fineUltrafilter α) α` of a type `α` over `Finset α`
(Goldblatt Ch. 19 Introduction, p. 259). -/
abbrev StarElem (α : Type*) : Type _ :=
  Germ (fineUltrafilter α : Filter (Finset α)) α

/-- Canonical embedding `a ↦ *a` of standard individuals of `α` into `StarElem α`
(Goldblatt p. 259). -/
def stdElem {α : Type*} (a : α) : StarElem α :=
  (a : StarElem α)

/-- The standard embedding `stdElem : α → StarElem α` is injective (Goldblatt p. 260). -/
theorem stdElem_injective (α : Type*) : Function.Injective (stdElem (α := α)) :=
  fun _ _ h ↦ Germ.const_inj.mp h

@[simp]
theorem stdElem_inj {α : Type*} {a b : α} : stdElem a = stdElem b ↔ a = b :=
  (stdElem_injective α).eq_iff

/-- Internal subset `[F ↦ S F]` of `StarElem α` determined by an indexed family of subsets
`S : Finset α → Set α` (Goldblatt p. 259). -/
def internalApproxSet {α : Type*} (S : Finset α → Set α) : Set (StarElem α) :=
  {x : StarElem α |
    Germ.LiftRel (· ∈ ·) x (S : Germ (fineUltrafilter α : Filter (Finset α)) (Set α))}

@[simp]
theorem coe_mem_internalApproxSet {α : Type*} {f : Finset α → α} {S : Finset α → Set α} :
    (f : StarElem α) ∈ internalApproxSet S ↔
      ∀ᶠ F in (fineUltrafilter α : Filter (Finset α)), f F ∈ S F :=
  Germ.liftRel_coe

@[simp]
theorem stdElem_mem_internalApproxSet {α : Type*} {a : α} {S : Finset α → Set α} :
    stdElem a ∈ internalApproxSet S ↔
      ∀ᶠ F in (fineUltrafilter α : Filter (Finset α)), a ∈ S F :=
  Germ.liftRel_coe

/-- Standard enlargement `*P ⊆ StarElem α` of a subset `P : Set α` (Goldblatt p. 259). -/
def starApproxSet {α : Type*} (P : Set α) : Set (StarElem α) :=
  internalApproxSet (fun _ ↦ P)

@[simp]
theorem coe_mem_starApproxSet {α : Type*} {f : Finset α → α} {P : Set α} :
    (f : StarElem α) ∈ starApproxSet P ↔
      ∀ᶠ F in (fineUltrafilter α : Filter (Finset α)), f F ∈ P :=
  Germ.liftRel_coe

@[simp]
theorem stdElem_mem_starApproxSet {α : Type*} {a : α} {P : Set α} :
    stdElem a ∈ starApproxSet P ↔ a ∈ P :=
  Germ.liftRel_const_iff

/-- An internal subset `X ⊆ StarElem α` is **hyperfinite** if `X = [F ↦ (S F : Set α)]` for a
family of finite sets `S : Finset α → Finset α` (Goldblatt p. 259). -/
def IsHyperfiniteApproxSet {α : Type*} (X : Set (StarElem α)) : Prop :=
  ∃ S : Finset α → Finset α, X = internalApproxSet (fun F ↦ (S F : Set α))

/-- Goldblatt Ch. 19 Introduction (p. 259): The canonical hyperfinite approximant `H = [F ↦ F]`
of `α` inside `StarElem α`. -/
def canonicalHyperfiniteApprox (α : Type*) : Set (StarElem α) :=
  internalApproxSet (fun F ↦ (F : Set α))

/-- `canonicalHyperfiniteApprox α` is hyperfinite (Goldblatt p. 259). -/
theorem isHyperfiniteApproxSet_canonical (α : Type*) :
    IsHyperfiniteApproxSet (canonicalHyperfiniteApprox α) :=
  ⟨id, rfl⟩

/-- Every standard element `stdElem a` belongs to `canonicalHyperfiniteApprox α`
(`A ⊆ B ⊆ *A`, Goldblatt p. 259). -/
theorem stdElem_mem_canonicalHyperfiniteApprox {α : Type*} (a : α) :
    stdElem a ∈ canonicalHyperfiniteApprox α := by
  rw [canonicalHyperfiniteApprox, stdElem_mem_internalApproxSet]
  exact (eventually_mem_fineUltrafilter a).mono fun _ h ↦ h

/-- **Fundamental Hyperfinite Approximation Theorem** (Goldblatt Ch. 19 Introduction, p. 259):
For any subset `P ⊆ α`, there exists a hyperfinite subset `H ⊆ StarElem α` such that
`stdElem '' P ⊆ H` and `H ⊆ starApproxSet P`. -/
theorem exists_hyperfinite_approx_subset {α : Type*} (P : Set α) :
    ∃ H : Set (StarElem α),
      IsHyperfiniteApproxSet H ∧ stdElem '' P ⊆ H ∧ H ⊆ starApproxSet P := by
  let S : Finset α → Finset α := fun F ↦ F.filter (· ∈ P)
  refine ⟨internalApproxSet (fun F ↦ (S F : Set α)), ⟨S, rfl⟩, ?_, ?_⟩
  · rintro _ ⟨a, haP, rfl⟩
    rw [stdElem_mem_internalApproxSet]
    refine (eventually_mem_fineUltrafilter a).mono fun F haF ↦ ?_
    exact Finset.mem_coe.mpr (Finset.mem_filter.mpr ⟨haF, haP⟩)
  · intro x hx
    induction x using Germ.inductionOn with | _ f =>
    rw [coe_mem_internalApproxSet] at hx
    rw [starApproxSet, coe_mem_internalApproxSet]
    exact hx.mono fun F hF ↦ (Finset.mem_filter.mp (Finset.mem_coe.mp hF)).2

/-! ## §19.1 Colourings and Graphs — De Bruijn–Erdős Theorem (pp. 260–261) -/

/-- Goldblatt §19.1 (p. 260): An `r`-colouring of a set `S ⊆ V` as a tuple `C : Fin r → Set V`
of pairwise disjoint sets whose union covers `S` (`S ⊆ C₁ ∪ ⋯ ∪ Cᵣ`). -/
def IsSetPartitionColoring {V : Type*} {r : ℕ} (S : Set V) (C : Fin r → Set V) : Prop :=
  (S ⊆ ⋃ i : Fin r, C i) ∧ Pairwise (fun i j ↦ Disjoint (C i) (C j))

/-- Goldblatt §19.1 (p. 260): Any `r`-colouring of a set `S` is automatically an `r`-colouring of
every subset `T ⊆ S`. -/
theorem IsSetPartitionColoring.mono {V : Type*} {r : ℕ} {S T : Set V} {C : Fin r → Set V}
    (hTS : T ⊆ S) (hC : IsSetPartitionColoring S C) :
    IsSetPartitionColoring T C :=
  ⟨hTS.trans hC.1, hC.2⟩

/-- Goldblatt §19.1 (p. 260): Enlarging a partition `r`-colouring `C₁, …, Cᵣ` of `S` produces a
partition `r`-colouring `*C₁, …, *Cᵣ` of `*S` that agrees with `C` on standard elements! -/
theorem IsSetPartitionColoring.starApprox {V : Type*} {r : ℕ} {S : Set V} {C : Fin r → Set V}
    (hC : IsSetPartitionColoring S C) :
    IsSetPartitionColoring (starApproxSet S) (fun i ↦ starApproxSet (C i)) ∧
      ∀ (i : Fin r) (v : V), stdElem v ∈ starApproxSet (C i) ↔ v ∈ C i := by
  refine ⟨⟨?_, ?_⟩, fun i v ↦ stdElem_mem_starApproxSet⟩
  · intro x hx
    induction x using Germ.inductionOn with | _ f =>
    rw [coe_mem_starApproxSet] at hx
    have hex : ∀ᶠ F in (fineUltrafilter V : Filter (Finset V)), ∃ i : Fin r, f F ∈ C i :=
      hx.mono fun F hF ↦ mem_iUnion.mp (hC.1 hF)
    rw [Ultrafilter.eventually_exists_iff] at hex
    obtain ⟨i, hi⟩ := hex
    exact mem_iUnion.mpr ⟨i, hi⟩
  · intro i j hij
    rw [Set.disjoint_left]
    intro x hxi hxj
    induction x using Germ.inductionOn with | _ f =>
    rw [coe_mem_starApproxSet] at hxi hxj
    obtain ⟨F, hf_i, hf_j⟩ := (hxi.and hxj).exists
    exact (Set.disjoint_left.mp (hC.2 hij)) hf_i hf_j

/-- **Exercise 19.1.1** (Goldblatt §19.1, p. 261): Explicit first-order formula
`Colour(C₁, …, Cᵣ, H, E)` asserting that `C₁, …, Cᵣ` is an `r`-colouring of the subgraph induced
on `H` by the edge relation `Adj`:
1. Every vertex `x ∈ H` belongs to at least one colour class `C i`,
2. Distinct colour classes `C i` and `C j` (`i ≠ j`) are disjoint,
3. No edge `(x, y)` in `H` connects two vertices of the same colour class `C i`. -/
def ColourFormula {V : Type*} {r : ℕ} (H : Set V) (Adj : V → V → Prop)
    (C : Fin r → Set V) : Prop :=
  (∀ x ∈ H, ∃ i : Fin r, x ∈ C i) ∧
  (∀ i j : Fin r, i ≠ j → ∀ x : V, ¬ (x ∈ C i ∧ x ∈ C j)) ∧
  (∀ (i : Fin r), ∀ x ∈ H, ∀ y ∈ H, Adj x y → x ∈ C i → y ∉ C i)

/-- Goldblatt §19.1 (p. 261): Any `r`-colouring of a graph `(H, Adj)` restricts immediately to an
`r`-colouring of any induced subgraph `(K, Adj)` with `K ⊆ H`. -/
theorem ColourFormula.mono {V : Type*} {r : ℕ} {H K : Set V} {Adj : V → V → Prop}
    {C : Fin r → Set V} (hKH : K ⊆ H) (hC : ColourFormula H Adj C) :
    ColourFormula K Adj C :=
  ⟨fun x hx ↦ hC.1 x (hKH hx),
   hC.2.1,
   fun i x hx y hy hadj hxi ↦ hC.2.2 i x (hKH hx) y (hKH hy) hadj hxi⟩

/-- Equivalence between Goldblatt's partition formula `∃ C, ColourFormula H G.Adj C` (Exercise
19.1.1) and Mathlib's `SimpleGraph.Colorable (G.induce H) r` (Goldblatt §19.1, pp. 260–261). -/
theorem exists_colourFormula_iff_induce_colorable {V : Type*} (G : SimpleGraph V)
    (H : Set V) (r : ℕ) :
    (∃ C : Fin r → Set V, ColourFormula H G.Adj C) ↔ (G.induce H).Colorable r := by
  constructor
  · rintro ⟨C, hcov, hdisj, hvalid⟩
    refine ⟨SimpleGraph.Coloring.mk (fun v : H ↦ (hcov v.1 v.2).choose) ?_⟩
    intro u w hadj heq
    set i := (hcov u.1 u.2).choose
    have hu : u.1 ∈ C i := (hcov u.1 u.2).choose_spec
    have hw : w.1 ∈ C i := heq ▸ (hcov w.1 w.2).choose_spec
    exact hvalid i u.1 u.2 w.1 w.2 hadj hu hw
  · rintro ⟨col⟩
    refine ⟨fun i ↦ {x : V | ∃ hx : x ∈ H, col ⟨x, hx⟩ = i}, ?_, ?_, ?_⟩
    · intro x hx
      exact ⟨col ⟨x, hx⟩, hx, rfl⟩
    · rintro i j hij x ⟨⟨hx, h1⟩, ⟨_, h2⟩⟩
      exact hij (h1.symm.trans h2)
    · rintro i x _ y _ hadj ⟨hx', rfl⟩ ⟨hy', hy_eq⟩
      have hadj' : (G.induce H).Adj ⟨x, hx'⟩ ⟨y, hy'⟩ := hadj
      exact col.valid hadj' hy_eq.symm

/-- Global specialization (`H = Set.univ`): `∃ C, ColourFormula Set.univ G.Adj C ↔ G.Colorable r`. -/
theorem exists_colourFormula_univ_iff_colorable {V : Type*} (G : SimpleGraph V) (r : ℕ) :
    (∃ C : Fin r → Set V, ColourFormula Set.univ G.Adj C) ↔ G.Colorable r := by
  rw [exists_colourFormula_iff_induce_colorable]
  exact ⟨fun ⟨col⟩ ↦ ⟨SimpleGraph.Coloring.mk (fun v ↦ col ⟨v, trivial⟩) (fun h ↦ col.valid h)⟩,
         fun ⟨col⟩ ↦ ⟨SimpleGraph.Coloring.mk (fun v ↦ col v.1) (fun h ↦ col.valid h)⟩⟩

/-- Goldblatt §19.1 (p. 260): The enlarged simple graph `(*V, *E)` on `StarElem V` obtained by
lifting `G.Adj` along `fineUltrafilter V`. Irreflexivity and symmetry hold by transfer! -/
def starGraph {V : Type*} (G : SimpleGraph V) : SimpleGraph (StarElem V) where
  Adj := Germ.LiftRel G.Adj
  symm := ⟨fun x y h ↦ by
    induction x using Germ.inductionOn with | _ fx =>
    induction y using Germ.inductionOn with | _ fy =>
    exact (Germ.liftRel_coe.mp h).mono fun _ hF ↦ G.symm.symm _ _ hF⟩
  loopless := ⟨fun x hx ↦ by
    induction x using Germ.inductionOn with | _ fx =>
    obtain ⟨F, hF⟩ := (Germ.liftRel_coe.mp hx).exists
    exact G.loopless.irrefl (fx F) hF⟩

/-- Goldblatt §19.1 (p. 260): Standard vertices have the exact same adjacency in `starGraph G` as
in `G`, i.e., `(x, y) ∈ E ↔ (x, y) ∈ *E`. -/
@[simp]
theorem starGraph_adj_stdElem {V : Type*} (G : SimpleGraph V) (x y : V) :
    (starGraph G).Adj (stdElem x) (stdElem y) ↔ G.Adj x y :=
  Germ.liftRel_const_iff

/-- Goldblatt §19.1 (p. 261, Transfer Step for Hyperfinite Subgraphs):
If every finite induced subgraph `(F, E|_F)` of `G` has an `r`-colouring, then every hyperfinite
induced subgraph `(H, *E|_H)` of `starGraph G` has an `r`-colouring! -/
theorem hyperfinite_subgraph_colourFormula_of_finite {V : Type*} (G : SimpleGraph V) (r : ℕ)
    (hfin : ∀ F : Finset V, (G.induce (F : Set V)).Colorable r)
    {H : Set (StarElem V)} (hH : IsHyperfiniteApproxSet H) :
    ∃ C_star : Fin r → Set (StarElem V), ColourFormula H (starGraph G).Adj C_star := by
  rcases hH with ⟨S, rfl⟩
  have hex_col : ∀ F : Finset V, ∃ C : Fin r → Set V, ColourFormula (S F : Set V) G.Adj C :=
    fun F ↦ (exists_colourFormula_iff_induce_colorable G (S F : Set V) r).mpr (hfin (S F))
  choose C_F hC_F using hex_col
  let C_star : Fin r → Set (StarElem V) := fun i ↦ internalApproxSet (fun F ↦ C_F F i)
  refine ⟨C_star, ?_, ?_, ?_⟩
  · intro x hx
    induction x using Germ.inductionOn with | _ fx =>
    rw [coe_mem_internalApproxSet] at hx
    have hev : ∀ᶠ F in (fineUltrafilter V : Filter (Finset V)), ∃ i : Fin r, fx F ∈ C_F F i :=
      hx.mono fun F hF ↦ (hC_F F).1 (fx F) hF
    rw [Ultrafilter.eventually_exists_iff] at hev
    exact hev
  · intro i j hij x ⟨hxi, hxj⟩
    induction x using Germ.inductionOn with | _ fx =>
    rw [coe_mem_internalApproxSet] at hxi hxj
    obtain ⟨F, h1, h2⟩ := (hxi.and hxj).exists
    exact (hC_F F).2.1 i j hij (fx F) ⟨h1, h2⟩
  · intro i x hx y hy hadj hxi hyi
    induction x using Germ.inductionOn with | _ fx =>
    induction y using Germ.inductionOn with | _ fy =>
    rw [coe_mem_internalApproxSet] at hx hy hxi hyi
    have hadj' : ∀ᶠ F in (fineUltrafilter V : Filter (Finset V)), G.Adj (fx F) (fy F) :=
      Germ.liftRel_coe.mp hadj
    obtain ⟨F, ⟨⟨⟨hxF, hyF⟩, hadjF⟩, hxiF⟩, hyiF⟩ :=
      ((((hx.and hy).and hadj').and hxi).and hyi).exists
    exact (hC_F F).2.2 i (fx F) hxF (fy F) hyF hadjF hxiF hyiF

/-- **De Bruijn–Erdős `k`-Colouring Theorem** (Goldblatt §19.1, pp. 260–261):
A graph `G : SimpleGraph V` (of arbitrary, possibly uncountable cardinality) is `k`-colourable
**if and only if** every finite induced subgraph `G.induce (F : Set V)` (`F : Finset V`) is
`k`-colourable.

Proved via Goldblatt's three-step hyperfinite approximation method:
1. Finite induced subgraphs `(F, E|_F)` have `k`-colourings.
2. Transfer lifts this to a `k`-colouring `C_star` of the canonical hyperfinite approximant
   `H = canonicalHyperfiniteApprox V` containing all of `V`.
3. Pushing down `C_star` to `V` via `stdElem : V ↪ H` immediately `k`-colours `G`! -/
theorem deBruijn_erdos_colorable_iff {V : Type*} (G : SimpleGraph V) (k : ℕ) :
    G.Colorable k ↔ ∀ F : Finset V, (G.induce (F : Set V)).Colorable k := by
  constructor
  · intro hG F
    exact hG.of_hom (SimpleGraph.Embedding.induce (F : Set V)).toHom
  · intro hfin
    obtain ⟨C_star, hC_star⟩ :=
      hyperfinite_subgraph_colourFormula_of_finite G k hfin (isHyperfiniteApproxSet_canonical V)
    rw [← exists_colourFormula_univ_iff_colorable]
    refine ⟨fun i ↦ stdElem ⁻¹' (C_star i), ?_, ?_, ?_⟩
    · intro v _
      exact hC_star.1 (stdElem v) (stdElem_mem_canonicalHyperfiniteApprox v)
    · intro i j hij v ⟨hvi, hvj⟩
      exact hC_star.2.1 i j hij (stdElem v) ⟨hvi, hvj⟩
    · intro i u _ w _ hadj hui hwi
      exact hC_star.2.2 i
        (stdElem u) (stdElem_mem_canonicalHyperfiniteApprox u)
        (stdElem w) (stdElem_mem_canonicalHyperfiniteApprox w)
        ((starGraph_adj_stdElem G u w).mpr hadj) hui hwi

/-- Explicit ultrafilter-germ formulation of the De Bruijn–Erdős theorem: given finite subgraph
colourings `c : ∀ F : Finset V, (G.induce (F : Set V)).Coloring (Fin k)`, there is a global
colouring `col : G.Coloring (Fin k)` such that for every vertex `v : V`, `c F ⟨v, hv⟩ = col v`
for `fineUltrafilter V`-almost all `F : Finset V` (Goldblatt §19.1, pp. 260–261). -/
theorem exists_global_coloring_eventually_eq_finset {V : Type*} (G : SimpleGraph V) (k : ℕ)
    (c : ∀ F : Finset V, (G.induce (F : Set V)).Coloring (Fin k)) :
    ∃ col : G.Coloring (Fin k),
      ∀ v : V, ∀ᶠ F in (fineUltrafilter V : Filter (Finset V)),
        ∃ hv : v ∈ F, c F ⟨v, hv⟩ = col v := by
  have hex_color : ∀ v : V, ∃ i : Fin k,
      ∀ᶠ F in (fineUltrafilter V : Filter (Finset V)), ∃ hv : v ∈ F, c F ⟨v, hv⟩ = i := by
    intro v
    rw [← Ultrafilter.eventually_exists_iff]
    exact (eventually_mem_fineUltrafilter v).mono fun F hv ↦ ⟨c F ⟨v, hv⟩, hv, rfl⟩
  choose color hcolor using hex_color
  refine ⟨SimpleGraph.Coloring.mk color ?_, hcolor⟩
  intro u w hadj heq
  obtain ⟨F, ⟨huF, hcu⟩, ⟨hwF, hcw⟩⟩ := ((hcolor u).and (hcolor w)).exists
  have hadj_F : (G.induce (F : Set V)).Adj ⟨u, huF⟩ ⟨w, hwF⟩ := hadj
  exact (c F).valid hadj_F (hcu.trans (heq.trans hcw.symm))

/-- Relational De Bruijn–Erdős theorem for an arbitrary irreflexive symmetric binary relation
`Adj : V → V → Prop` matching Goldblatt's raw `(G, E)` definition (§19.1, p. 260). -/
theorem deBruijn_erdos_rel_iff {V : Type*} (Adj : V → V → Prop)
    (hirrefl : Std.Irrefl Adj) (hsymm : Std.Symm Adj) (r : ℕ) :
    (∃ C : Fin r → Set V, ColourFormula Set.univ Adj C) ↔
      ∀ F : Finset V, ∃ C : Fin r → Set V, ColourFormula (F : Set V) Adj C := by
  let G : SimpleGraph V := { Adj := Adj, symm := hsymm, loopless := hirrefl }
  rw [exists_colourFormula_univ_iff_colorable G r, deBruijn_erdos_colorable_iff G r]
  exact forall_congr' fun F ↦ (exists_colourFormula_iff_induce_colorable G (F : Set V) r).symm

/-- Chromatic number consequence of the De Bruijn–Erdős theorem: the chromatic number of any graph
`G` equals the supremum of the chromatic numbers of its finite induced subgraphs
(Goldblatt §19.1, p. 261). -/
theorem chromaticNumber_eq_iSup_finset {V : Type*} (G : SimpleGraph V) :
    G.chromaticNumber = ⨆ F : Finset V, (G.induce (F : Set V)).chromaticNumber := by
  apply le_antisymm
  · cases hsup : (⨆ F : Finset V, (G.induce (F : Set V)).chromaticNumber) with
    | top => exact le_top
    | coe k =>
      rw [SimpleGraph.chromaticNumber_le_iff_colorable, deBruijn_erdos_colorable_iff]
      intro F
      rw [← SimpleGraph.chromaticNumber_le_iff_colorable]
      exact le_iSup (fun F : Finset V ↦ (G.induce (F : Set V)).chromaticNumber) F |>.trans hsup.le
  · refine iSup_le fun F ↦ ?_
    cases hG : G.chromaticNumber with
    | top => exact le_top
    | coe k =>
      rw [SimpleGraph.chromaticNumber_le_iff_colorable]
      have hk : G.Colorable k := SimpleGraph.chromaticNumber_le_iff_colorable.mp hG.le
      exact hk.of_hom (SimpleGraph.Embedding.induce (F : Set V)).toHom

/-! ## §19.2 Boolean Algebras and Formula Algebras `B_Π` (pp. 262–265) -/

/-- Goldblatt §19.2 (pp. 262–263): Propositional `Π`-formulae built inductively from sentence
symbols `Sym` using negation `¬`, conjunction `∧`, disjunction `∨`, implication `→`, and
equivalence `↔`. -/
inductive PropFormula (Sym : Type*) : Type _
  | var : Sym → PropFormula Sym
  | neg : PropFormula Sym → PropFormula Sym
  | conj : PropFormula Sym → PropFormula Sym → PropFormula Sym
  | disj : PropFormula Sym → PropFormula Sym → PropFormula Sym
  | imp : PropFormula Sym → PropFormula Sym → PropFormula Sym
  | iff : PropFormula Sym → PropFormula Sym → PropFormula Sym

namespace PropFormula

/-- Goldblatt §19.2 (pp. 262–263): Truth-value evaluation `v(φ)` of a `Π`-formula `φ` under a
Boolean valuation `v : Sym → Bool`. -/
def eval {Sym : Type*} (φ : PropFormula Sym) (v : Sym → Bool) : Bool :=
  match φ with
  | .var p => v p
  | .neg ψ => !(ψ.eval v)
  | .conj ψ χ => ψ.eval v && χ.eval v
  | .disj ψ χ => ψ.eval v || χ.eval v
  | .imp ψ χ => !(ψ.eval v) || χ.eval v
  | .iff ψ χ => ψ.eval v == χ.eval v

/-- Goldblatt §19.2 (p. 263): A `Π`-formula `φ` is a **tautology** if `v(φ) = T` for all
valuations `v : Sym → Bool`. -/
def IsTautology {Sym : Type*} (φ : PropFormula Sym) : Prop :=
  ∀ v : Sym → Bool, φ.eval v = true

/-- Goldblatt §19.2 (p. 263): A `Π`-formula `φ` is **inconsistent** if `v(φ) = F` for all
valuations `v : Sym → Bool`. -/
def IsInconsistent {Sym : Type*} (φ : PropFormula Sym) : Prop :=
  ∀ v : Sym → Bool, φ.eval v = false

/-- Goldblatt §19.2 (p. 263): Two `Π`-formulae `φ` and `ψ` are **equivalent** (`φ ≈ ψ`) if they
take the same truth value under every valuation `v : Sym → Bool`. -/
def FormulaEquiv {Sym : Type*} (φ ψ : PropFormula Sym) : Prop :=
  ∀ v : Sym → Bool, φ.eval v = ψ.eval v

/-- Goldblatt §19.2 (p. 263): `φ ≈ ψ` holds if and only if the biconditional `φ ↔ ψ` is a
tautology. -/
theorem formulaEquiv_iff_iff_tautology {Sym : Type*} (φ ψ : PropFormula Sym) :
    FormulaEquiv φ ψ ↔ IsTautology (.iff φ ψ) := by
  unfold FormulaEquiv IsTautology
  exact forall_congr' fun v ↦ by simp [eval]

/-- Finite set of sentence symbols occurring in a `Π`-formula `φ` (Goldblatt §19.3, p. 266). -/
def vars {Sym : Type*} [DecidableEq Sym] : PropFormula Sym → Finset Sym
  | .var p => {p}
  | .neg ψ => ψ.vars
  | .conj ψ χ => ψ.vars ∪ χ.vars
  | .disj ψ χ => ψ.vars ∪ χ.vars
  | .imp ψ χ => ψ.vars ∪ χ.vars
  | .iff ψ χ => ψ.vars ∪ χ.vars

/-- Goldblatt §19.3 (p. 266): The truth value of `φ` under `v` depends only on the values of `v`
at sentence symbols occurring in `φ`. -/
theorem eval_congr_vars {Sym : Type*} [DecidableEq Sym] (φ : PropFormula Sym)
    {v₁ v₂ : Sym → Bool} (h : ∀ p ∈ φ.vars, v₁ p = v₂ p) :
    φ.eval v₁ = φ.eval v₂ := by
  induction φ with
  | var p => exact h p (Finset.mem_singleton_self p)
  | neg ψ ih => simp [eval, ih h]
  | conj ψ χ ih₁ ih₂ =>
    simp [eval, ih₁ fun p hp ↦ h p (Finset.mem_union_left _ hp),
      ih₂ fun p hp ↦ h p (Finset.mem_union_right _ hp)]
  | disj ψ χ ih₁ ih₂ =>
    simp [eval, ih₁ fun p hp ↦ h p (Finset.mem_union_left _ hp),
      ih₂ fun p hp ↦ h p (Finset.mem_union_right _ hp)]
  | imp ψ χ ih₁ ih₂ =>
    simp [eval, ih₁ fun p hp ↦ h p (Finset.mem_union_left _ hp),
      ih₂ fun p hp ↦ h p (Finset.mem_union_right _ hp)]
  | iff ψ χ ih₁ ih₂ =>
    simp [eval, ih₁ fun p hp ↦ h p (Finset.mem_union_left _ hp),
      ih₂ fun p hp ↦ h p (Finset.mem_union_right _ hp)]

/-- Canonical tautology `p₀ ∨ ¬p₀` for a nonempty symbol set `Sym` (Goldblatt §19.2, p. 263). -/
def verum (Sym : Type*) [Nonempty Sym] : PropFormula Sym :=
  let p₀ := Classical.arbitrary Sym
  .disj (.var p₀) (.neg (.var p₀))

/-- Canonical inconsistent formula `p₀ ∧ ¬p₀` for a nonempty symbol set `Sym`
(Goldblatt §19.2, p. 263). -/
def falsum (Sym : Type*) [Nonempty Sym] : PropFormula Sym :=
  let p₀ := Classical.arbitrary Sym
  .conj (.var p₀) (.neg (.var p₀))

@[simp]
theorem eval_verum {Sym : Type*} [Nonempty Sym] (v : Sym → Bool) :
    (verum Sym).eval v = true := by
  simp [verum, eval]

@[simp]
theorem eval_falsum {Sym : Type*} [Nonempty Sym] (v : Sym → Bool) :
    (falsum Sym).eval v = false := by
  simp [falsum, eval]

/-- Literal `p` or `¬p` matching the truth value `v₀ p` (Exercise 19.2.1, p. 265). -/
def literalFor {Sym : Type*} (v₀ : Sym → Bool) (p : Sym) : PropFormula Sym :=
  if v₀ p then .var p else .neg (.var p)

@[simp]
theorem eval_literalFor {Sym : Type*} (v₀ v : Sym → Bool) (p : Sym) :
    (literalFor v₀ p).eval v = (v p == v₀ p) := by
  unfold literalFor
  cases hv₀ : v₀ p <;> cases hv : v p <;> simp_all [eval]

/-- Conjunction over a list of sentence symbols characterizing a valuation `v₀` on that list
(Exercise 19.2.1, p. 265). -/
def conjLiteralsList {Sym : Type*} [Nonempty Sym] (v₀ : Sym → Bool) : List Sym → PropFormula Sym
  | [] => verum Sym
  | p :: ps => .conj (literalFor v₀ p) (conjLiteralsList v₀ ps)

theorem eval_conjLiteralsList_eq_true {Sym : Type*} [Nonempty Sym]
    (v₀ v : Sym → Bool) (ps : List Sym) :
    (conjLiteralsList v₀ ps).eval v = true ↔ ∀ p ∈ ps, v p = v₀ p := by
  induction ps with
  | nil => simp [conjLiteralsList]
  | cons p ps ih =>
    simp [conjLiteralsList, eval, ih]

/-- **Exercise 19.2.1** (Goldblatt §19.2, p. 265): Complete conjunction `φ_{v₀}` of literals over
a finite nonempty symbol set `Sym` satisfied uniquely by `v₀`. -/
def valuationTerm {Sym : Type*} [Nonempty Sym] [Fintype Sym] (v₀ : Sym → Bool) : PropFormula Sym :=
  conjLiteralsList v₀ (Finset.univ : Finset Sym).toList

theorem eval_valuationTerm_eq_true {Sym : Type*} [Nonempty Sym] [Fintype Sym]
    (v₀ v : Sym → Bool) :
    (valuationTerm v₀).eval v = true ↔ v = v₀ := by
  rw [valuationTerm, eval_conjLiteralsList_eq_true]
  constructor
  · intro h
    funext p
    exact h p (Finset.mem_toList.mpr (Finset.mem_univ p))
  · rintro rfl _ _
    rfl

/-- Disjunction of `valuationTerm`s over a list of valuations (Exercise 19.2.1, p. 265). -/
def disjValuationsList {Sym : Type*} [Nonempty Sym] [Fintype Sym] :
    List (Sym → Bool) → PropFormula Sym
  | [] => falsum Sym
  | v₀ :: vs => .disj (valuationTerm v₀) (disjValuationsList vs)

theorem eval_disjValuationsList_eq_true {Sym : Type*} [Nonempty Sym] [Fintype Sym]
    (vs : List (Sym → Bool)) (v : Sym → Bool) :
    (disjValuationsList vs).eval v = true ↔ v ∈ vs := by
  induction vs with
  | nil => simp [disjValuationsList]
  | cons v₀ vs ih =>
    simp [disjValuationsList, eval, eval_valuationTerm_eq_true, ih]

/-- **Exercise 19.2.1** (Goldblatt §19.2, p. 265): Disjunctive normal form `Π`-formula realizing an
arbitrary truth-table predicate `P : (Sym → Bool) → Bool` when `Sym` is finite and nonempty. -/
def dnfFormula {Sym : Type*} [Nonempty Sym] [Fintype Sym]
    (P : (Sym → Bool) → Bool) : PropFormula Sym :=
  disjValuationsList (((Finset.univ : Finset (Sym → Bool)).filter fun v₀ ↦ P v₀ = true).toList)

@[simp]
theorem eval_dnfFormula {Sym : Type*} [Nonempty Sym] [Fintype Sym]
    (P : (Sym → Bool) → Bool) (v : Sym → Bool) :
    (dnfFormula P).eval v = P v := by
  cases hPv : P v
  · rw [Bool.eq_false_iff]
    intro htrue
    rw [dnfFormula, eval_disjValuationsList_eq_true, Finset.mem_toList, Finset.mem_filter] at htrue
    exact absurd htrue.2 (by simp [hPv])
  · rw [dnfFormula, eval_disjValuationsList_eq_true, Finset.mem_toList, Finset.mem_filter]
    exact ⟨Finset.mem_univ v, hPv⟩

end PropFormula

/-- Equivalence setoid on `PropFormula Sym` given by logical equivalence `FormulaEquiv`
(Goldblatt §19.2, p. 263). -/
def formulaSetoid (Sym : Type*) : Setoid (PropFormula Sym) where
  r := PropFormula.FormulaEquiv
  iseqv := {
    refl := fun _ _ ↦ rfl
    symm := fun h v ↦ (h v).symm
    trans := fun h₁ h₂ v ↦ (h₁ v).trans (h₂ v)
  }

/-- Goldblatt §19.2 (pp. 263–264): The **Lindenbaum–Tarski formula algebra** `B_Π` of equivalence
classes `[φ]` of `Π`-formulae modulo logical equivalence. -/
def FormulaAlgebra (Sym : Type*) : Type _ :=
  Quotient (formulaSetoid Sym)

namespace FormulaAlgebra

/-- Equivalence class `[φ] ∈ B_Π` of a `Π`-formula `φ` (Goldblatt §19.2, p. 263). -/
def mk {Sym : Type*} (φ : PropFormula Sym) : FormulaAlgebra Sym :=
  Quotient.mk (formulaSetoid Sym) φ

/-- Generator `[p] ∈ B_Π` associated to a sentence symbol `p : Sym` (Goldblatt §19.2, p. 263). -/
def ofVar {Sym : Type*} (p : Sym) : FormulaAlgebra Sym :=
  mk (.var p)

/-- Well-defined Boolean truth-table evaluation on `FormulaAlgebra Sym` (Goldblatt §19.2, p. 263). -/
def eval {Sym : Type*} (x : FormulaAlgebra Sym) (v : Sym → Bool) : Bool :=
  Quotient.liftOn x (fun φ ↦ φ.eval v) (fun _ _ h ↦ h v)

@[simp]
theorem eval_mk {Sym : Type*} (φ : PropFormula Sym) (v : Sym → Bool) :
    (mk φ).eval v = φ.eval v :=
  rfl

@[ext]
theorem ext {Sym : Type*} {x y : FormulaAlgebra Sym}
    (h : ∀ v : Sym → Bool, x.eval v = y.eval v) :
    x = y := by
  induction x using Quotient.inductionOn with | _ φ =>
  induction y using Quotient.inductionOn with | _ ψ =>
  exact Quotient.sound h

/-- Goldblatt §19.2 (pp. 263–264): `FormulaAlgebra Sym` (`B_Π`) is a Boolean algebra under
`[φ] ⊔ [ψ] = [φ ∨ ψ]`, `[φ] ⊓ [ψ] = [φ ∧ ψ]`, `[φ]ᶜ = [¬φ]`, `⊤ = [p ∨ ¬p]`, `⊥ = [p ∧ ¬p]`. -/
instance instBooleanAlgebra {Sym : Type*} [Nonempty Sym] : BooleanAlgebra (FormulaAlgebra Sym) where
  sup := Quotient.map₂ PropFormula.disj fun _ _ h₁ _ _ h₂ v ↦ by
    simp [PropFormula.eval, h₁ v, h₂ v]
  inf := Quotient.map₂ PropFormula.conj fun _ _ h₁ _ _ h₂ v ↦ by
    simp [PropFormula.eval, h₁ v, h₂ v]
  compl := Quotient.map PropFormula.neg fun _ _ h v ↦ by
    simp [PropFormula.eval, h v]
  top := mk (PropFormula.verum Sym)
  bot := mk (PropFormula.falsum Sym)
  le x y := ∀ v : Sym → Bool, x.eval v ≤ y.eval v
  le_refl _ _ := le_rfl
  le_trans _ _ _ h₁ h₂ v := (h₁ v).trans (h₂ v)
  le_antisymm _ _ h₁ h₂ := ext fun v ↦ le_antisymm (h₁ v) (h₂ v)
  le_sup_left x y v := by
    induction x using Quotient.inductionOn with | _ φ =>
    induction y using Quotient.inductionOn with | _ ψ =>
    change φ.eval v ≤ (φ.eval v || ψ.eval v)
    rw [← Bool.sup_eq_bor]; exact le_sup_left
  le_sup_right x y v := by
    induction x using Quotient.inductionOn with | _ φ =>
    induction y using Quotient.inductionOn with | _ ψ =>
    change ψ.eval v ≤ (φ.eval v || ψ.eval v)
    rw [← Bool.sup_eq_bor]; exact le_sup_right
  sup_le x y z h₁ h₂ v := by
    induction x using Quotient.inductionOn with | _ φ =>
    induction y using Quotient.inductionOn with | _ ψ =>
    change (φ.eval v || ψ.eval v) ≤ z.eval v
    rw [← Bool.sup_eq_bor]; exact sup_le (h₁ v) (h₂ v)
  inf_le_left x y v := by
    induction x using Quotient.inductionOn with | _ φ =>
    induction y using Quotient.inductionOn with | _ ψ =>
    change (φ.eval v && ψ.eval v) ≤ φ.eval v
    rw [← Bool.inf_eq_band]; exact inf_le_left
  inf_le_right x y v := by
    induction x using Quotient.inductionOn with | _ φ =>
    induction y using Quotient.inductionOn with | _ ψ =>
    change (φ.eval v && ψ.eval v) ≤ ψ.eval v
    rw [← Bool.inf_eq_band]; exact inf_le_right
  le_inf x y z h₁ h₂ v := by
    induction y using Quotient.inductionOn with | _ φ =>
    induction z using Quotient.inductionOn with | _ ψ =>
    change x.eval v ≤ (φ.eval v && ψ.eval v)
    rw [← Bool.inf_eq_band]; exact le_inf (h₁ v) (h₂ v)
  le_sup_inf x y z v := by
    induction x using Quotient.inductionOn with | _ φ =>
    induction y using Quotient.inductionOn with | _ ψ =>
    induction z using Quotient.inductionOn with | _ χ =>
    change ((φ.eval v || ψ.eval v) && (φ.eval v || χ.eval v)) ≤
      (φ.eval v || (ψ.eval v && χ.eval v))
    cases φ.eval v <;> cases ψ.eval v <;> cases χ.eval v <;> decide
  inf_compl_le_bot x v := by
    induction x using Quotient.inductionOn with | _ φ =>
    change (φ.eval v && !(φ.eval v)) ≤ (PropFormula.falsum Sym).eval v
    rw [PropFormula.eval_falsum]
    cases φ.eval v <;> decide
  top_le_sup_compl x v := by
    induction x using Quotient.inductionOn with | _ φ =>
    change (PropFormula.verum Sym).eval v ≤ (φ.eval v || !(φ.eval v))
    rw [PropFormula.eval_verum]
    cases φ.eval v <;> decide
  le_top x v := by
    change x.eval v ≤ (PropFormula.verum Sym).eval v
    rw [PropFormula.eval_verum]; exact le_top
  bot_le x v := by
    change (PropFormula.falsum Sym).eval v ≤ x.eval v
    rw [PropFormula.eval_falsum]; exact bot_le

@[simp]
theorem eval_sup {Sym : Type*} [Nonempty Sym] (x y : FormulaAlgebra Sym) (v : Sym → Bool) :
    (x ⊔ y).eval v = (x.eval v || y.eval v) := by
  induction x using Quotient.inductionOn with | _ φ =>
  induction y using Quotient.inductionOn with | _ ψ =>
  rfl

@[simp]
theorem eval_inf {Sym : Type*} [Nonempty Sym] (x y : FormulaAlgebra Sym) (v : Sym → Bool) :
    (x ⊓ y).eval v = (x.eval v && y.eval v) := by
  induction x using Quotient.inductionOn with | _ φ =>
  induction y using Quotient.inductionOn with | _ ψ =>
  rfl

@[simp]
theorem eval_compl {Sym : Type*} [Nonempty Sym] (x : FormulaAlgebra Sym) (v : Sym → Bool) :
    (xᶜ).eval v = !(x.eval v) := by
  induction x using Quotient.inductionOn with | _ φ =>
  rfl

@[simp]
theorem eval_top {Sym : Type*} [Nonempty Sym] (v : Sym → Bool) :
    (⊤ : FormulaAlgebra Sym).eval v = true :=
  PropFormula.eval_verum v

@[simp]
theorem eval_bot {Sym : Type*} [Nonempty Sym] (v : Sym → Bool) :
    (⊥ : FormulaAlgebra Sym).eval v = false :=
  PropFormula.eval_falsum v

theorem le_def {Sym : Type*} [Nonempty Sym] {x y : FormulaAlgebra Sym} :
    x ≤ y ↔ ∀ v : Sym → Bool, x.eval v ≤ y.eval v :=
  Iff.rfl

instance {Sym : Type*} [Nonempty Sym] : Nontrivial (FormulaAlgebra Sym) :=
  ⟨⟨⊥, ⊤, fun h ↦ by
    have hv := congrArg (fun z : FormulaAlgebra Sym ↦ z.eval (fun _ ↦ true)) h
    simp at hv⟩⟩

/-- Goldblatt §19.2 (p. 264): `[φ] = ⊤` in `B_Π` if and only if `φ` is a tautology. -/
theorem mk_eq_top_iff {Sym : Type*} [Nonempty Sym] (φ : PropFormula Sym) :
    mk φ = ⊤ ↔ φ.IsTautology := by
  constructor
  · intro h v
    simpa using congrArg (fun z : FormulaAlgebra Sym ↦ z.eval v) h
  · intro h
    ext v
    simp [h v]

/-- Goldblatt §19.2 (p. 264): `[φ] = ⊥` in `B_Π` if and only if `φ` is inconsistent. -/
theorem mk_eq_bot_iff {Sym : Type*} [Nonempty Sym] (φ : PropFormula Sym) :
    mk φ = ⊥ ↔ φ.IsInconsistent := by
  constructor
  · intro h v
    simpa using congrArg (fun z : FormulaAlgebra Sym ↦ z.eval v) h
  · intro h
    ext v
    simp [h v]

/-- Goldblatt §19.2 (p. 264): `[φ] ≤ [ψ]` in `B_Π` if and only if `φ → ψ` is a tautology. -/
theorem mk_le_mk_iff_imp_tautology {Sym : Type*} [Nonempty Sym] (φ ψ : PropFormula Sym) :
    mk φ ≤ mk ψ ↔ (PropFormula.imp φ ψ).IsTautology := by
  constructor
  · intro h v
    have hv : φ.eval v ≤ ψ.eval v := h v
    simp only [PropFormula.eval]
    cases hφ : φ.eval v <;> cases hψ : ψ.eval v
    · rfl
    · rfl
    · rw [hφ, hψ] at hv; exact absurd hv (by decide)
    · rfl
  · intro h v
    have hv := h v
    simp only [PropFormula.eval] at hv
    change φ.eval v ≤ ψ.eval v
    cases hφ : φ.eval v <;> cases hψ : ψ.eval v
    · exact le_rfl
    · exact bot_le
    · rw [hφ, hψ] at hv; exact absurd hv (by decide)
    · exact le_rfl

end FormulaAlgebra

/-- **Exercise 19.2.1(a)** (Goldblatt §19.2, p. 265): When `Sym` is finite and nonempty, every set
`V` of Boolean valuations `Sym → Bool` is the truth-set `{v | v(φ) = T}` of some `Π`-formula `φ`
(constructed in disjunctive normal form). -/
theorem exercise_19_2_1_realize_valuations {Sym : Type*} [Nonempty Sym] [Fintype Sym]
    (V : Set (Sym → Bool)) :
    ∃ φ : PropFormula Sym, {v : Sym → Bool | φ.eval v = true} = V := by
  refine ⟨PropFormula.dnfFormula (fun v ↦ decide (v ∈ V)), ?_⟩
  ext v
  simp

/-- **Exercise 19.2.1(b)** (Goldblatt §19.2, p. 265): Order (hence Boolean algebra) isomorphism
between `FormulaAlgebra Sym` and the Boolean algebra `(Sym → Bool) → Bool` of truth tables when
`Sym` is finite and nonempty. -/
def formulaAlgebraOrderIso (Sym : Type*) [Nonempty Sym] [Fintype Sym] :
    FormulaAlgebra Sym ≃o ((Sym → Bool) → Bool) where
  toFun := FormulaAlgebra.eval
  invFun P := FormulaAlgebra.mk (PropFormula.dnfFormula P)
  left_inv x := by
    ext v
    simp
  right_inv P := by
    funext v
    simp
  map_rel_iff' := Iff.rfl

/-- **Exercise 19.2.1(c)** (Goldblatt §19.2, p. 265): Order isomorphism between
`FormulaAlgebra Sym` and the power-set algebra `Set (Sym → Bool)` of sets of valuations when `Sym`
is finite and nonempty. -/
def formulaAlgebraOrderIsoSetValuations (Sym : Type*) [Nonempty Sym] [Fintype Sym] :
    FormulaAlgebra Sym ≃o Set (Sym → Bool) where
  toFun x := {v : Sym → Bool | x.eval v = true}
  invFun V := FormulaAlgebra.mk (PropFormula.dnfFormula (fun v ↦ decide (v ∈ V)))
  left_inv x := by
    ext v
    cases hx : x.eval v <;> simp [hx]
  right_inv V := by
    ext v
    simp
  map_rel_iff' {x y} := by
    constructor
    · intro h v
      cases hx : x.eval v
      · exact bot_le
      · have hy : y.eval v = true := h hx
        simp [hy]
    · intro h v hx
      have hv := h v
      rw [hx] at hv
      exact top_unique hv

instance {Sym : Type*} [Nonempty Sym] [Finite Sym] : Finite (FormulaAlgebra Sym) := by
  cases nonempty_fintype Sym
  exact Finite.of_equiv ((Sym → Bool) → Bool) (formulaAlgebraOrderIso Sym).toEquiv.symm

/-- **Exercise 19.2.1(d)** (Goldblatt §19.2, p. 265): If `Sym` is finite and nonempty with `n`
sentence symbols, then `B_Π` has exactly `2^(2^n)` elements! -/
theorem natCard_formulaAlgebra (Sym : Type*) [Nonempty Sym] [Fintype Sym] :
    Nat.card (FormulaAlgebra Sym) = 2 ^ (2 ^ Fintype.card Sym) := by
  rw [Nat.card_congr (formulaAlgebraOrderIso Sym).toEquiv, Nat.card_eq_fintype_card]
  simp [Fintype.card_pi]

/-! ## §19.3 Atomic and Finite Boolean Algebras (pp. 265–267) -/

/-- Goldblatt §19.3 (pp. 266–267): If the set `Sym` of sentence symbols is **infinite**, then the
formula algebra `FormulaAlgebra Sym` (`B_Π`) has **no atoms** (`∀ x, ¬ IsAtom x`), and in
particular is not atomic!

Proved following Goldblatt's exact argument: for any nonzero `x = [φ]`, pick `p ∈ Sym` not
occurring in `φ`; then `y = [φ ∧ p]` satisfies `⊥ < y < x`. -/
theorem formulaAlgebra_no_atoms_of_infinite {Sym : Type*} [Infinite Sym] :
    ∀ x : FormulaAlgebra Sym, ¬ IsAtom x := by
  classical
  have : Nonempty Sym := inferInstance
  intro x hx
  induction x using Quotient.inductionOn with | _ φ =>
  have hφ_not_inconsistent : ¬ φ.IsInconsistent := by
    intro hinc
    exact hx.ne_bot ((FormulaAlgebra.mk_eq_bot_iff φ).mpr hinc)
  unfold PropFormula.IsInconsistent at hφ_not_inconsistent
  push Not at hφ_not_inconsistent
  obtain ⟨v₀, hv₀⟩ := hφ_not_inconsistent
  have hv₀_true : φ.eval v₀ = true := by
    cases h : φ.eval v₀
    · exact absurd h hv₀
    · rfl
  obtain ⟨p, _, hp_not_mem⟩ := Set.infinite_univ.exists_notMem_finset φ.vars
  let y : FormulaAlgebra Sym := FormulaAlgebra.mk (.conj φ (.var p))
  have hy_le_x : y ≤ FormulaAlgebra.mk φ := by
    intro v
    change (φ.eval v && v p) ≤ φ.eval v
    cases φ.eval v <;> cases v p <;> decide
  have hy_ne_bot : y ≠ ⊥ := by
    let vT : Sym → Bool := Function.update v₀ p true
    have hφ_vT : φ.eval vT = true := by
      rw [← hv₀_true]
      exact φ.eval_congr_vars fun q hq ↦
        Function.update_of_ne (fun hqp : q = p ↦ hp_not_mem (hqp ▸ hq)) _ _
    intro hy_bot
    have hv := congrArg (fun z : FormulaAlgebra Sym ↦ z.eval vT) hy_bot
    simp [y, PropFormula.eval, hφ_vT, vT] at hv
  have hy_ne_x : y ≠ FormulaAlgebra.mk φ := by
    let vF : Sym → Bool := Function.update v₀ p false
    have hφ_vF : φ.eval vF = true := by
      rw [← hv₀_true]
      exact φ.eval_congr_vars fun q hq ↦
        Function.update_of_ne (fun hqp : q = p ↦ hp_not_mem (hqp ▸ hq)) _ _
    intro hy_eq
    have hv := congrArg (fun z : FormulaAlgebra Sym ↦ z.eval vF) hy_eq
    simp [y, PropFormula.eval, hφ_vF, vF] at hv
  exact hy_ne_bot (hx.2 y (lt_of_le_of_ne hy_le_x hy_ne_x))

/-- Corollary (Goldblatt §19.3, p. 267): For infinite `Sym`, `FormulaAlgebra Sym` is not atomic. -/
theorem formulaAlgebra_not_isAtomic_of_infinite (Sym : Type*) [Infinite Sym] :
    ¬ @IsAtomic (FormulaAlgebra Sym) _ _ := by
  have : Nonempty Sym := inferInstance
  intro hatomic
  obtain ⟨a, ha⟩ := @IsAtomic.exists_atom (FormulaAlgebra Sym) _ _ _ hatomic
  exact formulaAlgebra_no_atoms_of_infinite a ha

/-- Goldblatt §19.3 (p. 265): The set `Atoms B = {a ∈ B | IsAtom a}` of atoms of a bounded-below
poset or Boolean algebra `B`. -/
def Atoms (B : Type*) [PartialOrder B] [OrderBot B] : Set B :=
  {a : B | IsAtom a}

@[simp]
theorem mem_atoms_iff {B : Type*} [PartialOrder B] [OrderBot B] {a : B} :
    a ∈ Atoms B ↔ IsAtom a :=
  Iff.rfl

/-- Goldblatt §19.3 (p. 266): For an atom `a` of a Boolean algebra `B`, `a ≤ xᶜ ↔ ¬ (a ≤ x)`. -/
theorem isAtom_le_compl_iff {B : Type*} [BooleanAlgebra B] {a x : B} (ha : IsAtom a) :
    a ≤ xᶜ ↔ ¬ a ≤ x := by
  rw [le_compl_iff_disjoint_left, disjoint_comm, ← ha.not_le_iff_disjoint]

/-- Goldblatt §19.3 (p. 266): For an atom `a` of a Boolean algebra `B`,
`a ≤ x ⊔ y ↔ a ≤ x ∨ a ≤ y`. -/
theorem isAtom_le_sup_iff {B : Type*} [BooleanAlgebra B] {a x y : B} (ha : IsAtom a) :
    a ≤ x ⊔ y ↔ a ≤ x ∨ a ≤ y := by
  rw [← not_iff_not, not_or, ← isAtom_le_compl_iff ha, compl_sup, le_inf_iff,
    isAtom_le_compl_iff ha, isAtom_le_compl_iff ha]

/-- Inductive generalization to finite joins: an atom `a` lies below `s.sup f` iff `a ≤ f i` for
some `i ∈ s` (Goldblatt §19.3, p. 266). -/
theorem isAtom_le_finset_sup_iff {B ι : Type*} [BooleanAlgebra B] {a : B} (ha : IsAtom a)
    (s : Finset ι) (f : ι → B) :
    a ≤ s.sup f ↔ ∃ i ∈ s, a ≤ f i := by
  classical
  induction s using Finset.induction with
  | empty =>
    simp [ha.ne_bot]
  | insert i s _ ih =>
    rw [Finset.sup_insert, isAtom_le_sup_iff ha, ih]
    simp

/-- Goldblatt §19.3 (pp. 265–266): Set `A_x = {a ∈ Atoms B | a ≤ x}` of atoms below `x : B`, as a
bounded lattice homomorphism `B → Set (Atoms B)`. -/
def atomsBelowHom (B : Type*) [BooleanAlgebra B] : BoundedLatticeHom B (Set (Atoms B)) where
  toFun x := {a : Atoms B | (a : B) ≤ x}
  map_sup' x y := by
    ext a
    exact isAtom_le_sup_iff a.2
  map_inf' x y := by
    ext a
    exact le_inf_iff
  map_top' := by
    ext a
    simp
  map_bot' := by
    ext a
    simp [a.2.ne_bot]

/-- `atomsBelowHom B` also preserves complements (`A_{xᶜ} = (A_x)ᶜ`), so it is a Boolean algebra
homomorphism (Goldblatt §19.3, p. 266). -/
@[simp]
theorem atomsBelowHom_map_compl {B : Type*} [BooleanAlgebra B] (x : B) :
    atomsBelowHom B xᶜ = (atomsBelowHom B x)ᶜ := by
  ext a
  exact isAtom_le_compl_iff a.2

/-- Goldblatt §19.3 (p. 266): In an **atomic** Boolean algebra `B`, `A_x ⊆ A_y ↔ x ≤ y`. -/
theorem atomsBelowHom_le_iff {B : Type*} [BooleanAlgebra B] [IsAtomic B] {x y : B} :
    atomsBelowHom B x ≤ atomsBelowHom B y ↔ x ≤ y := by
  constructor
  · intro h
    rw [BooleanAlgebra.le_iff_atom_le_imp]
    intro a ha hax
    exact h (a := ⟨a, ha⟩) hax
  · exact fun h _ hax ↦ hax.trans h

/-- Goldblatt §19.3 (p. 266): In an **atomic** Boolean algebra `B`, `atomsBelowHom B` is
injective! -/
theorem atomsBelowHom_injective {B : Type*} [BooleanAlgebra B] [IsAtomic B] :
    Function.Injective (atomsBelowHom B) :=
  fun _ _ h ↦ le_antisymm (atomsBelowHom_le_iff.mp h.le) (atomsBelowHom_le_iff.mp h.ge)

/-- **Representation of Atomic Boolean Algebras** (Goldblatt §19.3, p. 266):
Every atomic Boolean algebra `B` is isomorphic (`≃o`) to a field of sets — specifically, the image
`BooleanSubalgebra.map (atomsBelowHom B) ⊤` in the power-set algebra `Set (Atoms B)`. -/
def atomicBooleanAlgebra_orderIso_fieldOfSets (B : Type*) [BooleanAlgebra B] [IsAtomic B] :
    B ≃o ↥(BooleanSubalgebra.map (atomsBelowHom B) ⊤) :=
  { Equiv.ofBijective
      (fun x : B ↦ (⟨atomsBelowHom B x, ⟨x, trivial, rfl⟩⟩ :
        ↥(BooleanSubalgebra.map (atomsBelowHom B) ⊤)))
      ⟨fun _ _ h ↦ atomsBelowHom_injective (Subtype.mk.inj h),
       fun ⟨_, ⟨x, _, hx⟩⟩ ↦ ⟨x, Subtype.ext hx⟩⟩ with
    map_rel_iff' := atomsBelowHom_le_iff }

/-- Goldblatt §19.3 (pp. 266–267): Every finite Boolean algebra is **atomic**. -/
theorem finiteBooleanAlgebra_isAtomic (B : Type*) [BooleanAlgebra B] [Finite B] :
    IsAtomic B :=
  Finite.to_isAtomic

/-- Goldblatt §19.3 (p. 266): When `B` is finite, every subset `S ⊆ Atoms B` is `A_x` for the
join `x = ⋁_{a ∈ S} a`, so `atomsBelowHom B : B → Set (Atoms B)` is surjective! -/
theorem atomsBelowHom_surjective_of_finite (B : Type*) [BooleanAlgebra B] [Finite B] :
    Function.Surjective (atomsBelowHom B) := by
  intro S
  have hS_fin : S.Finite := Set.toFinite S
  refine ⟨hS_fin.toFinset.sup (fun a : Atoms B ↦ (a : B)), ?_⟩
  ext b
  change (b : B) ≤ hS_fin.toFinset.sup (fun a : Atoms B ↦ (a : B)) ↔ b ∈ S
  rw [isAtom_le_finset_sup_iff b.2]
  simp only [Set.Finite.mem_toFinset]
  constructor
  · rintro ⟨a, haS, hba⟩
    have h_eq : (b : B) = (a : B) := (a.2.le_iff_eq b.2.ne_bot).mp hba
    have hba_eq : b = a := Subtype.ext h_eq
    exact hba_eq ▸ haS
  · intro hbS
    exact ⟨b, hbS, le_rfl⟩

/-- **Finite Boolean Algebra Representation Theorem** (Goldblatt §19.3, p. 266):
Every finite Boolean algebra `B` is isomorphic (`≃o`) to the full power-set Boolean algebra
`Set (Atoms B)` of its set of atoms! -/
def finiteBooleanAlgebra_orderIso_powerset_atoms (B : Type*) [BooleanAlgebra B] [Finite B] :
    B ≃o Set (Atoms B) :=
  { Equiv.ofBijective (atomsBelowHom B)
      ⟨atomsBelowHom_injective, atomsBelowHom_surjective_of_finite B⟩ with
    map_rel_iff' := atomsBelowHom_le_iff }

/-- **Cardinality of a Finite Boolean Algebra** (Goldblatt §19.3, p. 266):
Every finite Boolean algebra `B` has `|B| = 2^m` elements, where `m = |Atoms B|` is the number of
its atoms. -/
theorem natCard_finiteBooleanAlgebra (B : Type*) [BooleanAlgebra B] [Finite B] :
    Nat.card B = 2 ^ Nat.card (Atoms B) := by
  cases nonempty_fintype (Atoms B)
  rw [Nat.card_congr (finiteBooleanAlgebra_orderIso_powerset_atoms B).toEquiv]
  rw [Nat.card_eq_fintype_card, Nat.card_eq_fintype_card, Fintype.card_set]

/-! ## §19.4–19.5 Hyperfinite Approximating Algebras and Exercises 19.5(1)–(2) (pp. 267–269) -/

section LocalFiniteness

/-- Elementary product (**minterm**) `⋀_{x ∈ F} x^{σ(x)}` of a finite subset `F : Finset B` of a
Boolean algebra `B` associated to a truth assignment `σ : F → Bool` (Goldblatt §19.4, p. 267). -/
def minterm {B : Type*} [BooleanAlgebra B] (F : Finset B) (σ : F → Bool) : B :=
  F.attach.inf fun x ↦ if σ x then (x : B) else (x : B)ᶜ

theorem minterm_le_of_eq_true {B : Type*} [BooleanAlgebra B] {F : Finset B} {σ : F → Bool}
    {x : F} (hx : σ x = true) :
    minterm F σ ≤ (x : B) :=
  (Finset.inf_le (Finset.mem_attach F x)).trans (by simp [hx])

theorem minterm_le_compl_of_eq_false {B : Type*} [BooleanAlgebra B] {F : Finset B} {σ : F → Bool}
    {x : F} (hx : σ x = false) :
    minterm F σ ≤ (x : B)ᶜ :=
  (Finset.inf_le (Finset.mem_attach F x)).trans (by simp [hx])

/-- Distinct assignments `σ₁ ≠ σ₂` yield disjoint minterms (Goldblatt §19.4, p. 267). -/
theorem minterm_disjoint_of_ne {B : Type*} [BooleanAlgebra B] {F : Finset B}
    {σ₁ σ₂ : F → Bool} (hne : σ₁ ≠ σ₂) :
    Disjoint (minterm F σ₁) (minterm F σ₂) := by
  have hex : ∃ x : F, σ₁ x ≠ σ₂ x := by
    by_contra! hall
    exact hne (funext hall)
  obtain ⟨x, hx⟩ := hex
  rw [disjoint_iff_inf_le]
  cases h₁ : σ₁ x <;> cases h₂ : σ₂ x
  · exact absurd (h₁.trans h₂.symm) hx
  · calc minterm F σ₁ ⊓ minterm F σ₂
        ≤ (x : B)ᶜ ⊓ (x : B) :=
          inf_le_inf (minterm_le_compl_of_eq_false h₁) (minterm_le_of_eq_true h₂)
      _ = ⊥ := by rw [inf_comm]; exact le_bot_iff.mp (BooleanAlgebra.inf_compl_le_bot _)
  · calc minterm F σ₁ ⊓ minterm F σ₂
        ≤ (x : B) ⊓ (x : B)ᶜ :=
          inf_le_inf (minterm_le_of_eq_true h₁) (minterm_le_compl_of_eq_false h₂)
      _ = ⊥ := le_bot_iff.mp (BooleanAlgebra.inf_compl_le_bot _)
  · exact absurd (h₁.trans h₂.symm) hx

/-- The join of all `2^|F|` minterms of `F` equals `⊤` (Goldblatt §19.4, p. 267). -/
theorem univ_sup_minterm {B : Type*} [BooleanAlgebra B] (F : Finset B) :
    (Finset.univ : Finset (↥F → Bool)).sup (minterm F) = ⊤ := by
  classical
  induction F using Finset.induction with
  | empty =>
    apply top_unique
    let σ₀ : ↥(∅ : Finset B) → Bool := fun x ↦ False.elim (Finset.notMem_empty x.1 x.2)
    have htop : minterm (∅ : Finset B) σ₀ = ⊤ := by simp [minterm]
    rw [← htop]
    exact Finset.le_sup (Finset.mem_univ σ₀)
  | insert a F ha ih =>
    apply top_unique
    rw [← ih]
    refine Finset.sup_le fun τ _ ↦ ?_
    let σT : ↥(insert a F) → Bool := fun x ↦
      if hx : x.1 = a then true else τ ⟨x.1, (Finset.mem_insert.mp x.2).resolve_left hx⟩
    let σF : ↥(insert a F) → Bool := fun x ↦
      if hx : x.1 = a then false else τ ⟨x.1, (Finset.mem_insert.mp x.2).resolve_left hx⟩
    have hT : a ⊓ minterm F τ ≤ minterm (insert a F) σT := by
      refine Finset.le_inf fun y _ ↦ ?_
      by_cases hy : y.1 = a
      · simp [σT, hy]
      · have hyF : y.1 ∈ F := (Finset.mem_insert.mp y.2).resolve_left hy
        have hσ : σT y = τ ⟨y.1, hyF⟩ := by simp [σT, hy]
        rw [hσ]
        exact inf_le_right.trans (Finset.inf_le (Finset.mem_attach F ⟨y.1, hyF⟩))
    have hF : aᶜ ⊓ minterm F τ ≤ minterm (insert a F) σF := by
      refine Finset.le_inf fun y _ ↦ ?_
      by_cases hy : y.1 = a
      · simp [σF, hy]
      · have hyF : y.1 ∈ F := (Finset.mem_insert.mp y.2).resolve_left hy
        have hσ : σF y = τ ⟨y.1, hyF⟩ := by simp [σF, hy]
        rw [hσ]
        exact inf_le_right.trans (Finset.inf_le (Finset.mem_attach F ⟨y.1, hyF⟩))
    calc minterm F τ
        = (a ⊔ aᶜ) ⊓ minterm F τ := by rw [sup_compl_eq_top, top_inf_eq]
      _ = (a ⊓ minterm F τ) ⊔ (aᶜ ⊓ minterm F τ) := inf_sup_right _ _ _
      _ ≤ minterm (insert a F) σT ⊔ minterm (insert a F) σF := sup_le_sup hT hF
      _ ≤ (Finset.univ : Finset (↥(insert a F) → Bool)).sup (minterm (insert a F)) :=
        sup_le (Finset.le_sup (Finset.mem_univ σT)) (Finset.le_sup (Finset.mem_univ σF))

/-- Join of minterms indexed by a subset `S : Finset (F → Bool)`, packaged as a bounded lattice
(hence Boolean algebra) homomorphism `Finset (F → Bool) → B` (Goldblatt §19.4, p. 267). -/
def mintermSupHom {B : Type*} [BooleanAlgebra B] (F : Finset B) :
    BoundedLatticeHom (Finset (F → Bool)) B where
  toFun S := S.sup (minterm F)
  map_sup' S₁ S₂ := Finset.sup_union
  map_top' := univ_sup_minterm F
  map_bot' := Finset.sup_empty
  map_inf' S₁ S₂ := by
    have hcompl : ∀ S : Finset (F → Bool), (S.sup (minterm F))ᶜ = (Sᶜ).sup (minterm F) := by
      intro S
      refine (IsCompl.of_eq ?_ ?_).compl_eq
      · rw [← disjoint_iff]
        rw [Finset.disjoint_sup_left]
        intro σ₁ hσ₁
        rw [Finset.disjoint_sup_right]
        intro σ₂ hσ₂
        exact minterm_disjoint_of_ne fun heq ↦ (Finset.mem_compl.mp hσ₂) (heq ▸ hσ₁)
      · rw [← Finset.sup_union, Finset.union_compl]
        exact univ_sup_minterm F
    have h := congrArg Compl.compl (hcompl (S₁ ∩ S₂))
    rw [compl_compl, Finset.compl_inter, Finset.sup_union, ← hcompl S₁, ← hcompl S₂,
      compl_sup, compl_compl, compl_compl] at h
    exact h

/-- Every minterm `minterm F σ` belongs to `BooleanSubalgebra.closure (F : Set B)`. -/
theorem minterm_mem_closure {B : Type*} [BooleanAlgebra B] (F : Finset B) (σ : F → Bool) :
    minterm F σ ∈ BooleanSubalgebra.closure (F : Set B) := by
  let L := BooleanSubalgebra.closure (F : Set B)
  have hmem : ∀ x ∈ F.attach,
      (if σ x then (x : B) else (x : B)ᶜ) ∈ L := by
    intro x _
    have hxL : (x : B) ∈ L := BooleanSubalgebra.subset_closure x.2
    split_ifs
    · exact hxL
    · exact L.compl_mem hxL
  have hind : ∀ s : Finset {x // x ∈ F},
      (∀ x ∈ s, (if σ x then (x : B) else (x : B)ᶜ) ∈ L) →
      s.inf (fun x ↦ if σ x then (x : B) else (x : B)ᶜ) ∈ L := by
    intro s hs
    induction s using Finset.induction with
    | empty => simp [L.top_mem]
    | insert a s _ ih =>
      rw [Finset.inf_insert]
      exact L.inf_mem (hs a (Finset.mem_insert_self a s))
        (ih fun x hx ↦ hs x (Finset.mem_insert_of_mem hx))
  exact hind F.attach hmem

/-- The Boolean subalgebra generated by a finite subset `F : Finset B` is the image of
`mintermSupHom F : Finset (F → Bool) → B` (Goldblatt §19.4, p. 267). -/
theorem closure_finset_eq_map_mintermSupHom {B : Type*} [BooleanAlgebra B] (F : Finset B) :
    BooleanSubalgebra.closure (F : Set B) = BooleanSubalgebra.map (mintermSupHom F) ⊤ := by
  apply le_antisymm
  · rw [BooleanSubalgebra.closure_le]
    intro x hx
    let Sx : Finset (F → Bool) := Finset.univ.filter fun σ ↦ σ ⟨x, hx⟩ = true
    refine ⟨Sx, trivial, ?_⟩
    change Sx.sup (minterm F) = x
    apply le_antisymm
    · refine Finset.sup_le fun σ hσ ↦ ?_
      exact minterm_le_of_eq_true (Finset.mem_filter.mp hσ).2
    · have hcompl_le : (Sxᶜ).sup (minterm F) ≤ xᶜ := by
        refine Finset.sup_le fun σ hσ ↦ ?_
        have hfalse : σ ⟨x, hx⟩ = false := by
          rw [Finset.mem_compl, Finset.mem_filter] at hσ
          cases hval : σ ⟨x, hx⟩
          · rfl
          · exact False.elim (hσ ⟨Finset.mem_univ σ, hval⟩)
        exact minterm_le_compl_of_eq_false hfalse
      have hmap_compl : (mintermSupHom F Sx)ᶜ = mintermSupHom F Sxᶜ :=
        (map_compl' (mintermSupHom F) Sx).symm
      change x ≤ mintermSupHom F Sx
      rw [← compl_le_compl_iff_le, hmap_compl]
      exact hcompl_le
  · rintro _ ⟨S, hS, rfl⟩
    clear hS
    let L := BooleanSubalgebra.closure (F : Set B)
    change S.sup (minterm F) ∈ L
    induction S using Finset.induction with
    | empty => simp [L.bot_mem]
    | insert σ S _ ih =>
      rw [Finset.sup_insert]
      exact L.sup_mem (minterm_mem_closure F σ) ih

/-- **Local Finiteness of Boolean Algebras** (Goldblatt §19.4, p. 267):
Every finitely generated Boolean subalgebra `BooleanSubalgebra.closure (F : Set B)` (`F : Finset B`)
is **finite**, with at most `2^(2^|F|)` elements! -/
instance closure_finset_finite {B : Type*} [BooleanAlgebra B] (F : Finset B) :
    Finite ↥(BooleanSubalgebra.closure (F : Set B)) := by
  rw [closure_finset_eq_map_mintermSupHom F]
  exact Set.Finite.to_subtype ((Set.finite_univ.image (mintermSupHom F)))

/-- Explicit upper bound `|⟨F⟩| ≤ 2^(2^|F|)` on the Boolean subalgebra generated by `F : Finset B`
(Goldblatt §19.4, p. 267). -/
theorem natCard_closure_finset_le {B : Type*} [BooleanAlgebra B] (F : Finset B) :
    Nat.card ↥(BooleanSubalgebra.closure (F : Set B)) ≤ 2 ^ (2 ^ F.card) := by
  let f : Finset (F → Bool) → ↥(BooleanSubalgebra.closure (F : Set B)) := fun S ↦
    ⟨mintermSupHom F S, by
      rw [closure_finset_eq_map_mintermSupHom F]
      exact ⟨S, trivial, rfl⟩⟩
  have hsurj : Function.Surjective f := by
    rintro ⟨y, hy⟩
    rw [closure_finset_eq_map_mintermSupHom F] at hy
    rcases hy with ⟨S, _, rfl⟩
    exact ⟨S, rfl⟩
  calc Nat.card ↥(BooleanSubalgebra.closure (F : Set B))
      ≤ Nat.card (Finset (F → Bool)) := Nat.card_le_card_of_surjective f hsurj
    _ = 2 ^ (2 ^ F.card) := by
      rw [Nat.card_eq_fintype_card]
      simp [Fintype.card_pi]

/-! ### Exercise 19.5(2): Quotient from `FormulaAlgebra` to Finitely Generated Boolean Algebras -/

/-- **Exercise 19.5(2)** (Goldblatt §19.5, p. 269): Recursive evaluation of a `Π`-formula `φ` in
an arbitrary Boolean algebra `B` under a symbol assignment `g : Sym → B`. -/
def PropFormula.evalIn {Sym B : Type*} [BooleanAlgebra B] (g : Sym → B) :
    PropFormula Sym → B
  | .var p => g p
  | .neg ψ => (ψ.evalIn g)ᶜ
  | .conj ψ χ => ψ.evalIn g ⊓ χ.evalIn g
  | .disj ψ χ => ψ.evalIn g ⊔ χ.evalIn g
  | .imp ψ χ => (ψ.evalIn g)ᶜ ⊔ χ.evalIn g
  | .iff ψ χ => ((ψ.evalIn g)ᶜ ⊔ χ.evalIn g) ⊓ ((χ.evalIn g)ᶜ ⊔ ψ.evalIn g)

/-- Generalized minterm in `B` over a finite set of sentence symbols `V : Finset Sym` under
`g : Sym → B` and local valuation `σ : V → Bool`. -/
def varMinterm {Sym B : Type*} [BooleanAlgebra B] (g : Sym → B) (V : Finset Sym)
    (σ : V → Bool) : B :=
  V.attach.inf fun p ↦ if σ p then g p.1 else (g p.1)ᶜ

theorem univ_sup_varMinterm {Sym B : Type*} [BooleanAlgebra B] (g : Sym → B) (V : Finset Sym) :
    (Finset.univ : Finset (↥V → Bool)).sup (varMinterm g V) = ⊤ := by
  classical
  induction V using Finset.induction with
  | empty =>
    apply top_unique
    let σ₀ : ↥(∅ : Finset Sym) → Bool := fun p ↦ False.elim (Finset.notMem_empty p.1 p.2)
    have htop : varMinterm g (∅ : Finset Sym) σ₀ = ⊤ := by simp [varMinterm]
    rw [← htop]
    exact Finset.le_sup (Finset.mem_univ σ₀)
  | insert p V hp ih =>
    apply top_unique
    rw [← ih]
    refine Finset.sup_le fun τ _ ↦ ?_
    let σT : ↥(insert p V) → Bool := fun q ↦
      if hq : q.1 = p then true else τ ⟨q.1, (Finset.mem_insert.mp q.2).resolve_left hq⟩
    let σF : ↥(insert p V) → Bool := fun q ↦
      if hq : q.1 = p then false else τ ⟨q.1, (Finset.mem_insert.mp q.2).resolve_left hq⟩
    have hT : g p ⊓ varMinterm g V τ ≤ varMinterm g (insert p V) σT := by
      refine Finset.le_inf fun q _ ↦ ?_
      by_cases hq : q.1 = p
      · simp [σT, hq]
      · have hqV : q.1 ∈ V := (Finset.mem_insert.mp q.2).resolve_left hq
        have hσ : σT q = τ ⟨q.1, hqV⟩ := by simp [σT, hq]
        rw [hσ]
        exact inf_le_right.trans (Finset.inf_le (Finset.mem_attach V ⟨q.1, hqV⟩))
    have hF : (g p)ᶜ ⊓ varMinterm g V τ ≤ varMinterm g (insert p V) σF := by
      refine Finset.le_inf fun q _ ↦ ?_
      by_cases hq : q.1 = p
      · simp [σF, hq]
      · have hqV : q.1 ∈ V := (Finset.mem_insert.mp q.2).resolve_left hq
        have hσ : σF q = τ ⟨q.1, hqV⟩ := by simp [σF, hq]
        rw [hσ]
        exact inf_le_right.trans (Finset.inf_le (Finset.mem_attach V ⟨q.1, hqV⟩))
    calc varMinterm g V τ
        = (g p ⊔ (g p)ᶜ) ⊓ varMinterm g V τ := by rw [sup_compl_eq_top, top_inf_eq]
      _ = (g p ⊓ varMinterm g V τ) ⊔ ((g p)ᶜ ⊓ varMinterm g V τ) := inf_sup_right _ _ _
      _ ≤ varMinterm g (insert p V) σT ⊔ varMinterm g (insert p V) σF := sup_le_sup hT hF
      _ ≤ (Finset.univ : Finset (↥(insert p V) → Bool)).sup
            (varMinterm g (insert p V)) :=
        sup_le (Finset.le_sup (Finset.mem_univ σT)) (Finset.le_sup (Finset.mem_univ σF))

/-- Key evaluation-vs-minterm identity: meeting `φ.evalIn g` with `varMinterm g V σ` yields
`varMinterm g V σ` if `φ` evaluates to `true` under `σ`, and `⊥` otherwise! -/
theorem evalIn_inf_varMinterm {Sym B : Type*} [DecidableEq Sym] [BooleanAlgebra B]
    (g : Sym → B) {V : Finset Sym} (σ : V → Bool) (φ : PropFormula Sym) (hV : φ.vars ⊆ V) :
    φ.evalIn g ⊓ varMinterm g V σ =
      cond (φ.eval (fun p ↦ if hp : p ∈ V then σ ⟨p, hp⟩ else false)) (varMinterm g V σ) ⊥ := by
  set v : Sym → Bool := fun p ↦ if hp : p ∈ V then σ ⟨p, hp⟩ else false
  have hneg : ∀ (b m : B), b ⊓ m = ⊥ → bᶜ ⊓ m = m := fun b m hbm ↦
    inf_of_le_right (le_compl_iff_disjoint_left.mpr (disjoint_iff.mpr hbm))
  have hneg' : ∀ (b m : B), b ⊓ m = m → bᶜ ⊓ m = ⊥ := fun b m hbm ↦
    le_bot_iff.mp ((inf_le_inf_left bᶜ (inf_eq_right.mp hbm)).trans
      (by rw [inf_comm]; exact BooleanAlgebra.inf_compl_le_bot b))
  induction φ with
  | var p =>
    have hp : p ∈ V := hV (Finset.mem_singleton_self p)
    have hv : v p = σ ⟨p, hp⟩ := by simp [v, hp]
    simp only [PropFormula.evalIn, PropFormula.eval, hv]
    cases hσ : σ ⟨p, hp⟩
    · simp only [Bool.cond_false]
      have hle : varMinterm g V σ ≤ (g p)ᶜ :=
        (Finset.inf_le (Finset.mem_attach V ⟨p, hp⟩)).trans (by simp [hσ])
      exact le_bot_iff.mp ((inf_le_inf_left (g p) hle).trans (BooleanAlgebra.inf_compl_le_bot _))
    · simp only [Bool.cond_true]
      have hle : varMinterm g V σ ≤ g p :=
        (Finset.inf_le (Finset.mem_attach V ⟨p, hp⟩)).trans (by simp [hσ])
      exact inf_of_le_right hle
  | neg ψ ih =>
    have ih' := ih hV
    simp only [PropFormula.evalIn, PropFormula.eval]
    cases hψ : ψ.eval v
    · rw [hψ, Bool.cond_false] at ih'; simp [hneg _ _ ih']
    · rw [hψ, Bool.cond_true] at ih'; simp [hneg' _ _ ih']
  | conj ψ χ ih₁ ih₂ =>
    have h₁ := ih₁ (Finset.union_subset_left hV)
    have h₂ := ih₂ (Finset.union_subset_right hV)
    simp only [PropFormula.evalIn, PropFormula.eval]
    rw [inf_assoc, h₂]
    cases hψ : ψ.eval v <;> cases hχ : χ.eval v
    · simp
    · rw [hψ, Bool.cond_false] at h₁; simpa using h₁
    · simp
    · rw [hψ, Bool.cond_true] at h₁; simpa using h₁
  | disj ψ χ ih₁ ih₂ =>
    have h₁ := ih₁ (Finset.union_subset_left hV)
    have h₂ := ih₂ (Finset.union_subset_right hV)
    simp only [PropFormula.evalIn, PropFormula.eval, inf_sup_right, h₁, h₂]
    cases hψ : ψ.eval v <;> cases hχ : χ.eval v <;> simp
  | imp ψ χ ih₁ ih₂ =>
    have h₁ := ih₁ (Finset.union_subset_left hV)
    have h₂ := ih₂ (Finset.union_subset_right hV)
    simp only [PropFormula.evalIn, PropFormula.eval, inf_sup_right, h₂]
    cases hψ : ψ.eval v <;> cases hχ : χ.eval v
    · rw [hψ, Bool.cond_false] at h₁; simp [hneg _ _ h₁]
    · rw [hψ, Bool.cond_false] at h₁; simp [hneg _ _ h₁]
    · rw [hψ, Bool.cond_true] at h₁; simp [hneg' _ _ h₁]
    · rw [hψ, Bool.cond_true] at h₁; simp [hneg' _ _ h₁]
  | iff ψ χ ih₁ ih₂ =>
    have h₁ := ih₁ (Finset.union_subset_left hV)
    have h₂ := ih₂ (Finset.union_subset_right hV)
    simp only [PropFormula.evalIn, PropFormula.eval]
    have hdist : ∀ (a b m : B), (a ⊓ b) ⊓ m = (a ⊓ m) ⊓ (b ⊓ m) := fun a b m ↦
      le_antisymm
        (le_inf (le_inf (inf_le_left.trans inf_le_left) inf_le_right)
          (le_inf (inf_le_left.trans inf_le_right) inf_le_right))
        (le_inf (le_inf (inf_le_left.trans inf_le_left) (inf_le_right.trans inf_le_left))
          (inf_le_left.trans inf_le_right))
    rw [hdist ((ψ.evalIn g)ᶜ ⊔ χ.evalIn g) ((χ.evalIn g)ᶜ ⊔ ψ.evalIn g),
      inf_sup_right ((ψ.evalIn g)ᶜ) (χ.evalIn g),
      inf_sup_right ((χ.evalIn g)ᶜ) (ψ.evalIn g), h₁, h₂]
    cases hψ : ψ.eval v <;> cases hχ : χ.eval v
    · rw [hψ, Bool.cond_false] at h₁; rw [hχ, Bool.cond_false] at h₂
      simp [hneg _ _ h₁, hneg _ _ h₂]
    · rw [hψ, Bool.cond_false] at h₁; rw [hχ, Bool.cond_true] at h₂
      simp [hneg _ _ h₁, hneg' _ _ h₂]
    · rw [hψ, Bool.cond_true] at h₁; rw [hχ, Bool.cond_false] at h₂
      simp [hneg' _ _ h₁, hneg _ _ h₂]
    · rw [hψ, Bool.cond_true] at h₁; rw [hχ, Bool.cond_true] at h₂
      simp [hneg' _ _ h₁, hneg' _ _ h₂]

private theorem inf_finset_sup {B ι : Type*} [DistribLattice B] [OrderBot B]
    (x : B) (s : Finset ι) (f : ι → B) :
    x ⊓ s.sup f = s.sup (fun i ↦ x ⊓ f i) := by
  classical
  induction s using Finset.induction with
  | empty => simp
  | insert a s _ ih => rw [Finset.sup_insert, Finset.sup_insert, inf_sup_left, ih]

/-- **Boolean Soundness of `FormulaEquiv`** (Exercise 19.5(2), p. 269):
Logically equivalent `Π`-formulae `φ ≈ ψ` evaluate to the exact same element in **every** Boolean
algebra `B` under every assignment `g : Sym → B`! -/
theorem PropFormula.evalIn_congr_equiv {Sym B : Type*} [BooleanAlgebra B]
    (g : Sym → B) {φ ψ : PropFormula Sym} (heq : PropFormula.FormulaEquiv φ ψ) :
    φ.evalIn g = ψ.evalIn g := by
  classical
  let V : Finset Sym := φ.vars ∪ ψ.vars
  have hφV : φ.vars ⊆ V := Finset.subset_union_left
  have hψV : ψ.vars ⊆ V := Finset.subset_union_right
  calc φ.evalIn g
      = φ.evalIn g ⊓ ⊤ := (inf_top_eq _).symm
    _ = φ.evalIn g ⊓ (Finset.univ : Finset (V → Bool)).sup (varMinterm g V) := by
        rw [univ_sup_varMinterm]
    _ = (Finset.univ : Finset (V → Bool)).sup (fun σ ↦ φ.evalIn g ⊓ varMinterm g V σ) :=
        inf_finset_sup _ _ _
    _ = (Finset.univ : Finset (V → Bool)).sup (fun σ ↦ ψ.evalIn g ⊓ varMinterm g V σ) := by
        refine Finset.sup_congr rfl fun σ _ ↦ ?_
        rw [evalIn_inf_varMinterm g σ φ hφV, evalIn_inf_varMinterm g σ ψ hψV, heq _]
    _ = ψ.evalIn g ⊓ (Finset.univ : Finset (V → Bool)).sup (varMinterm g V) :=
        (inf_finset_sup _ _ _).symm
    _ = ψ.evalIn g := by rw [univ_sup_varMinterm, inf_top_eq]

/-- **Universal Property of `FormulaAlgebra Sym`** (Exercise 19.5(2), Goldblatt p. 269):
Every map `g : Sym → B` from a nonempty symbol set `Sym` into a Boolean algebra `B` lifts uniquely
to a Boolean algebra (`BoundedLatticeHom`) homomorphism `FormulaAlgebra Sym → B` sending `[p] ↦ g p`. -/
def FormulaAlgebra.liftHom {Sym B : Type*} [Nonempty Sym] [BooleanAlgebra B] (g : Sym → B) :
    BoundedLatticeHom (FormulaAlgebra Sym) B where
  toFun x := Quotient.liftOn x (PropFormula.evalIn g) (fun _ _ h ↦ PropFormula.evalIn_congr_equiv g h)
  map_sup' x y := by
    induction x using Quotient.inductionOn with | _ φ =>
    induction y using Quotient.inductionOn with | _ ψ =>
    rfl
  map_inf' x y := by
    induction x using Quotient.inductionOn with | _ φ =>
    induction y using Quotient.inductionOn with | _ ψ =>
    rfl
  map_top' := by
    change (PropFormula.verum Sym).evalIn g = ⊤
    simp [PropFormula.verum, PropFormula.evalIn]
  map_bot' := by
    change (PropFormula.falsum Sym).evalIn g = ⊥
    simp [PropFormula.falsum, PropFormula.evalIn]

/-- The image of `FormulaAlgebra.liftHom g` is the Boolean subalgebra of `B` generated by
`Set.range g` (Exercise 19.5(2), Goldblatt p. 269). -/
theorem FormulaAlgebra.map_liftHom_top {Sym B : Type*} [Nonempty Sym] [BooleanAlgebra B]
    (g : Sym → B) :
    BooleanSubalgebra.map (FormulaAlgebra.liftHom g) ⊤ =
      BooleanSubalgebra.closure (Set.range g) := by
  apply le_antisymm
  · rintro _ ⟨x, hx, rfl⟩
    clear hx
    induction x using Quotient.inductionOn with | _ φ =>
    change φ.evalIn g ∈ BooleanSubalgebra.closure (Set.range g)
    let L := BooleanSubalgebra.closure (Set.range g)
    induction φ with
    | var p => exact BooleanSubalgebra.subset_closure ⟨p, rfl⟩
    | neg ψ ih => exact L.compl_mem ih
    | conj ψ χ ih₁ ih₂ => exact L.inf_mem ih₁ ih₂
    | disj ψ χ ih₁ ih₂ => exact L.sup_mem ih₁ ih₂
    | imp ψ χ ih₁ ih₂ => exact L.sup_mem (L.compl_mem ih₁) ih₂
    | iff ψ χ ih₁ ih₂ =>
      exact L.inf_mem (L.sup_mem (L.compl_mem ih₁) ih₂) (L.sup_mem (L.compl_mem ih₂) ih₁)
  · rw [BooleanSubalgebra.closure_le]
    rintro _ ⟨p, rfl⟩
    exact ⟨FormulaAlgebra.ofVar p, trivial, rfl⟩

/-- **Exercise 19.5(2)** (Goldblatt §19.5, p. 269): If a Boolean algebra `B` is generated by an
`n`-element sequence `g : Fin n → B` (`n ≥ 1`, i.e., `[NeZero n]`) so that
`BooleanSubalgebra.closure (Set.range g) = ⊤`, then `FormulaAlgebra.liftHom g` is a **surjective**
Boolean algebra homomorphism `FormulaAlgebra (Fin n) → B`, proving `|B| ≤ 2^(2^n)` directly from
Exercise 19.2.1! -/
theorem exercise_19_5_2_surjective_liftHom {B : Type*} [BooleanAlgebra B] {n : ℕ} [NeZero n]
    (g : Fin n → B) (hgen : BooleanSubalgebra.closure (Set.range g) = ⊤) :
    Function.Surjective (FormulaAlgebra.liftHom g) ∧ Nat.card B ≤ 2 ^ (2 ^ n) := by
  have hsurj : Function.Surjective (FormulaAlgebra.liftHom g) := by
    intro b
    have hb : b ∈ (⊤ : BooleanSubalgebra B) := trivial
    rw [← hgen, ← FormulaAlgebra.map_liftHom_top g] at hb
    rcases hb with ⟨x, _, rfl⟩
    exact ⟨x, rfl⟩
  refine ⟨hsurj, ?_⟩
  calc Nat.card B
      ≤ Nat.card (FormulaAlgebra (Fin n)) :=
        Nat.card_le_card_of_surjective (FormulaAlgebra.liftHom g) hsurj
    _ = 2 ^ (2 ^ n) := by
        rw [natCard_formulaAlgebra (Fin n), Fintype.card_fin]

end LocalFiniteness

/-! ### Ultrapower Boolean Algebra `*B` and Hyperfinite Approximating Subalgebra `B⁺` -/

section HyperfiniteBooleanAlgebra

/-- Complement on a filter-germ algebra `Germ l B` defined componentwise (`[f]ᶜ = [i ↦ (f i)ᶜ]`)
(Goldblatt §19.4, p. 267). -/
instance instComplGerm {ι B : Type*} {l : Filter ι} [Compl B] : Compl (Germ l B) where
  compl := Germ.map Compl.compl

/-- Set-difference `\` on `Germ l B` defined componentwise. -/
instance instSDiffGerm {ι B : Type*} {l : Filter ι} [SDiff B] : SDiff (Germ l B) where
  sdiff := Germ.map₂ (· \ ·)

/-- Heyting implication `⇨` on `Germ l B` defined componentwise. -/
instance instHImpGerm {ι B : Type*} {l : Filter ι} [HImp B] : HImp (Germ l B) where
  himp := Germ.map₂ (· ⇨ ·)

@[simp]
theorem coe_compl_germ {ι B : Type*} {l : Filter ι} [Compl B] (f : ι → B) :
    ((f : Germ l B)ᶜ) = ((fun i ↦ (f i)ᶜ) : Germ l B) :=
  rfl

/-- Goldblatt §19.4 (p. 267): Every filter-germ / ultrapower `Germ l B` of a Boolean algebra `B` is
itself a **Boolean algebra** under componentwise operations! -/
instance instBooleanAlgebraGerm {ι B : Type*} {l : Filter ι} [BooleanAlgebra B] :
    BooleanAlgebra (Germ l B) where
  __ := Germ.instDistribLattice
  __ := Germ.instBoundedOrder
  inf_compl_le_bot x := by
    induction x using Germ.inductionOn with | _ f =>
    exact Filter.Eventually.of_forall fun i ↦ BooleanAlgebra.inf_compl_le_bot (f i)
  top_le_sup_compl x := by
    induction x using Germ.inductionOn with | _ f =>
    exact Filter.Eventually.of_forall fun i ↦ BooleanAlgebra.top_le_sup_compl (f i)
  sdiff_eq x y := by
    induction x using Germ.inductionOn with | _ f =>
    induction y using Germ.inductionOn with | _ g =>
    exact Germ.coe_eq.mpr (Filter.Eventually.of_forall fun i ↦ sdiff_eq)
  himp_eq x y := by
    induction x using Germ.inductionOn with | _ f =>
    induction y using Germ.inductionOn with | _ g =>
    exact Germ.coe_eq.mpr (Filter.Eventually.of_forall fun i ↦ himp_eq)

/-- Finite Boolean subalgebra `⟨F⟩` generated by `F : Finset B` (Goldblatt §19.4, p. 267). -/
abbrev subalgAt {B : Type*} [BooleanAlgebra B] (F : Finset B) : BooleanSubalgebra B :=
  BooleanSubalgebra.closure (F : Set B)

/-- Internal Boolean subalgebra `[F ↦ L F]` of `StarElem B` assembled from any indexed family of
Boolean subalgebras `L : Finset B → BooleanSubalgebra B` (Goldblatt §19.4, p. 267). -/
def internalBooleanSubalgebra {B : Type*} [BooleanAlgebra B]
    (L : Finset B → BooleanSubalgebra B) : BooleanSubalgebra (StarElem B) where
  carrier := internalApproxSet (fun F ↦ (L F : Set B))
  bot_mem' := by
    change (((fun _ : Finset B ↦ (⊥ : B)) : Finset B → B) : StarElem B) ∈
      internalApproxSet (fun F ↦ (L F : Set B))
    rw [coe_mem_internalApproxSet]
    exact Filter.Eventually.of_forall fun F ↦ (L F).bot_mem
  compl_mem' {x} hx := by
    induction x using Germ.inductionOn with | _ f =>
    rw [coe_mem_internalApproxSet] at hx
    change ((fun F ↦ (f F)ᶜ) : StarElem B) ∈ internalApproxSet (fun F ↦ (L F : Set B))
    rw [coe_mem_internalApproxSet]
    exact hx.mono fun F hF ↦ (L F).compl_mem hF
  supClosed' {x} hx {y} hy := by
    induction x using Germ.inductionOn with | _ fx =>
    induction y using Germ.inductionOn with | _ fy =>
    rw [coe_mem_internalApproxSet] at hx hy
    change ((fun F ↦ fx F ⊔ fy F) : StarElem B) ∈ internalApproxSet (fun F ↦ (L F : Set B))
    rw [coe_mem_internalApproxSet]
    exact (hx.and hy).mono fun F ⟨h₁, h₂⟩ ↦ (L F).sup_mem h₁ h₂
  infClosed' {x} hx {y} hy := by
    induction x using Germ.inductionOn with | _ fx =>
    induction y using Germ.inductionOn with | _ fy =>
    rw [coe_mem_internalApproxSet] at hx hy
    change ((fun F ↦ fx F ⊓ fy F) : StarElem B) ∈ internalApproxSet (fun F ↦ (L F : Set B))
    rw [coe_mem_internalApproxSet]
    exact (hx.and hy).mono fun F ⟨h₁, h₂⟩ ↦ (L F).inf_mem h₁ h₂

/-- **Exercise 19.5(1)** (Goldblatt §19.5, p. 269): For ANY hyperfinite subset `H = [F ↦ S F]` of
`StarElem B`, the internal Boolean subalgebra `[F ↦ ⟨S F⟩]` is **hyperfinite**, contains `H`, and
is the **smallest** internal Boolean subalgebra `[F ↦ L F]` containing `H`! -/
theorem exercise_19_5_1_hyperfinite_subalgebra_closure {B : Type*} [BooleanAlgebra B]
    (S : Finset B → Finset B) :
    let B_S := internalBooleanSubalgebra (fun F ↦ BooleanSubalgebra.closure (S F : Set B))
    IsHyperfiniteApproxSet (B_S : Set (StarElem B)) ∧
      internalApproxSet (fun F ↦ (S F : Set B)) ⊆ (B_S : Set (StarElem B)) ∧
      ∀ L : Finset B → BooleanSubalgebra B,
        internalApproxSet (fun F ↦ (S F : Set B)) ⊆
          (internalBooleanSubalgebra L : Set (StarElem B)) →
        B_S ≤ internalBooleanSubalgebra L := by
  intro B_S
  refine ⟨?_, ?_, ?_⟩
  · let T : Finset B → Finset B := fun F ↦
      (Fintype.ofFinite ↥(BooleanSubalgebra.closure (S F : Set B))).elems.map
        ⟨Subtype.val, Subtype.val_injective⟩
    refine ⟨T, ?_⟩
    ext x
    induction x using Germ.inductionOn with | _ f =>
    change (f : StarElem B) ∈ internalApproxSet _ ↔ (f : StarElem B) ∈ internalApproxSet _
    simp only [coe_mem_internalApproxSet]
    refine Filter.eventually_congr (Filter.Eventually.of_forall fun F ↦ ?_)
    constructor
    · intro hf
      exact Finset.mem_coe.mpr (Finset.mem_map.mpr
        ⟨⟨f F, hf⟩, (Fintype.ofFinite _).complete _, rfl⟩)
    · intro hf
      rcases Finset.mem_map.mp (Finset.mem_coe.mp hf) with ⟨⟨y, hy⟩, _, rfl⟩
      exact hy
  · intro x hx
    induction x using Germ.inductionOn with | _ f =>
    change (f : StarElem B) ∈ internalApproxSet _
    rw [coe_mem_internalApproxSet] at hx ⊢
    exact hx.mono fun F hF ↦ BooleanSubalgebra.subset_closure hF
  · intro L hL x hx
    induction x using Germ.inductionOn with | _ f =>
    change (f : StarElem B) ∈ internalApproxSet _ at hx ⊢
    rw [coe_mem_internalApproxSet] at hx ⊢
    have hsub : ∀ᶠ F in (fineUltrafilter B : Filter (Finset B)), (S F : Set B) ⊆ (L F : Set B) := by
      by_contra hnot
      have hev : ∀ᶠ F in (fineUltrafilter B : Filter (Finset B)),
          ¬ ((S F : Set B) ⊆ (L F : Set B)) :=
        Ultrafilter.eventually_not.mpr hnot
      have hex : ∀ F : Finset B, ¬ ((S F : Set B) ⊆ (L F : Set B)) →
          ∃ y : B, y ∈ (S F : Set B) ∧ y ∉ (L F : Set B) := fun F h ↦ Set.not_subset.mp h
      let g : Finset B → B := fun F ↦
        if h : ¬ ((S F : Set B) ⊆ (L F : Set B)) then (hex F h).choose else ⊥
      have hgS : (g : StarElem B) ∈ internalApproxSet (fun F ↦ (S F : Set B)) := by
        rw [coe_mem_internalApproxSet]
        refine hev.mono fun F hF ↦ ?_
        rw [show g F = (hex F hF).choose from dite_eq_left_of_eq_true (eq_true hF)]
        exact (hex F hF).choose_spec.1
      have hgL : (g : StarElem B) ∈ (internalBooleanSubalgebra L : Set (StarElem B)) := hL hgS
      change (g : StarElem B) ∈ internalApproxSet (fun F ↦ (L F : Set B)) at hgL
      rw [coe_mem_internalApproxSet] at hgL
      obtain ⟨F, hF, hgLF⟩ := (hev.and hgL).exists
      rw [show g F = (hex F hF).choose from dite_eq_left_of_eq_true (eq_true hF)] at hgLF
      exact (hex F hF).choose_spec.2 hgLF
    exact (hx.and hsub).mono fun F ⟨hf, hs⟩ ↦ (BooleanSubalgebra.closure_le.mpr hs) hf

/-- Goldblatt §19.4 (p. 267): The **hyperfinite approximating Boolean algebra** `B⁺` between `B`
and `*B`, defined as `internalBooleanSubalgebra subalgAt = [F ↦ ⟨F⟩]`. -/
def hyperfiniteApproxSubalgebra (B : Type*) [BooleanAlgebra B] :
    BooleanSubalgebra (StarElem B) :=
  internalBooleanSubalgebra subalgAt

/-- `hyperfiniteApproxSubalgebra B` (`B⁺`) is a **hyperfinite** subset of `StarElem B`
(Goldblatt §19.4, p. 267). -/
theorem isHyperfinite_hyperfiniteApproxSubalgebra (B : Type*) [BooleanAlgebra B] :
    IsHyperfiniteApproxSet (hyperfiniteApproxSubalgebra B : Set (StarElem B)) :=
  (exercise_19_5_1_hyperfinite_subalgebra_closure id).1

/-- Every standard element `stdElem x` (`x : B`) belongs to `hyperfiniteApproxSubalgebra B`
(`B ⊆ B⁺ ⊆ *B`, Goldblatt §19.4, p. 268). -/
theorem stdElem_mem_hyperfiniteApproxSubalgebra {B : Type*} [BooleanAlgebra B] (x : B) :
    stdElem x ∈ hyperfiniteApproxSubalgebra B := by
  change stdElem x ∈ internalApproxSet (fun F ↦ (subalgAt F : Set B))
  rw [stdElem_mem_internalApproxSet]
  exact (eventually_mem_fineUltrafilter x).mono fun F hxF ↦
    BooleanSubalgebra.subset_closure hxF

/-- Injective Boolean algebra (`BoundedLatticeHom`) embedding `x ↦ stdElem x` of `B` into its
hyperfinite approximating Boolean algebra `B⁺ = hyperfiniteApproxSubalgebra B`
(Goldblatt §19.4, p. 268). -/
def stdToHyperfiniteApprox (B : Type*) [BooleanAlgebra B] :
    BoundedLatticeHom B ↥(hyperfiniteApproxSubalgebra B) where
  toFun x := ⟨stdElem x, stdElem_mem_hyperfiniteApproxSubalgebra x⟩
  map_sup' _ _ := rfl
  map_inf' _ _ := rfl
  map_top' := rfl
  map_bot' := rfl

theorem stdToHyperfiniteApprox_le_iff {B : Type*} [BooleanAlgebra B] {x y : B} :
    stdToHyperfiniteApprox B x ≤ stdToHyperfiniteApprox B y ↔ x ≤ y := by
  change (stdElem x ≤ stdElem y) ↔ x ≤ y
  exact Germ.const_le_iff

theorem stdToHyperfiniteApprox_injective (B : Type*) [BooleanAlgebra B] :
    Function.Injective (stdToHyperfiniteApprox B) :=
  fun _ _ h ↦ stdElem_injective B (Subtype.mk.inj h)

/-- **Atomicity of `B⁺` by Transfer** (Goldblatt §19.4, p. 268):
Since every finite Boolean subalgebra `subalgAt F` (`F : Finset B`) is finite and hence **atomic**,
the hyperfinite approximating Boolean algebra `B⁺ = hyperfiniteApproxSubalgebra B` is **atomic**! -/
instance isAtomic_hyperfiniteApproxSubalgebra (B : Type*) [BooleanAlgebra B] :
    IsAtomic ↥(hyperfiniteApproxSubalgebra B) where
  eq_bot_or_exists_atom_le x := by
    by_cases hx_bot : x = ⊥
    · exact Or.inl hx_bot
    · right
      rcases x with ⟨x_val, hx_mem⟩
      induction x_val using Germ.inductionOn with | _ fx =>
      change (fx : StarElem B) ∈ internalApproxSet (fun F ↦ (subalgAt F : Set B)) at hx_mem
      rw [coe_mem_internalApproxSet] at hx_mem
      have hne : ∀ᶠ F in (fineUltrafilter B : Filter (Finset B)), fx F ≠ ⊥ := by
        by_contra hnot
        have heq : ∀ᶠ F in (fineUltrafilter B : Filter (Finset B)), fx F = ⊥ := by
          have := Ultrafilter.eventually_not.mpr hnot
          exact this.mono fun F h ↦ not_ne_iff.mp h
        apply hx_bot
        ext
        exact Germ.coe_eq.mpr heq
      have hex_atom : ∀ F : Finset B, fx F ∈ subalgAt F ∧ fx F ≠ ⊥ →
          ∃ a : subalgAt F, IsAtom a ∧ (a : B) ≤ fx F := by
        rintro F ⟨hmem, hneF⟩
        let y : subalgAt F := ⟨fx F, hmem⟩
        have hy_ne : y ≠ ⊥ := fun h ↦ hneF (congrArg Subtype.val h)
        exact (eq_bot_or_exists_atom_le y).resolve_left hy_ne
      let g : Finset B → B := fun F ↦
        if h : fx F ∈ subalgAt F ∧ fx F ≠ ⊥ then ((hex_atom F h).choose : B) else ⊥
      have hg_mem : (g : StarElem B) ∈ hyperfiniteApproxSubalgebra B := by
        change (g : StarElem B) ∈ internalApproxSet (fun F ↦ (subalgAt F : Set B))
        rw [coe_mem_internalApproxSet]
        refine Filter.Eventually.of_forall fun F ↦ ?_
        by_cases h : fx F ∈ subalgAt F ∧ fx F ≠ ⊥
        · rw [show g F = ((hex_atom F h).choose : B) from dite_eq_left_of_eq_true (eq_true h)]
          exact (hex_atom F h).choose.2
        · rw [show g F = ⊥ from dite_eq_right_of_eq_false (eq_false h)]
          exact (subalgAt F).bot_mem
      let a_elem : ↥(hyperfiniteApproxSubalgebra B) := ⟨(g : StarElem B), hg_mem⟩
      refine ⟨a_elem, ⟨?_, ?_⟩, ?_⟩
      · intro ha_bot
        have ha_eq : (g : StarElem B) = (⊥ : StarElem B) := congrArg Subtype.val ha_bot
        have hev_bot : ∀ᶠ F in (fineUltrafilter B : Filter (Finset B)), g F = ⊥ :=
          Germ.coe_eq.mp ha_eq
        obtain ⟨F, ⟨hmemF, hneF⟩, hgF⟩ := ((hx_mem.and hne).and hev_bot).exists
        have hF : fx F ∈ subalgAt F ∧ fx F ≠ ⊥ := ⟨hmemF, hneF⟩
        rw [show g F = ((hex_atom F hF).choose : B) from dite_eq_left_of_eq_true (eq_true hF)] at hgF
        exact (hex_atom F hF).choose_spec.1.ne_bot (Subtype.ext hgF)
      · intro z hza
        rcases z with ⟨z_val, hz_mem⟩
        induction z_val using Germ.inductionOn with | _ fz =>
        change (fz : StarElem B) ∈ internalApproxSet (fun F ↦ (subalgAt F : Set B)) at hz_mem
        rw [coe_mem_internalApproxSet] at hz_mem
        have hz_le : ∀ᶠ F in (fineUltrafilter B : Filter (Finset B)), fz F ≤ g F :=
          Germ.coe_le.mp hza.le
        have hz_ne : ∀ᶠ F in (fineUltrafilter B : Filter (Finset B)), fz F ≠ g F := by
          by_contra hnot
          have heq : ∀ᶠ F in (fineUltrafilter B : Filter (Finset B)), fz F = g F := by
            have := Ultrafilter.eventually_not.mpr hnot
            exact this.mono fun F h ↦ not_ne_iff.mp h
          exact hza.ne (Subtype.ext (Germ.coe_eq.mpr heq))
        have hbot : ∀ᶠ F in (fineUltrafilter B : Filter (Finset B)), fz F = ⊥ := by
          refine ((((hx_mem.and hne).and hz_mem).and hz_le).and hz_ne).mono ?_
          rintro F ⟨⟨⟨⟨hmemF, hneF⟩, hzF⟩, hleF⟩, hne_zg⟩
          have hF : fx F ∈ subalgAt F ∧ fx F ≠ ⊥ := ⟨hmemF, hneF⟩
          have hgF : g F = ((hex_atom F hF).choose : B) := dite_eq_left_of_eq_true (eq_true hF)
          rw [hgF] at hleF hne_zg
          let aF : subalgAt F := (hex_atom F hF).choose
          have haF : IsAtom aF := (hex_atom F hF).choose_spec.1
          let zF : subalgAt F := ⟨fz F, hzF⟩
          have hlt : zF < aF := lt_of_le_of_ne hleF (fun h ↦ hne_zg (congrArg Subtype.val h))
          exact congrArg Subtype.val (haF.2 zF hlt)
        exact Subtype.ext (Germ.coe_eq.mpr hbot)
      · change (g : StarElem B) ≤ (fx : StarElem B)
        refine Germ.coe_le.mpr ((hx_mem.and hne).mono fun F ⟨hmemF, hneF⟩ ↦ ?_)
        have hF : fx F ∈ subalgAt F ∧ fx F ≠ ⊥ := ⟨hmemF, hneF⟩
        rw [show g F = ((hex_atom F hF).choose : B) from dite_eq_left_of_eq_true (eq_true hF)]
        exact (hex_atom F hF).choose_spec.2

/-- **Hyperfinite Proof of Stone's Field-of-Sets Theorem** (Goldblatt §19.4, p. 268):
Composing `stdToHyperfiniteApprox B : B ↪ B⁺` with `atomsBelowHom B⁺ : B⁺ ↪ Set (Atoms B⁺)` gives
an explicit order- and Boolean-algebra embedding of **every** Boolean algebra `B` into the power-set
algebra `Set (Atoms (hyperfiniteApproxSubalgebra B))` of internal atoms of `B⁺`! -/
def stoneHyperfiniteRep (B : Type*) [BooleanAlgebra B] :
    BoundedLatticeHom B (Set (Atoms ↥(hyperfiniteApproxSubalgebra B))) :=
  (atomsBelowHom ↥(hyperfiniteApproxSubalgebra B)).comp (stdToHyperfiniteApprox B)

theorem stoneHyperfiniteRep_le_iff {B : Type*} [BooleanAlgebra B] {x y : B} :
    stoneHyperfiniteRep B x ≤ stoneHyperfiniteRep B y ↔ x ≤ y := by
  rw [stoneHyperfiniteRep, BoundedLatticeHom.comp_apply, BoundedLatticeHom.comp_apply,
    atomsBelowHom_le_iff, stdToHyperfiniteApprox_le_iff]

theorem stoneHyperfiniteRep_injective (B : Type*) [BooleanAlgebra B] :
    Function.Injective (stoneHyperfiniteRep B) :=
  atomsBelowHom_injective.comp (stdToHyperfiniteApprox_injective B)

/-- Order (hence Boolean algebra) isomorphism between an arbitrary Boolean algebra `B` and the
field of sets `BooleanSubalgebra.map (stoneHyperfiniteRep B) ⊤` of internal atoms of `B⁺`
(Goldblatt §19.4, p. 268). -/
def stoneHyperfiniteOrderIso (B : Type*) [BooleanAlgebra B] :
    B ≃o ↥(BooleanSubalgebra.map (stoneHyperfiniteRep B) ⊤) :=
  { Equiv.ofBijective
      (fun x : B ↦ (⟨stoneHyperfiniteRep B x, ⟨x, trivial, rfl⟩⟩ :
        ↥(BooleanSubalgebra.map (stoneHyperfiniteRep B) ⊤)))
      ⟨fun _ _ h ↦ stoneHyperfiniteRep_injective B (Subtype.mk.inj h),
       fun ⟨_, ⟨x, _, hx⟩⟩ ↦ ⟨x, Subtype.ext hx⟩⟩ with
    map_rel_iff' := stoneHyperfiniteRep_le_iff }

end HyperfiniteBooleanAlgebra

/-! ## §19.6–19.7 Filters, Ultrafilters, Stone's Representation Theorem, Stone Space Clopen Duality,
and Exercises 19.7(1)–(4) (pp. 269–273) -/

section BooleanFiltersAndStone

/-- Goldblatt §19.6 (p. 269): A **filter** of a Boolean algebra (or bounded-above meet-semilattice)
`B` is a nonempty (`⊤ ∈ F`), meet-closed, upward-closed subset of `B`. -/
structure BoolFilter (B : Type*) [BooleanAlgebra B] where
  /-- Underlying subset of `B`. -/
  carrier : Set B
  /-- `⊤ ∈ F` (`F` is nonempty). -/
  top_mem' : ⊤ ∈ carrier
  /-- Closed under finite meets (`x, y ∈ F → x ⊓ y ∈ F`). -/
  inf_mem' : ∀ {x y : B}, x ∈ carrier → y ∈ carrier → x ⊓ y ∈ carrier
  /-- Closed upward (`x ∈ F → x ≤ y → y ∈ F`). -/
  mem_of_le' : ∀ {x y : B}, x ∈ carrier → x ≤ y → y ∈ carrier

namespace BoolFilter

instance {B : Type*} [BooleanAlgebra B] : SetLike (BoolFilter B) B where
  coe F := F.carrier
  coe_injective F₁ F₂ h := by cases F₁; cases F₂; congr

@[ext]
theorem ext {B : Type*} [BooleanAlgebra B] {F₁ F₂ : BoolFilter B}
    (h : ∀ x : B, x ∈ F₁ ↔ x ∈ F₂) : F₁ = F₂ :=
  SetLike.ext h

theorem top_mem {B : Type*} [BooleanAlgebra B] (F : BoolFilter B) : (⊤ : B) ∈ F :=
  F.top_mem'

theorem inf_mem {B : Type*} [BooleanAlgebra B] (F : BoolFilter B) {x y : B}
    (hx : x ∈ F) (hy : y ∈ F) : x ⊓ y ∈ F :=
  F.inf_mem' hx hy

theorem mem_of_le {B : Type*} [BooleanAlgebra B] (F : BoolFilter B) {x y : B}
    (hx : x ∈ F) (hle : x ≤ y) : y ∈ F :=
  F.mem_of_le' hx hle

theorem finset_inf_mem {B ι : Type*} [BooleanAlgebra B] (F : BoolFilter B)
    (s : Finset ι) {f : ι → B} (hs : ∀ i ∈ s, f i ∈ F) :
    s.inf f ∈ F := by
  classical
  induction s using Finset.induction with
  | empty => simpa using F.top_mem
  | insert a s _ ih =>
    rw [Finset.inf_insert]
    exact F.inf_mem (hs a (Finset.mem_insert_self a s))
      (ih fun i hi ↦ hs i (Finset.mem_insert_of_mem hi))

/-- Goldblatt §19.6 (p. 269): A filter `F` of `B` is **proper** if `⊥ ∉ F` (equivalently `F ≠ B`). -/
def IsProper {B : Type*} [BooleanAlgebra B] (F : BoolFilter B) : Prop :=
  (⊥ : B) ∉ F

theorem isProper_iff_ne_univ {B : Type*} [BooleanAlgebra B] (F : BoolFilter B) :
    F.IsProper ↔ (F : Set B) ≠ Set.univ := by
  constructor
  · intro h hall
    apply h
    change (⊥ : B) ∈ (F : Set B)
    rw [hall]
    trivial
  · intro hne hbot
    apply hne
    ext x
    exact ⟨fun _ ↦ trivial, fun _ ↦ F.mem_of_le hbot bot_le⟩

/-- Goldblatt §19.6 (p. 270): The **principal filter** `↑b = {x ∈ B | b ≤ x}` generated by `b : B`. -/
def principal {B : Type*} [BooleanAlgebra B] (b : B) : BoolFilter B where
  carrier := {x : B | b ≤ x}
  top_mem' := le_top
  inf_mem' hx hy := le_inf hx hy
  mem_of_le' hx hle := hx.trans hle

@[simp]
theorem mem_principal {B : Type*} [BooleanAlgebra B] {b x : B} :
    x ∈ principal b ↔ b ≤ x :=
  Iff.rfl

theorem isProper_principal_iff {B : Type*} [BooleanAlgebra B] {b : B} :
    (principal b).IsProper ↔ b ≠ ⊥ := by
  simp [IsProper, le_bot_iff]

/-- Goldblatt §19.6 (p. 271): **Every filter on a finite Boolean algebra is principal!** -/
theorem exists_principal_of_finite {B : Type*} [BooleanAlgebra B] [Finite B]
    (F : BoolFilter B) :
    ∃ b : B, F = principal b := by
  cases nonempty_fintype B
  let s : Finset B := Finset.univ.filter (· ∈ F)
  let b : B := s.inf id
  have hb_mem : b ∈ F := F.finset_inf_mem s fun x hx ↦ (Finset.mem_filter.mp hx).2
  refine ⟨b, ?_⟩
  ext x
  constructor
  · intro hx
    exact Finset.inf_le (Finset.mem_filter.mpr ⟨Finset.mem_univ x, hx⟩)
  · intro hbx
    exact F.mem_of_le hb_mem hbx

/-- Filter generated by a subset `G : Set B` consisting of elements above some finite meet of `G`
(Goldblatt §19.6, p. 270). -/
def generate {B : Type*} [BooleanAlgebra B] (G : Set B) : BoolFilter B where
  carrier := {x : B | ∃ S : Finset B, (S : Set B) ⊆ G ∧ S.inf id ≤ x}
  top_mem' := ⟨∅, by simp, le_top⟩
  inf_mem' := by
    rintro x y ⟨S₁, hS₁, hle₁⟩ ⟨S₂, hS₂, hle₂⟩
    classical
    refine ⟨S₁ ∪ S₂, ?_, ?_⟩
    · rw [Finset.coe_union]
      exact Set.union_subset hS₁ hS₂
    · rw [Finset.inf_union]
      exact inf_le_inf hle₁ hle₂
  mem_of_le' := by
    rintro x y ⟨S, hS, hle⟩ hxy
    exact ⟨S, hS, hle.trans hxy⟩

theorem subset_generate {B : Type*} [BooleanAlgebra B] (G : Set B) :
    G ⊆ (generate G : Set B) :=
  fun x hx ↦ ⟨{x}, Finset.singleton_subset_set_iff.mpr hx, by simp⟩

theorem isProper_generate_iff {B : Type*} [BooleanAlgebra B] (G : Set B) :
    (generate G).IsProper ↔ ∀ S : Finset B, (S : Set B) ⊆ G → S.inf id ≠ ⊥ := by
  unfold IsProper
  change (¬ ∃ S : Finset B, (S : Set B) ⊆ G ∧ S.inf id ≤ ⊥) ↔ _
  simp [le_bot_iff]

end BoolFilter

/-- Goldblatt §19.6 (p. 269): A **Boolean ultrafilter** of `B` is a proper filter `U` such that for
every `x : B`, either `x ∈ U` or `xᶜ ∈ U`. -/
structure BoolUltrafilter (B : Type*) [BooleanAlgebra B] extends BoolFilter B where
  /-- `⊥ ∉ U`. -/
  bot_notMem' : (⊥ : B) ∉ carrier
  /-- Dichotomy: for every `x : B`, `x ∈ U` or `xᶜ ∈ U`. -/
  mem_or_compl_mem' : ∀ x : B, x ∈ carrier ∨ xᶜ ∈ carrier

namespace BoolUltrafilter

instance {B : Type*} [BooleanAlgebra B] : SetLike (BoolUltrafilter B) B where
  coe U := U.carrier
  coe_injective U₁ U₂ h := by
    cases U₁ with | mk f₁ _ _ =>
    cases U₂ with | mk f₂ _ _ =>
    have hf : f₁ = f₂ := SetLike.coe_injective h
    subst hf; rfl

@[ext]
theorem ext {B : Type*} [BooleanAlgebra B] {U₁ U₂ : BoolUltrafilter B}
    (h : ∀ x : B, x ∈ U₁ ↔ x ∈ U₂) : U₁ = U₂ :=
  SetLike.ext h

theorem top_mem {B : Type*} [BooleanAlgebra B] (U : BoolUltrafilter B) : (⊤ : B) ∈ U :=
  U.top_mem'

theorem bot_notMem {B : Type*} [BooleanAlgebra B] (U : BoolUltrafilter B) : (⊥ : B) ∉ U :=
  U.bot_notMem'

theorem isProper {B : Type*} [BooleanAlgebra B] (U : BoolUltrafilter B) :
    U.toBoolFilter.IsProper :=
  U.bot_notMem'

theorem inf_mem {B : Type*} [BooleanAlgebra B] (U : BoolUltrafilter B) {x y : B}
    (hx : x ∈ U) (hy : y ∈ U) : x ⊓ y ∈ U :=
  U.inf_mem' hx hy

theorem mem_of_le {B : Type*} [BooleanAlgebra B] (U : BoolUltrafilter B) {x y : B}
    (hx : x ∈ U) (hle : x ≤ y) : y ∈ U :=
  U.mem_of_le' hx hle

theorem mem_or_compl_mem {B : Type*} [BooleanAlgebra B] (U : BoolUltrafilter B) (x : B) :
    x ∈ U ∨ xᶜ ∈ U :=
  U.mem_or_compl_mem' x

theorem not_mem_and_compl_mem {B : Type*} [BooleanAlgebra B] (U : BoolUltrafilter B) (x : B) :
    ¬ (x ∈ U ∧ xᶜ ∈ U) := by
  rintro ⟨hx, hxc⟩
  have hbot : (⊥ : B) ∈ U := by
    have h := U.inf_mem hx hxc
    rwa [le_bot_iff.mp (BooleanAlgebra.inf_compl_le_bot x)] at h
  exact U.bot_notMem hbot

/-- Goldblatt §19.6 (p. 269): `xᶜ ∈ U ↔ x ∉ U`. -/
@[simp]
theorem compl_mem_iff_notMem {B : Type*} [BooleanAlgebra B] (U : BoolUltrafilter B) {x : B} :
    xᶜ ∈ U ↔ x ∉ U :=
  ⟨fun hxc hx ↦ U.not_mem_and_compl_mem x ⟨hx, hxc⟩,
   fun hx ↦ (U.mem_or_compl_mem x).resolve_left hx⟩

theorem notMem_iff_compl_mem {B : Type*} [BooleanAlgebra B] (U : BoolUltrafilter B) {x : B} :
    x ∉ U ↔ xᶜ ∈ U :=
  (U.compl_mem_iff_notMem).symm

/-- Goldblatt §19.6 (p. 270): `x ⊓ y ∈ U ↔ x ∈ U ∧ y ∈ U`. -/
@[simp]
theorem inf_mem_iff {B : Type*} [BooleanAlgebra B] (U : BoolUltrafilter B) {x y : B} :
    x ⊓ y ∈ U ↔ x ∈ U ∧ y ∈ U :=
  ⟨fun h ↦ ⟨U.mem_of_le h inf_le_left, U.mem_of_le h inf_le_right⟩,
   fun ⟨hx, hy⟩ ↦ U.inf_mem hx hy⟩

/-- Goldblatt §19.6 (p. 270): Prime filter property `x ⊔ y ∈ U ↔ x ∈ U ∨ y ∈ U`. -/
@[simp]
theorem sup_mem_iff {B : Type*} [BooleanAlgebra B] (U : BoolUltrafilter B) {x y : B} :
    x ⊔ y ∈ U ↔ x ∈ U ∨ y ∈ U := by
  rw [← not_iff_not, not_or, U.notMem_iff_compl_mem, compl_sup, U.inf_mem_iff,
    U.compl_mem_iff_notMem, U.compl_mem_iff_notMem]

theorem finset_sup_mem_iff {B ι : Type*} [BooleanAlgebra B] (U : BoolUltrafilter B)
    (s : Finset ι) (f : ι → B) :
    s.sup f ∈ U ↔ ∃ i ∈ s, f i ∈ U := by
  classical
  induction s using Finset.induction with
  | empty => simp [U.bot_notMem]
  | insert a s _ ih =>
    rw [Finset.sup_insert, U.sup_mem_iff, ih]
    simp

/-- Goldblatt §19.6 (p. 270): Ultrafilters are **maximal** proper filters: if `U ⊆ F` for a proper
filter `F`, then `U = F`. -/
theorem eq_of_le_proper {B : Type*} [BooleanAlgebra B] (U : BoolUltrafilter B)
    {F : BoolFilter B} (hF : F.IsProper) (hle : (U : Set B) ⊆ F) :
    U.toBoolFilter = F := by
  ext x
  refine ⟨fun hx ↦ hle hx, fun hxF ↦ ?_⟩
  by_contra hxU
  have hxc : xᶜ ∈ F := hle (U.notMem_iff_compl_mem.mp hxU)
  have hbot : (⊥ : B) ∈ F := by
    have h := F.inf_mem hxF hxc
    rwa [le_bot_iff.mp (BooleanAlgebra.inf_compl_le_bot x)] at h
  exact hF hbot

end BoolUltrafilter

/-- Goldblatt §19.6 (p. 270): A proper filter `F` is a maximal proper filter **if and only if** it
satisfies the ultrafilter dichotomy `∀ x, x ∈ F ∨ xᶜ ∈ F`! -/
theorem maximal_proper_iff_ultrafilter {B : Type*} [BooleanAlgebra B] (F : BoolFilter B) :
    (F.IsProper ∧ ∀ G : BoolFilter B, G.IsProper → (F : Set B) ⊆ G → G = F) ↔
      (F.IsProper ∧ ∀ x : B, x ∈ F ∨ xᶜ ∈ F) := by
  constructor
  · rintro ⟨hproper, hmax⟩
    refine ⟨hproper, fun x ↦ ?_⟩
    by_contra! hnot
    rcases hnot with ⟨hx, hxc⟩
    let G : BoolFilter B :=
      { carrier := {z : B | ∃ y ∈ F, y ⊓ x ≤ z}
        top_mem' := ⟨⊤, F.top_mem, le_top⟩
        inf_mem' := by
          rintro z₁ z₂ ⟨y₁, hy₁, h₁⟩ ⟨y₂, hy₂, h₂⟩
          refine ⟨y₁ ⊓ y₂, F.inf_mem hy₁ hy₂, ?_⟩
          calc (y₁ ⊓ y₂) ⊓ x
              ≤ (y₁ ⊓ x) ⊓ (y₂ ⊓ x) :=
                le_inf (inf_le_inf_right x inf_le_left) (inf_le_inf_right x inf_le_right)
            _ ≤ z₁ ⊓ z₂ := inf_le_inf h₁ h₂
        mem_of_le' := by
          rintro z₁ z₂ ⟨y, hy, h₁⟩ hle
          exact ⟨y, hy, h₁.trans hle⟩ }
    have hG_proper : G.IsProper := by
      rintro ⟨y, hyF, hle⟩
      have hy_le : y ≤ xᶜ := le_compl_iff_disjoint_right.mpr (disjoint_iff_inf_le.mpr hle)
      exact hxc (F.mem_of_le hyF hy_le)
    have hFG : (F : Set B) ⊆ G := fun y hy ↦ ⟨y, hy, inf_le_left⟩
    have hxG : x ∈ G := ⟨⊤, F.top_mem, by simp⟩
    rw [hmax G hG_proper hFG] at hxG
    exact hx hxG
  · rintro ⟨hproper, hdich⟩
    let U : BoolUltrafilter B := ⟨F, hproper, hdich⟩
    exact ⟨hproper, fun G hG hFG ↦ (U.eq_of_le_proper hG hFG).symm⟩

/-- Goldblatt §19.6 (p. 270): Bijection between Boolean ultrafilters `BoolUltrafilter B` and
2-valued Boolean algebra homomorphisms `BoundedLatticeHom B Bool` (`f(x) = T ↔ x ∈ U`). -/
def boolUltrafilterEquivHom (B : Type*) [BooleanAlgebra B] :
    BoolUltrafilter B ≃ BoundedLatticeHom B Bool where
  toFun U :=
    { toFun := fun x ↦ decide (x ∈ U)
      map_sup' := fun x y ↦ by simp [U.sup_mem_iff]
      map_inf' := fun x y ↦ by simp [U.inf_mem_iff]
      map_top' := by simp [U.top_mem]
      map_bot' := by simp [U.bot_notMem] }
  invFun f :=
    { carrier := {x : B | f x = true}
      top_mem' := TopHomClass.map_top f
      inf_mem' := fun {x y} hx hy ↦ by
        change f (x ⊓ y) = true
        rw [InfHomClass.map_inf f x y, hx, hy]; rfl
      mem_of_le' := fun {x y} hx hle ↦ by
        have h : f x ≤ f y := OrderHomClass.mono f hle
        rw [hx] at h
        exact top_unique h
      bot_notMem' := by
        change ¬ (f ⊥ = true)
        rw [BotHomClass.map_bot f]; decide
      mem_or_compl_mem' := fun x ↦ by
        change f x = true ∨ f xᶜ = true
        rw [map_compl' f x, Bool.compl_eq_bnot]
        cases f x <;> simp }
  left_inv U := by
    ext x
    change decide (x ∈ U) = true ↔ x ∈ U
    simp
  right_inv f := by
    ext x
    exact Bool.eq_iff_iff.mpr decide_eq_true_eq.to_iff

/-- Goldblatt §19.6 (p. 270): A principal filter `principal b` is an ultrafilter **if and only if**
`b` is an atom (`IsAtom b`)! -/
theorem principal_isUltrafilter_iff_isAtom {B : Type*} [BooleanAlgebra B] {b : B} :
    ((BoolFilter.principal b).IsProper ∧
      ∀ x : B, x ∈ BoolFilter.principal b ∨ xᶜ ∈ BoolFilter.principal b) ↔ IsAtom b := by
  rw [BoolFilter.isProper_principal_iff]
  simp only [BoolFilter.mem_principal]
  constructor
  · rintro ⟨hb_ne, hdich⟩
    refine ⟨hb_ne, fun y hyb ↦ ?_⟩
    by_contra hy_ne
    rcases hdich y with hby | hbyc
    · exact hyb.not_ge hby
    · have hbot : y ≤ ⊥ := by
        calc y = y ⊓ b := (inf_of_le_left hyb.le).symm
          _ ≤ y ⊓ yᶜ := inf_le_inf_left y hbyc
          _ ≤ ⊥ := BooleanAlgebra.inf_compl_le_bot y
      exact hy_ne (le_bot_iff.mp hbot)
  · intro hb
    refine ⟨hb.ne_bot, fun x ↦ ?_⟩
    rw [isAtom_le_compl_iff hb]
    exact em (b ≤ x)

/-- **Exercise 19.7(1)** (Goldblatt §19.7, p. 271): Every atom `a` of the hyperfinite approximating
Boolean algebra `B⁺ = hyperfiniteApproxSubalgebra B` induces a Boolean ultrafilter
`U_a = {x ∈ B | a ≤ stdToHyperfiniteApprox B x}` on `B`! -/
def atomHyperfiniteUltrafilter {B : Type*} [BooleanAlgebra B]
    {a : ↥(hyperfiniteApproxSubalgebra B)} (ha : IsAtom a) : BoolUltrafilter B where
  carrier := {x : B | a ≤ stdToHyperfiniteApprox B x}
  top_mem' := by
    change a ≤ stdToHyperfiniteApprox B ⊤
    rw [TopHomClass.map_top]; exact le_top
  inf_mem' {x y} hx hy := by
    change a ≤ stdToHyperfiniteApprox B (x ⊓ y)
    rw [InfHomClass.map_inf]
    exact le_inf hx hy
  mem_of_le' hx hle := hx.trans (OrderHomClass.mono (stdToHyperfiniteApprox B) hle)
  bot_notMem' hbot := by
    change a ≤ stdToHyperfiniteApprox B ⊥ at hbot
    rw [BotHomClass.map_bot, le_bot_iff] at hbot
    exact ha.ne_bot hbot
  mem_or_compl_mem' x := by
    change a ≤ stdToHyperfiniteApprox B x ∨ a ≤ stdToHyperfiniteApprox B xᶜ
    rw [map_compl' (stdToHyperfiniteApprox B) x, isAtom_le_compl_iff ha]
    exact em (a ≤ stdToHyperfiniteApprox B x)

/-- **Exercise 19.7(2)** (Goldblatt §19.7, p. 272): Every internal filter `[F ↦ P F]` of the
hyperfinite Boolean algebra `B⁺ = hyperfiniteApproxSubalgebra B` (assembled from filters
`P : ∀ F : Finset B, BoolFilter ↥(subalgAt F)`) is **principal** in `B⁺`: there exists `b ∈ B⁺`
such that `[F ↦ P F] = BoolFilter.principal b`, and `b ≠ ⊥` whenever each `P F` is proper! -/
theorem exercise_19_7_2_internal_filter_principal {B : Type*} [BooleanAlgebra B]
    (P : ∀ F : Finset B, BoolFilter ↥(subalgAt F)) :
    ∃ b : ↥(hyperfiniteApproxSubalgebra B),
      (∀ x : ↥(hyperfiniteApproxSubalgebra B),
        (∀ᶠ F in (fineUltrafilter B : Filter (Finset B)),
          ∃ hx : (Quotient.out x.1) F ∈ subalgAt F,
            (⟨(Quotient.out x.1) F, hx⟩ : ↥(subalgAt F)) ∈ P F) ↔
        b ≤ x) ∧
      ((∀ᶠ F in (fineUltrafilter B : Filter (Finset B)), (P F).IsProper) → b ≠ ⊥) := by
  have hex_b : ∀ F : Finset B, ∃ bF : ↥(subalgAt F), P F = BoolFilter.principal bF :=
    fun F ↦ BoolFilter.exists_principal_of_finite (P F)
  choose bF hbF using hex_b
  let g : Finset B → B := fun F ↦ (bF F : B)
  have hg_mem : (g : StarElem B) ∈ hyperfiniteApproxSubalgebra B := by
    change (g : StarElem B) ∈ internalApproxSet (fun F ↦ (subalgAt F : Set B))
    rw [coe_mem_internalApproxSet]
    exact Filter.Eventually.of_forall fun F ↦ (bF F).2
  let b : ↥(hyperfiniteApproxSubalgebra B) := ⟨(g : StarElem B), hg_mem⟩
  refine ⟨b, ?_, ?_⟩
  · intro x
    let fx : Finset B → B := Quotient.out x.1
    have hx_out : (fx : StarElem B) = x.1 := Quotient.out_eq x.1
    have hx_mem : ∀ᶠ F in (fineUltrafilter B : Filter (Finset B)), fx F ∈ subalgAt F := by
      have h : x.1 ∈ internalApproxSet (fun F ↦ (subalgAt F : Set B)) := x.2
      rw [← hx_out, coe_mem_internalApproxSet] at h
      exact h
    change (∀ᶠ F in (fineUltrafilter B : Filter (Finset B)),
        ∃ hx : fx F ∈ subalgAt F, (⟨fx F, hx⟩ : ↥(subalgAt F)) ∈ P F) ↔
      (g : StarElem B) ≤ x.1
    rw [← hx_out, Germ.coe_le]
    constructor
    · intro hP
      refine hP.mono fun F ⟨hxF, hmemP⟩ ↦ ?_
      rw [hbF F, BoolFilter.mem_principal] at hmemP
      exact hmemP
    · intro hle
      refine (hx_mem.and hle).mono fun F ⟨hxF, hleF⟩ ↦ ⟨hxF, ?_⟩
      rw [hbF F, BoolFilter.mem_principal]
      exact hleF
  · intro hprop hb_bot
    have hg_bot : ∀ᶠ F in (fineUltrafilter B : Filter (Finset B)), g F = ⊥ :=
      Germ.coe_eq.mp (congrArg Subtype.val hb_bot)
    obtain ⟨F, hpropF, hgF⟩ := (hprop.and hg_bot).exists
    rw [hbF F, BoolFilter.isProper_principal_iff] at hpropF
    exact hpropF (Subtype.ext hgF)

/-- **Nonstandard Proof of the Boolean Ultrafilter Theorem** (Goldblatt §19.6, p. 271):
Every proper filter `F₀ : BoolFilter B` of a Boolean algebra `B` can be extended to a Boolean
ultrafilter `U : BoolUltrafilter B` (`(F₀ : Set B) ⊆ U`)!

Proved via Goldblatt's hyperfinite approximation argument:
1. Restrict `F₀` to each finite Boolean subalgebra `subalgAt S` (`S : Finset B`); since `subalgAt S`
   is finite and `⊥ ∉ F₀`, the restriction `P_S` is principal with nonzero generator `b_S ≠ ⊥`.
2. Assemble `b = [S ↦ b_S] ≠ ⊥` in the hyperfinite atomic algebra `B⁺`.
3. Pick an atom `a` of `B⁺` with `a ≤ b`; then `U_a` (Exercise 19.7(1)) is an ultrafilter of `B`
   containing `F₀`! -/
theorem exists_boolUltrafilter_extending {B : Type*} [BooleanAlgebra B]
    (F₀ : BoolFilter B) (hF₀ : F₀.IsProper) :
    ∃ U : BoolUltrafilter B, (F₀ : Set B) ⊆ U := by
  let P : ∀ S : Finset B, BoolFilter ↥(subalgAt S) := fun S ↦
    { carrier := {x : ↥(subalgAt S) | (x : B) ∈ F₀}
      top_mem' := F₀.top_mem
      inf_mem' := fun hx hy ↦ F₀.inf_mem hx hy
      mem_of_le' := fun hx hle ↦ F₀.mem_of_le hx hle }
  have hP_proper : ∀ S : Finset B, (P S).IsProper := fun S hbot ↦ hF₀ hbot
  obtain ⟨b, hb_iff, hb_ne_bot_of_proper⟩ := exercise_19_7_2_internal_filter_principal P
  have hb_ne_bot : b ≠ ⊥ := hb_ne_bot_of_proper (Filter.Eventually.of_forall hP_proper)
  obtain ⟨a, ha_atom, hab⟩ := (eq_bot_or_exists_atom_le b).resolve_left hb_ne_bot
  refine ⟨atomHyperfiniteUltrafilter ha_atom, fun y hyF₀ ↦ ?_⟩
  change a ≤ stdToHyperfiniteApprox B y
  refine hab.trans ?_
  rw [← hb_iff (stdToHyperfiniteApprox B y)]
  let fy : Finset B → B := Quotient.out (stdElem y)
  have hout : (fy : StarElem B) = stdElem y := Quotient.out_eq (stdElem y)
  have hev_eq : ∀ᶠ S in (fineUltrafilter B : Filter (Finset B)), fy S = y :=
    Germ.coe_eq.mp hout
  refine ((eventually_mem_fineUltrafilter y).and hev_eq).mono fun S ⟨hyS, h_eq⟩ ↦ ?_
  have hy_sub : fy S ∈ subalgAt S := by
    rw [h_eq]
    exact BooleanSubalgebra.subset_closure hyS
  refine ⟨hy_sub, ?_⟩
  change fy S ∈ F₀
  rwa [h_eq]

/-- Finite-Intersection-Property Corollary (Goldblatt §19.6, p. 270): Any subset `G ⊆ B` whose
finite meets are nonzero (`∀ S : Finset B, ↑S ⊆ G → S.inf id ≠ ⊥`) is contained in a Boolean
ultrafilter `U : BoolUltrafilter B`! -/
theorem exists_boolUltrafilter_of_fip {B : Type*} [BooleanAlgebra B] (G : Set B)
    (hfip : ∀ S : Finset B, (S : Set B) ⊆ G → S.inf id ≠ ⊥) :
    ∃ U : BoolUltrafilter B, G ⊆ U := by
  obtain ⟨U, hU⟩ :=
    exists_boolUltrafilter_extending (BoolFilter.generate G)
      ((BoolFilter.isProper_generate_iff G).mpr hfip)
  exact ⟨U, (BoolFilter.subset_generate G).trans hU⟩

/-- Nonzero Element Ultrafilter Corollary (Goldblatt §19.6, p. 270): Every nonzero `x ≠ ⊥` in `B`
belongs to some Boolean ultrafilter `U : BoolUltrafilter B`! -/
theorem exists_boolUltrafilter_mem_of_ne_bot {B : Type*} [BooleanAlgebra B] {x : B} (hx : x ≠ ⊥) :
    ∃ U : BoolUltrafilter B, x ∈ U := by
  obtain ⟨U, hU⟩ :=
    exists_boolUltrafilter_extending (BoolFilter.principal x)
      (BoolFilter.isProper_principal_iff.mpr hx)
  exact ⟨U, hU le_rfl⟩

/-- Ultrafilter separation of non-ordered elements (Goldblatt §19.6, p. 270): if `¬ (x ≤ y)` in
`B`, there is a Boolean ultrafilter `U` with `x ∈ U` and `y ∉ U`. -/
theorem exists_boolUltrafilter_separating {B : Type*} [BooleanAlgebra B] {x y : B}
    (hnot : ¬ x ≤ y) :
    ∃ U : BoolUltrafilter B, x ∈ U ∧ y ∉ U := by
  have hne : x ⊓ yᶜ ≠ ⊥ := by
    intro hbot
    apply hnot
    have hdisj : Disjoint x yᶜ := disjoint_iff.mpr hbot
    have hle : x ≤ yᶜᶜ := le_compl_iff_disjoint_right.mpr hdisj
    rwa [compl_compl] at hle
  obtain ⟨U, hU⟩ := exists_boolUltrafilter_mem_of_ne_bot hne
  rw [U.inf_mem_iff, U.compl_mem_iff_notMem] at hU
  exact ⟨U, hU⟩

/-! ### Stone's Representation Theorem & Full Stone Space Topological Clopen Duality -/

/-- Goldblatt §19.6 (p. 270): Basic Stone set `Ŝ(x) = {U : BoolUltrafilter B | x ∈ U}`. -/
def stoneSet (B : Type*) [BooleanAlgebra B] (x : B) : Set (BoolUltrafilter B) :=
  {U : BoolUltrafilter B | x ∈ U}

@[simp]
theorem mem_stoneSet {B : Type*} [BooleanAlgebra B] {x : B} {U : BoolUltrafilter B} :
    U ∈ stoneSet B x ↔ x ∈ U :=
  Iff.rfl

@[simp]
theorem stoneSet_compl {B : Type*} [BooleanAlgebra B] (x : B) :
    stoneSet B xᶜ = (stoneSet B x)ᶜ := by
  ext U
  exact U.compl_mem_iff_notMem

@[simp]
theorem stoneSet_inf {B : Type*} [BooleanAlgebra B] (x y : B) :
    stoneSet B (x ⊓ y) = stoneSet B x ∩ stoneSet B y := by
  ext U
  exact U.inf_mem_iff

@[simp]
theorem stoneSet_sup {B : Type*} [BooleanAlgebra B] (x y : B) :
    stoneSet B (x ⊔ y) = stoneSet B x ∪ stoneSet B y := by
  ext U
  exact U.sup_mem_iff

@[simp]
theorem stoneSet_top (B : Type*) [BooleanAlgebra B] :
    stoneSet B ⊤ = Set.univ := by
  ext U
  simp [U.top_mem]

@[simp]
theorem stoneSet_bot (B : Type*) [BooleanAlgebra B] :
    stoneSet B ⊥ = ∅ := by
  ext U
  simp [U.bot_notMem]

theorem stoneSet_finset_sup {B ι : Type*} [BooleanAlgebra B] (s : Finset ι) (f : ι → B) :
    stoneSet B (s.sup f) = ⋃ i ∈ s, stoneSet B (f i) := by
  ext U
  simp [U.finset_sup_mem_iff]

/-- **Stone's Representation Homomorphism** (Goldblatt §19.6, p. 270):
`x ↦ {U : BoolUltrafilter B | x ∈ U}` as a `BoundedLatticeHom B (Set (BoolUltrafilter B))`. -/
def stoneSetHom (B : Type*) [BooleanAlgebra B] :
    BoundedLatticeHom B (Set (BoolUltrafilter B)) where
  toFun := stoneSet B
  map_sup' := stoneSet_sup
  map_inf' := stoneSet_inf
  map_top' := stoneSet_top B
  map_bot' := stoneSet_bot B

/-- `stoneSet B x ⊆ stoneSet B y ↔ x ≤ y`, proved from our nonstandard Ultrafilter Theorem! -/
theorem stoneSet_le_iff {B : Type*} [BooleanAlgebra B] {x y : B} :
    stoneSet B x ≤ stoneSet B y ↔ x ≤ y := by
  constructor
  · intro h
    by_contra hnot
    obtain ⟨U, hxU, hyU⟩ := exists_boolUltrafilter_separating hnot
    exact hyU (h hxU)
  · exact fun h U hxU ↦ U.mem_of_le hxU h

/-- `stoneSetHom B` is injective (Goldblatt §19.6, p. 270). -/
theorem stoneSetHom_injective (B : Type*) [BooleanAlgebra B] :
    Function.Injective (stoneSetHom B) :=
  fun _ _ h ↦ le_antisymm (stoneSet_le_iff.mp h.le) (stoneSet_le_iff.mp h.ge)

/-- **Stone's Field-of-Sets Representation Theorem** (Goldblatt §19.6, p. 270):
Every Boolean algebra `B` is isomorphic (`≃o`) to the field of sets `{stoneSet B x | x : B}` on its
ultrafilter space `BoolUltrafilter B`! -/
def stoneFieldOfSetsOrderIso (B : Type*) [BooleanAlgebra B] :
    B ≃o ↥(BooleanSubalgebra.map (stoneSetHom B) ⊤) :=
  { Equiv.ofBijective
      (fun x : B ↦ (⟨stoneSetHom B x, ⟨x, trivial, rfl⟩⟩ :
        ↥(BooleanSubalgebra.map (stoneSetHom B) ⊤)))
      ⟨fun _ _ h ↦ stoneSetHom_injective B (Subtype.mk.inj h),
       fun ⟨_, ⟨x, _, hx⟩⟩ ↦ ⟨x, Subtype.ext hx⟩⟩ with
    map_rel_iff' := stoneSet_le_iff }

/-- **Stone Space of a Boolean Algebra** (Goldblatt §19.6, pp. 270–271):
The type of Boolean ultrafilters of `B`, equipped with the Stone topology generated by
`{stoneSet B x | x : B}`. -/
abbrev StoneSpace (B : Type*) [BooleanAlgebra B] : Type _ :=
  BoolUltrafilter B

instance instTopologicalSpaceStoneSpace (B : Type*) [BooleanAlgebra B] :
    TopologicalSpace (StoneSpace B) :=
  TopologicalSpace.generateFrom (Set.range (stoneSet B))

/-- Basic Stone set viewed in `StoneSpace B`. -/
def stoneClopenSet (B : Type*) [BooleanAlgebra B] (x : B) : Set (StoneSpace B) :=
  stoneSet B x

/-- `{stoneClopenSet B x | x : B}` forms a topological basis of `StoneSpace B`. -/
theorem isTopologicalBasis_stoneSpace (B : Type*) [BooleanAlgebra B] :
    TopologicalSpace.IsTopologicalBasis (Set.range (stoneClopenSet B)) where
  exists_subset_inter := by
    rintro _ ⟨x, rfl⟩ _ ⟨y, rfl⟩ U ⟨hx, hy⟩
    refine ⟨stoneClopenSet B (x ⊓ y), ⟨x ⊓ y, rfl⟩, ?_, ?_⟩
    · exact U.inf_mem hx hy
    · change stoneSet B (x ⊓ y) ⊆ stoneSet B x ∩ stoneSet B y
      rw [stoneSet_inf]
  sUnion_eq := by
    ext U
    simp only [Set.mem_sUnion, Set.mem_range, exists_exists_eq_and, Set.mem_univ, iff_true]
    exact ⟨⊤, U.top_mem⟩
  eq_generateFrom := rfl

/-- Every basic Stone set `stoneClopenSet B x` is **clopen** in `StoneSpace B`! -/
theorem isClopen_stoneClopenSet (B : Type*) [BooleanAlgebra B] (x : B) :
    IsClopen (stoneClopenSet B x) := by
  refine ⟨?_, ?_⟩
  · rw [← isOpen_compl_iff]
    change IsOpen (stoneSet B x)ᶜ
    rw [← stoneSet_compl]
    exact TopologicalSpace.isOpen_generateFrom_of_mem ⟨xᶜ, rfl⟩
  · exact TopologicalSpace.isOpen_generateFrom_of_mem ⟨x, rfl⟩

/-- `StoneSpace B` is a **Hausdorff (`T₂`) space**! -/
instance instT2SpaceStoneSpace (B : Type*) [BooleanAlgebra B] : T2Space (StoneSpace B) where
  t2 U₁ U₂ hne := by
    have hex : ∃ x : B, x ∈ U₁ ∧ x ∉ U₂ := by
      by_contra! hall
      apply hne
      ext x
      refine ⟨hall x, fun hx₂ ↦ ?_⟩
      by_contra hx₁
      exact U₂.not_mem_and_compl_mem x ⟨hx₂, hall xᶜ (U₁.notMem_iff_compl_mem.mp hx₁)⟩
    obtain ⟨x, hx₁, hx₂⟩ := hex
    refine ⟨stoneClopenSet B x, stoneClopenSet B xᶜ,
      (isClopen_stoneClopenSet B x).2, (isClopen_stoneClopenSet B xᶜ).2,
      hx₁, U₂.notMem_iff_compl_mem.mp hx₂, ?_⟩
    rw [Set.disjoint_left]
    intro U h₁ h₂
    exact U.not_mem_and_compl_mem x ⟨h₁, h₂⟩

/-- `StoneSpace B` is **totally disconnected**! -/
instance instTotallyDisconnectedSpaceStoneSpace (B : Type*) [BooleanAlgebra B] :
    TotallyDisconnectedSpace (StoneSpace B) where
  isTotallyDisconnected_univ t _ ht U₁ hU₁ U₂ hU₂ := by
    by_contra hne
    have hex : ∃ x : B, x ∈ U₁ ∧ x ∉ U₂ := by
      by_contra! hall
      apply hne
      ext x
      refine ⟨hall x, fun hx₂ ↦ ?_⟩
      by_contra hx₁
      exact U₂.not_mem_and_compl_mem x ⟨hx₂, hall xᶜ (U₁.notMem_iff_compl_mem.mp hx₁)⟩
    obtain ⟨x, hx₁, hx₂⟩ := hex
    have hcov : t ⊆ stoneClopenSet B x ∪ stoneClopenSet B xᶜ := fun U _ ↦ U.mem_or_compl_mem x
    obtain ⟨U, _, hU_inter⟩ := ht (stoneClopenSet B x) (stoneClopenSet B xᶜ)
      (isClopen_stoneClopenSet B x).2 (isClopen_stoneClopenSet B xᶜ).2
      hcov ⟨U₁, hU₁, hx₁⟩ ⟨U₂, hU₂, U₂.notMem_iff_compl_mem.mp hx₂⟩
    exact U.not_mem_and_compl_mem x hU_inter

/-- `StoneSpace B` is **compact**, proved directly from our nonstandard Ultrafilter Theorem
(`exists_boolUltrafilter_of_fip`)! -/
instance instCompactSpaceStoneSpace (B : Type*) [BooleanAlgebra B] :
    CompactSpace (StoneSpace B) where
  isCompact_univ := by
    refine isCompact_of_finite_subcover fun {ι} V hV_open hV_cov ↦ ?_
    by_contra! hno_fin
    let C : Set B := {x : B | ∃ i : ι, stoneClopenSet B x ⊆ V i}
    have hdm : ∀ T : Finset B, (T.sup id)ᶜ = (T.image Compl.compl).inf id := by
      classical
      intro T
      induction T using Finset.induction with
      | empty => simp
      | insert a T _ ih =>
        rw [Finset.sup_insert, compl_sup, Finset.image_insert, Finset.inf_insert, ih]; rfl
    have hfip : ∀ S : Finset B, (S : Set B) ⊆ C → (S.image Compl.compl).inf id ≠ ⊥ := by
      classical
      intro S hSC hbot
      have hsup_top : S.sup id = ⊤ := by
        rw [← hdm S] at hbot
        exact compl_eq_bot.mp hbot
      have hex_idx : ∀ x : S, ∃ i : ι, stoneClopenSet B x.1 ⊆ V i :=
        fun x ↦ hSC x.2
      choose idx hidx using hex_idx
      let T : Finset ι := S.attach.image idx
      refine hno_fin T fun U _ ↦ ?_
      have hU_top : U ∈ stoneSet B (S.sup id) := by rw [hsup_top]; exact U.top_mem
      rw [stoneSet_finset_sup] at hU_top
      obtain ⟨x, hxS, hUx⟩ := Set.mem_iUnion₂.mp hU_top
      refine Set.mem_iUnion₂.mpr ⟨idx ⟨x, hxS⟩,
        Finset.mem_image.mpr ⟨⟨x, hxS⟩, Finset.mem_attach S ⟨x, hxS⟩, rfl⟩, ?_⟩
      exact hidx ⟨x, hxS⟩ hUx
    obtain ⟨U, hU_compl⟩ := exists_boolUltrafilter_of_fip (Compl.compl '' C) (by
      intro S hS
      have hex_pre : ∀ y : S, ∃ x ∈ C, xᶜ = y.1 := fun y ↦ hS y.2
      choose pre hpre using hex_pre
      classical
      let S₀ : Finset B := S.attach.image pre
      have hS₀_sub : (S₀ : Set B) ⊆ C := by
        intro z hz
        rcases Finset.mem_image.mp (Finset.mem_coe.mp hz) with ⟨y, _, rfl⟩
        exact (hpre y).1
      have himg : S₀.image Compl.compl = S := by
        ext y
        simp only [S₀, Finset.mem_image, Finset.mem_attach, true_and, Subtype.exists]
        constructor
        · rintro ⟨z, ⟨w, hwS, rfl⟩, rfl⟩
          rwa [(hpre ⟨w, hwS⟩).2]
        · intro hyS
          exact ⟨pre ⟨y, hyS⟩, ⟨y, hyS, rfl⟩, (hpre ⟨y, hyS⟩).2⟩
      rw [← himg]
      exact hfip S₀ hS₀_sub)
    have hU_univ : (U : StoneSpace B) ∈ Set.univ := trivial
    obtain ⟨i₀, hi₀⟩ := Set.mem_iUnion.mp (hV_cov hU_univ)
    obtain ⟨W, ⟨x₀, rfl⟩, hUx₀, hWV⟩ :=
      (isTopologicalBasis_stoneSpace B).exists_subset_of_mem_open hi₀ (hV_open i₀)
    have hx₀C : x₀ ∈ C := ⟨i₀, hWV⟩
    have hx₀cU : x₀ᶜ ∈ U := hU_compl ⟨x₀, hx₀C, rfl⟩
    exact U.not_mem_and_compl_mem x₀ ⟨hUx₀, hx₀cU⟩

/-- **Stone's Clopen Representation Theorem** (Goldblatt §19.6, pp. 270–271):
Every Boolean algebra `B` is order- and Boolean-algebra isomorphic (`≃o`) to the Boolean algebra
`TopologicalSpace.Clopens (StoneSpace B)` of clopen subsets of its compact totally disconnected
Hausdorff Stone space! -/
def stoneClopenIso (B : Type*) [BooleanAlgebra B] :
    B ≃o TopologicalSpace.Clopens (StoneSpace B) := by
  let toClopen : B → TopologicalSpace.Clopens (StoneSpace B) :=
    fun x ↦ ⟨stoneClopenSet B x, isClopen_stoneClopenSet B x⟩
  have hinj : Function.Injective toClopen :=
    fun x y h ↦ stoneSetHom_injective B (congrArg SetLike.coe h)
  have hsurj : Function.Surjective toClopen := by
    intro K
    have hK_compact : IsCompact (K : Set (StoneSpace B)) := K.isClosed.isCompact
    let idxType := {x : B // stoneClopenSet B x ⊆ (K : Set (StoneSpace B))}
    have hcov : (K : Set (StoneSpace B)) ⊆ ⋃ j : idxType, stoneClopenSet B j.1 := by
      intro U hUK
      obtain ⟨W, ⟨x, rfl⟩, hUx, hWK⟩ :=
        (isTopologicalBasis_stoneSpace B).exists_subset_of_mem_open hUK K.isOpen
      exact Set.mem_iUnion.mpr ⟨⟨x, hWK⟩, hUx⟩
    obtain ⟨T, hT_cov⟩ := hK_compact.elim_finite_subcover
      (fun j : idxType ↦ stoneClopenSet B j.1)
      (fun j ↦ (isClopen_stoneClopenSet B j.1).2) hcov
    let xK : B := T.sup (fun j : idxType ↦ j.1)
    refine ⟨xK, ?_⟩
    apply SetLike.coe_injective
    change stoneSet B (T.sup fun j : idxType ↦ j.1) = (K : Set (StoneSpace B))
    rw [stoneSet_finset_sup]
    apply Set.Subset.antisymm
    · refine Set.iUnion₂_subset fun j _ ↦ j.2
    · intro U hUK
      obtain ⟨j, hjT, hUj⟩ := Set.mem_iUnion₂.mp (hT_cov hUK)
      exact Set.mem_iUnion₂.mpr ⟨j, hjT, hUj⟩
  exact
    { Equiv.ofBijective toClopen ⟨hinj, hsurj⟩ with
      map_rel_iff' := stoneSet_le_iff }

/-! ### Exercise 19.7(3): Monadic Element in `*I` for a Nonprincipal Ultrafilter -/

/-- **Exercise 19.7(3) (Ultrapower Formulation)** (Goldblatt §19.7, p. 272):
Let `U : Ultrafilter I` be a nonprincipal ultrafilter (`∀ i₀ : I, (U : Filter I) ≠ pure i₀`) on a
type `I` (cf. `Goldblatt.Ch02.SetUltrafilter`). In the enlargement `*I = Germ U I`,
there exists a nonstandard element `e : Germ (U : Filter I) I` (`∀ i₀ : I, e ≠ ↑i₀`) that belongs to
`*A` for **every** `A ∈ U` (in fact `e ∈ *A ↔ A ∈ U`)! -/
theorem exercise_19_7_3_ultrapower {I : Type*} (U : Ultrafilter I)
    (hnonprinc : ∀ i₀ : I, (U : Filter I) ≠ pure i₀) :
    ∃ e : Germ (U : Filter I) I,
      (∀ i₀ : I, e ≠ (i₀ : Germ (U : Filter I) I)) ∧
      (∀ A : Set I,
        Germ.LiftRel (· ∈ ·) e (((fun _ : I ↦ A) : I → Set I) : Germ (U : Filter I) (Set I)) ↔
          A ∈ U) := by
  refine ⟨((id : I → I) : Germ (U : Filter I) I), ?_, ?_⟩
  · intro i₀ heq
    have hmem : {i : I | i = i₀} ∈ (U : Filter I) := Germ.coe_eq.mp heq
    apply hnonprinc i₀
    exact congrArg (fun V : Ultrafilter I ↦ (V : Filter I))
      (Ultrafilter.eq_of_le (g := (pure i₀ : Ultrafilter I)) (Filter.le_pure_iff.mpr hmem))
  · intro A
    exact Germ.liftRel_coe

/-- **Exercise 19.7(3) (Hyperfinite Approximation / Finite-Intersection Formulation)**
(Goldblatt §19.7, p. 272):
Given a Ch02 nonprincipal set-ultrafilter `ℱ : Goldblatt.Ch02.SetUltrafilter I`
(`∀ i₀ : I, ℱ.1 ≠ Goldblatt.Ch02.principalFilter i₀`), in the fine-ultrafilter enlargement over
`Finset ↥ℱ.1.sets` there exists a nonstandard element `e` belonging to `*A` for every `A ∈ ℱ`! -/
theorem exercise_19_7_3_hyperfinite {I : Type*} (ℱ : Goldblatt.Ch02.SetUltrafilter I)
    (hnonprinc : ∀ i₀ : I, ℱ.1 ≠ Goldblatt.Ch02.principalFilter i₀) :
    let J := Finset ↥ℱ.1.sets
    let W := fineUltrafilter ↥ℱ.1.sets
    ∃ e : Germ (W : Filter J) I,
      (∀ i₀ : I, e ≠ (i₀ : Germ (W : Filter J) I)) ∧
      (∀ A ∈ ℱ.1.sets,
        Germ.LiftRel (· ∈ ·) e (((fun _ : J ↦ A) : J → Set I) : Germ (W : Filter J) (Set I))) := by
  intro J W
  have hinter_mem : ∀ S : J, (⋂ A ∈ S, (A : Set I)) ∈ ℱ.1.sets := by
    classical
    intro S
    induction S using Finset.induction with
    | empty =>
      have hemp : (⋂ A ∈ (∅ : J), (A : Set I)) = Set.univ := by
        ext y
        simp only [Set.mem_iInter, Set.mem_univ, iff_true]
        intro A hA
        exact False.elim (Finset.notMem_empty A hA)
      rw [hemp]
      exact ℱ.1.univ_mem
    | insert a S _ ih =>
      rw [Finset.set_biInter_insert]
      exact ℱ.1.inter_mem a.2 ih
  have hex_elem : ∀ S : J, ∃ x : I, x ∈ ⋂ A ∈ S, (A : Set I) := by
    intro S
    exact ℱ.2.isProper.nonempty_of_mem (hinter_mem S)
  choose f hf using hex_elem
  refine ⟨(f : Germ (W : Filter J) I), ?_, ?_⟩
  · intro i₀ heq
    have hnot_mem : ({i₀} : Set I) ∉ ℱ.1 := by
      intro hmem
      exact hnonprinc i₀ (ℱ.2.singleton_mem_iff_eq_principalFilter.mp hmem)
    have hcompl_mem : ({i₀}ᶜ : Set I) ∈ ℱ.1.sets :=
      (ℱ.2.mem_or_compl_mem {i₀}).resolve_left hnot_mem
    let A₀ : ↥ℱ.1.sets := ⟨{i₀}ᶜ, hcompl_mem⟩
    have hev_mem : ∀ᶠ S in (W : Filter J), A₀ ∈ S := eventually_mem_fineUltrafilter A₀
    have hev_eq : ∀ᶠ S in (W : Filter J), f S = i₀ := Germ.coe_eq.mp heq
    obtain ⟨S, hA₀S, hfS⟩ := (hev_mem.and hev_eq).exists
    have hfA₀ : f S ∈ ({i₀}ᶜ : Set I) := Set.mem_iInter₂.mp (hf S) A₀ hA₀S
    exact hfA₀ hfS
  · intro A hA
    rw [Germ.liftRel_coe]
    refine (eventually_mem_fineUltrafilter (⟨A, hA⟩ : ↥ℱ.1.sets)).mono fun S hAS ↦ ?_
    exact Set.mem_iInter₂.mp (hf S) ⟨A, hA⟩ hAS

/-! ### Exercise 19.7(4)(a)–(b): Distributive Lattice Representation & Prime Filter Extension -/

/-- **Exercise 19.7(4)** (Goldblatt §19.7, p. 272): An element `a` of a bounded-below lattice `L` is
**join-irreducible** if `a ≠ ⊥` and `a = x ⊔ y → a = x ∨ a = y`. -/
def IsJoinIrreducibleElem {L : Type*} [Lattice L] [OrderBot L] (a : L) : Prop :=
  a ≠ ⊥ ∧ ∀ x y : L, a = x ⊔ y → a = x ∨ a = y

/-- Goldblatt §19.7, Exercise 19.7(4) Hint (p. 272): In a **distributive** lattice `L`, `a` is
join-irreducible if and only if `a ≠ ⊥` and `∀ x y, a ≤ x ⊔ y → a ≤ x ∨ a ≤ y`! -/
theorem isJoinIrreducibleElem_iff_le_sup {L : Type*} [DistribLattice L] [OrderBot L] {a : L} :
    IsJoinIrreducibleElem a ↔ (a ≠ ⊥ ∧ ∀ x y : L, a ≤ x ⊔ y → a ≤ x ∨ a ≤ y) := by
  constructor
  · rintro ⟨hne, hj⟩
    refine ⟨hne, fun x y hle ↦ ?_⟩
    have heq : a = (a ⊓ x) ⊔ (a ⊓ y) := by
      rw [← inf_sup_left, inf_of_le_left hle]
    rcases hj (a ⊓ x) (a ⊓ y) heq with h₁ | h₂
    · exact Or.inl (inf_eq_left.mp h₁.symm)
    · exact Or.inr (inf_eq_left.mp h₂.symm)
  · rintro ⟨hne, hprime⟩
    refine ⟨hne, fun x y heq ↦ ?_⟩
    rcases hprime x y heq.le with h₁ | h₂
    · exact Or.inl (le_antisymm h₁ (heq ▸ le_sup_left))
    · exact Or.inr (le_antisymm h₂ (heq ▸ le_sup_right))

/-- Key finite separation lemma for Exercise 19.7(4) (Goldblatt p. 273):
In any **finite** bounded distributive lattice `M`, if `¬ (x ≤ y)`, there exists a join-irreducible
element `a : M` such that `a ≤ x` and `¬ (a ≤ y)`! -/
theorem exists_joinIrreducibleElem_of_not_le_finite {M : Type*} [DistribLattice M]
    [BoundedOrder M] [Finite M] {x y : M} (hnot : ¬ x ≤ y) :
    ∃ a : M, IsJoinIrreducibleElem a ∧ a ≤ x ∧ ¬ a ≤ y := by
  classical
  cases nonempty_fintype M
  let S : Finset M := Finset.univ.filter fun z ↦ z ≤ x ∧ ¬ z ≤ y
  have hxS : x ∈ S := Finset.mem_filter.mpr ⟨Finset.mem_univ x, le_rfl, hnot⟩
  obtain ⟨a, haS, hmin⟩ := S.exists_minimal ⟨x, hxS⟩
  rcases (Finset.mem_filter.mp haS).2 with ⟨hax, hnot_ay⟩
  refine ⟨a, ⟨?_, ?_⟩, hax, hnot_ay⟩
  · intro habot
    exact hnot_ay (habot ▸ bot_le)
  · intro u v huv
    by_contra! hne
    rcases hne with ⟨hau, hav⟩
    have hu_lt : u < a := lt_of_le_of_ne (huv ▸ le_sup_left) hau.symm
    have hv_lt : v < a := lt_of_le_of_ne (huv ▸ le_sup_right) hav.symm
    have hu_le_y : u ≤ y := by
      by_contra hnot_uy
      have huS : u ∈ S := Finset.mem_filter.mpr ⟨Finset.mem_univ u, hu_lt.le.trans hax, hnot_uy⟩
      exact hu_lt.not_ge (hmin huS hu_lt.le)
    have hv_le_y : v ≤ y := by
      by_contra hnot_vy
      have hvS : v ∈ S := Finset.mem_filter.mpr ⟨Finset.mem_univ v, hv_lt.le.trans hax, hnot_vy⟩
      exact hv_lt.not_ge (hmin hvS hv_lt.le)
    exact hnot_ay (huv ▸ sup_le hu_le_y hv_le_y)

/-- Finite bounded sublattice of a bounded distributive lattice `L` generated by `F : Finset L`,
realized explicitly as joins of meets of subsets of `F` (Exercise 19.7(4), Goldblatt p. 273). -/
def distLatFinsetClosure {L : Type*} [DistribLattice L] [BoundedOrder L] (F : Finset L) :
    Finset L :=
  let _ : DecidableEq L := Classical.decEq L
  (Finset.univ : Finset (Finset (Finset ↥F))).image fun S ↦
    S.sup fun T ↦ T.inf Subtype.val

theorem bot_mem_distLatFinsetClosure {L : Type*} [DistribLattice L] [BoundedOrder L]
    (F : Finset L) : (⊥ : L) ∈ distLatFinsetClosure F := by
  classical
  unfold distLatFinsetClosure
  exact Finset.mem_image.mpr ⟨∅, Finset.mem_univ _, Finset.sup_empty⟩

theorem top_mem_distLatFinsetClosure {L : Type*} [DistribLattice L] [BoundedOrder L]
    (F : Finset L) : (⊤ : L) ∈ distLatFinsetClosure F := by
  classical
  unfold distLatFinsetClosure
  exact Finset.mem_image.mpr ⟨{∅}, Finset.mem_univ _, by simp⟩

theorem subset_distLatFinsetClosure {L : Type*} [DistribLattice L] [BoundedOrder L]
    (F : Finset L) : F ⊆ distLatFinsetClosure F := by
  classical
  intro x hx
  unfold distLatFinsetClosure
  exact Finset.mem_image.mpr ⟨{{⟨x, hx⟩}}, Finset.mem_univ _, by simp⟩

theorem sup_mem_distLatFinsetClosure {L : Type*} [DistribLattice L] [BoundedOrder L]
    (F : Finset L) {x y : L}
    (hx : x ∈ distLatFinsetClosure F) (hy : y ∈ distLatFinsetClosure F) :
    x ⊔ y ∈ distLatFinsetClosure F := by
  classical
  unfold distLatFinsetClosure at hx hy ⊢
  rcases Finset.mem_image.mp hx with ⟨S₁, _, rfl⟩
  rcases Finset.mem_image.mp hy with ⟨S₂, _, rfl⟩
  exact Finset.mem_image.mpr ⟨S₁ ∪ S₂, Finset.mem_univ _, Finset.sup_union⟩

theorem inf_mem_distLatFinsetClosure {L : Type*} [DistribLattice L] [BoundedOrder L]
    (F : Finset L) {x y : L}
    (hx : x ∈ distLatFinsetClosure F) (hy : y ∈ distLatFinsetClosure F) :
    x ⊓ y ∈ distLatFinsetClosure F := by
  classical
  unfold distLatFinsetClosure at hx hy ⊢
  rcases Finset.mem_image.mp hx with ⟨S₁, _, rfl⟩
  rcases Finset.mem_image.mp hy with ⟨S₂, _, rfl⟩
  let S₁₂ : Finset (Finset ↥F) := S₁.biUnion fun T₁ ↦ S₂.image fun T₂ ↦ T₁ ∪ T₂
  refine Finset.mem_image.mpr ⟨S₁₂, Finset.mem_univ _, ?_⟩
  let f : Finset ↥F → L := fun T ↦ T.inf Subtype.val
  change S₁₂.sup f = S₁.sup f ⊓ S₂.sup f
  have hsup_inf : ∀ s₁ s₂ : Finset (Finset ↥F),
      s₁.sup f ⊓ s₂.sup f = (s₁.biUnion fun T₁ ↦ s₂.image fun T₂ ↦ T₁ ∪ T₂).sup f := by
    intro s₁ s₂
    induction s₁ using Finset.induction with
    | empty => simp
    | insert T₁ s₁ _ ih =>
      rw [Finset.sup_insert, inf_sup_right, ih, Finset.biUnion_insert, Finset.sup_union]
      congr 1
      rw [inf_finset_sup, Finset.sup_image]
      refine Finset.sup_congr rfl fun T₂ _ ↦ ?_
      change f T₁ ⊓ f T₂ = f (T₁ ∪ T₂)
      exact Finset.inf_union.symm
  exact (hsup_inf S₁ S₂).symm

/-- Induced finite bounded distributive lattice structure on `↥(distLatFinsetClosure F)`. -/
instance instBoundedDistribLatticeClosure {L : Type*} [DistribLattice L] [BoundedOrder L]
    (F : Finset L) : DistribLattice ↥(distLatFinsetClosure F) where
  sup a b := ⟨a.1 ⊔ b.1, sup_mem_distLatFinsetClosure F a.2 b.2⟩
  inf a b := ⟨a.1 ⊓ b.1, inf_mem_distLatFinsetClosure F a.2 b.2⟩
  le_sup_left _ _ := le_sup_left
  le_sup_right _ _ := le_sup_right
  sup_le _ _ _ h₁ h₂ := sup_le h₁ h₂
  inf_le_left _ _ := inf_le_left
  inf_le_right _ _ := inf_le_right
  le_inf _ _ _ h₁ h₂ := le_inf h₁ h₂
  le_sup_inf a b c := le_sup_inf (x := a.1) (y := b.1) (z := c.1)

instance instBoundedOrderDistLatClosure {L : Type*} [DistribLattice L] [BoundedOrder L]
    (F : Finset L) : BoundedOrder ↥(distLatFinsetClosure F) where
  top := ⟨⊤, top_mem_distLatFinsetClosure F⟩
  bot := ⟨⊥, bot_mem_distLatFinsetClosure F⟩
  le_top _ := le_top
  bot_le _ := bot_le

/-- Hyperfinite bounded distributive lattice `L⁺ ⊆ StarElem L` approximating `L`
(Exercise 19.7(4), Goldblatt p. 273). -/
def HyperfiniteDistribLattice (L : Type*) [DistribLattice L] [BoundedOrder L] : Type _ :=
  ↥(internalApproxSet (fun F : Finset L ↦ (distLatFinsetClosure F : Set L)))

namespace HyperfiniteDistribLattice

instance {L : Type*} [DistribLattice L] [BoundedOrder L] :
    DistribLattice (HyperfiniteDistribLattice L) where
  sup a b := ⟨a.1 ⊔ b.1, by
    rcases a with ⟨fa, ha⟩; rcases b with ⟨fb, hb⟩
    induction fa using Germ.inductionOn with | _ ga =>
    induction fb using Germ.inductionOn with | _ gb =>
    rw [coe_mem_internalApproxSet] at ha hb
    exact coe_mem_internalApproxSet.mpr ((ha.and hb).mono fun F ⟨h₁, h₂⟩ ↦
      Finset.mem_coe.mpr (sup_mem_distLatFinsetClosure F (Finset.mem_coe.mp h₁)
        (Finset.mem_coe.mp h₂)))⟩
  inf a b := ⟨a.1 ⊓ b.1, by
    rcases a with ⟨fa, ha⟩; rcases b with ⟨fb, hb⟩
    induction fa using Germ.inductionOn with | _ ga =>
    induction fb using Germ.inductionOn with | _ gb =>
    rw [coe_mem_internalApproxSet] at ha hb
    exact coe_mem_internalApproxSet.mpr ((ha.and hb).mono fun F ⟨h₁, h₂⟩ ↦
      Finset.mem_coe.mpr (inf_mem_distLatFinsetClosure F (Finset.mem_coe.mp h₁)
        (Finset.mem_coe.mp h₂)))⟩
  le a b := a.1 ≤ b.1
  le_refl _ := le_rfl
  le_trans _ _ _ := le_trans
  le_antisymm _ _ h₁ h₂ := Subtype.ext (le_antisymm h₁ h₂)
  le_sup_left _ _ := le_sup_left
  le_sup_right _ _ := le_sup_right
  sup_le _ _ _ := sup_le
  inf_le_left _ _ := inf_le_left
  inf_le_right _ _ := inf_le_right
  le_inf _ _ _ := le_inf
  le_sup_inf a b c := le_sup_inf (x := a.1) (y := b.1) (z := c.1)

instance {L : Type*} [DistribLattice L] [BoundedOrder L] :
    BoundedOrder (HyperfiniteDistribLattice L) where
  top := ⟨((fun _ : Finset L ↦ (⊤ : L)) : StarElem L),
    coe_mem_internalApproxSet.mpr (Filter.Eventually.of_forall fun F ↦
      Finset.mem_coe.mpr (top_mem_distLatFinsetClosure F))⟩
  bot := ⟨((fun _ : Finset L ↦ (⊥ : L)) : StarElem L),
    coe_mem_internalApproxSet.mpr (Filter.Eventually.of_forall fun F ↦
      Finset.mem_coe.mpr (bot_mem_distLatFinsetClosure F))⟩
  le_top a := le_top (a := a.1)
  bot_le a := bot_le (a := a.1)

/-- Canonical bounded-lattice embedding `L ↪ HyperfiniteDistribLattice L` (`x ↦ stdElem x`). -/
def ofStd (L : Type*) [DistribLattice L] [BoundedOrder L] :
    BoundedLatticeHom L (HyperfiniteDistribLattice L) where
  toFun x := ⟨stdElem x, by
    rw [stdElem_mem_internalApproxSet]
    exact (eventually_mem_fineUltrafilter x).mono fun F hxF ↦
      Finset.mem_coe.mpr (subset_distLatFinsetClosure F hxF)⟩
  map_sup' _ _ := rfl
  map_inf' _ _ := rfl
  map_top' := Subtype.ext rfl
  map_bot' := Subtype.ext rfl

/-- Transfer of join-irreducible separation to `HyperfiniteDistribLattice L`
(Exercise 19.7(4), Goldblatt p. 273): if `¬ (x ≤ y)` in `L⁺`, there is a join-irreducible `a : L⁺`
with `a ≤ x` and `¬ (a ≤ y)`! -/
theorem exists_joinIrreducible_of_not_le {L : Type*} [DistribLattice L] [BoundedOrder L]
    {x y : HyperfiniteDistribLattice L} (hnot : ¬ x ≤ y) :
    ∃ a : HyperfiniteDistribLattice L, IsJoinIrreducibleElem a ∧ a ≤ x ∧ ¬ a ≤ y := by
  rcases x with ⟨vx, hx⟩; rcases y with ⟨vy, hy⟩
  induction vx using Germ.inductionOn with | _ fx =>
  induction vy using Germ.inductionOn with | _ fy =>
  rw [coe_mem_internalApproxSet] at hx hy
  have hnot_le : ∀ᶠ F in (fineUltrafilter L : Filter (Finset L)), ¬ fx F ≤ fy F := by
    by_contra hcon
    have hle : ∀ᶠ F in (fineUltrafilter L : Filter (Finset L)), fx F ≤ fy F := by
      have := Ultrafilter.eventually_not.mpr hcon
      exact this.mono fun F h ↦ not_not.mp h
    exact hnot (Germ.coe_le.mpr hle)
  have hex_a : ∀ F : Finset L,
      (fx F ∈ distLatFinsetClosure F ∧ fy F ∈ distLatFinsetClosure F ∧ ¬ fx F ≤ fy F) →
      ∃ aF : ↥(distLatFinsetClosure F),
        IsJoinIrreducibleElem aF ∧ (aF : L) ≤ fx F ∧ ¬ (aF : L) ≤ fy F := by
    rintro F ⟨hxF, hyF, hnotF⟩
    exact exists_joinIrreducibleElem_of_not_le_finite
      (x := (⟨fx F, hxF⟩ : ↥(distLatFinsetClosure F)))
      (y := (⟨fy F, hyF⟩ : ↥(distLatFinsetClosure F))) hnotF
  let g : Finset L → L := fun F ↦
    if h : fx F ∈ distLatFinsetClosure F ∧ fy F ∈ distLatFinsetClosure F ∧ ¬ fx F ≤ fy F
    then ((hex_a F h).choose : L) else ⊥
  have hg_mem : (g : StarElem L) ∈
      internalApproxSet (fun F : Finset L ↦ (distLatFinsetClosure F : Set L)) := by
    rw [coe_mem_internalApproxSet]
    refine Filter.Eventually.of_forall fun F ↦ Finset.mem_coe.mpr ?_
    by_cases h : fx F ∈ distLatFinsetClosure F ∧ fy F ∈ distLatFinsetClosure F ∧ ¬ fx F ≤ fy F
    · rw [show g F = ((hex_a F h).choose : L) from dite_eq_left_of_eq_true (eq_true h)]
      exact (hex_a F h).choose.2
    · rw [show g F = ⊥ from dite_eq_right_of_eq_false (eq_false h)]
      exact bot_mem_distLatFinsetClosure F
  let a : HyperfiniteDistribLattice L := ⟨(g : StarElem L), hg_mem⟩
  have hgood : ∀ᶠ F in (fineUltrafilter L : Filter (Finset L)),
      fx F ∈ distLatFinsetClosure F ∧ fy F ∈ distLatFinsetClosure F ∧ ¬ fx F ≤ fy F :=
    ((hx.and hy).and hnot_le).mono fun F ⟨⟨h₁, h₂⟩, h₃⟩ ↦
      ⟨Finset.mem_coe.mp h₁, Finset.mem_coe.mp h₂, h₃⟩
  refine ⟨a, ⟨?_, ?_⟩, ?_, ?_⟩
  · intro habot
    have habot' : (g : StarElem L) = ((fun _ : Finset L ↦ (⊥ : L)) : StarElem L) :=
      congrArg Subtype.val habot
    have hev_bot : ∀ᶠ F in (fineUltrafilter L : Filter (Finset L)), g F = ⊥ :=
      Germ.coe_eq.mp habot'
    obtain ⟨F, hF, hgF⟩ := (hgood.and hev_bot).exists
    rw [show g F = ((hex_a F hF).choose : L) from dite_eq_left_of_eq_true (eq_true hF)] at hgF
    exact (hex_a F hF).choose_spec.1.1 (Subtype.ext hgF)
  · rintro ⟨vu, hu⟩ ⟨vv, hv⟩ huv
    induction vu using Germ.inductionOn with | _ fu =>
    induction vv using Germ.inductionOn with | _ fv =>
    rw [coe_mem_internalApproxSet] at hu hv
    have hev_eq : ∀ᶠ F in (fineUltrafilter L : Filter (Finset L)), g F = fu F ⊔ fv F :=
      Germ.coe_eq.mp (congrArg Subtype.val huv)
    have hor : ∀ᶠ F in (fineUltrafilter L : Filter (Finset L)), g F = fu F ∨ g F = fv F := by
      refine (((hgood.and hu).and hv).and hev_eq).mono ?_
      rintro F ⟨⟨⟨hF, huF⟩, hvF⟩, heqF⟩
      have hgF : g F = ((hex_a F hF).choose : L) := dite_eq_left_of_eq_true (eq_true hF)
      rw [hgF] at heqF ⊢
      have hj := (hex_a F hF).choose_spec.1.2
        ⟨fu F, Finset.mem_coe.mp huF⟩ ⟨fv F, Finset.mem_coe.mp hvF⟩ (Subtype.ext heqF)
      exact hj.imp (congrArg Subtype.val) (congrArg Subtype.val)
    rw [Ultrafilter.eventually_or] at hor
    exact hor.imp (fun h ↦ Subtype.ext (Germ.coe_eq.mpr h))
      (fun h ↦ Subtype.ext (Germ.coe_eq.mpr h))
  · change (g : StarElem L) ≤ (fx : StarElem L)
    refine Germ.coe_le.mpr (hgood.mono fun F hF ↦ ?_)
    rw [show g F = ((hex_a F hF).choose : L) from dite_eq_left_of_eq_true (eq_true hF)]
    exact (hex_a F hF).choose_spec.2.1
  · intro hay
    have hle : ∀ᶠ F in (fineUltrafilter L : Filter (Finset L)), g F ≤ fy F :=
      Germ.coe_le.mp hay
    obtain ⟨F, hF, hgF_le⟩ := (hgood.and hle).exists
    rw [show g F = ((hex_a F hF).choose : L) from dite_eq_left_of_eq_true (eq_true hF)] at hgF_le
    exact (hex_a F hF).choose_spec.2.2 hgF_le

end HyperfiniteDistribLattice

/-- **Exercise 19.7(4)(a) (Bounded Distributive Lattice Set Representation)**
(Goldblatt §19.7, p. 272):
Every bounded distributive lattice `L` embeds via an injective `BoundedLatticeHom` into the
power-set lattice `Set {a : HyperfiniteDistribLattice L // IsJoinIrreducibleElem a}`! -/
def boundedDistribLatticeSetRep (L : Type*) [DistribLattice L] [BoundedOrder L] :
    BoundedLatticeHom L (Set {a : HyperfiniteDistribLattice L // IsJoinIrreducibleElem a}) where
  toFun x := {a | a.1 ≤ HyperfiniteDistribLattice.ofStd L x}
  map_sup' x y := by
    ext ⟨a, ha⟩
    change a ≤ HyperfiniteDistribLattice.ofStd L (x ⊔ y) ↔
      a ≤ HyperfiniteDistribLattice.ofStd L x ∨ a ≤ HyperfiniteDistribLattice.ofStd L y
    rw [SupHomClass.map_sup]
    exact ⟨(isJoinIrreducibleElem_iff_le_sup.mp ha).2 _ _,
      fun h ↦ h.elim (fun h₁ ↦ h₁.trans le_sup_left) (fun h₂ ↦ h₂.trans le_sup_right)⟩
  map_inf' x y := by
    ext ⟨a, _⟩
    change a ≤ HyperfiniteDistribLattice.ofStd L (x ⊓ y) ↔
      a ≤ HyperfiniteDistribLattice.ofStd L x ∧ a ≤ HyperfiniteDistribLattice.ofStd L y
    rw [InfHomClass.map_inf]
    exact le_inf_iff
  map_top' := by
    ext ⟨a, _⟩
    change a ≤ HyperfiniteDistribLattice.ofStd L ⊤ ↔ True
    rw [TopHomClass.map_top]
    simp
  map_bot' := by
    ext ⟨a, ha⟩
    change a ≤ HyperfiniteDistribLattice.ofStd L ⊥ ↔ False
    rw [BotHomClass.map_bot]
    simp [le_bot_iff, ha.1]

theorem boundedDistribLatticeSetRep_le_iff {L : Type*} [DistribLattice L] [BoundedOrder L]
    {x y : L} :
    boundedDistribLatticeSetRep L x ≤ boundedDistribLatticeSetRep L y ↔ x ≤ y := by
  constructor
  · intro h
    by_contra hnot
    have hnot_std : ¬ HyperfiniteDistribLattice.ofStd L x ≤ HyperfiniteDistribLattice.ofStd L y :=
      fun hle ↦ hnot (Germ.const_le_iff.mp (hle : stdElem x ≤ stdElem y))
    obtain ⟨a, ha, hax, hnot_ay⟩ :=
      HyperfiniteDistribLattice.exists_joinIrreducible_of_not_le hnot_std
    exact hnot_ay (h (a := ⟨a, ha⟩) hax)
  · exact fun h _ hax ↦ hax.trans (OrderHomClass.mono (HyperfiniteDistribLattice.ofStd L) h)

theorem boundedDistribLatticeSetRep_injective (L : Type*) [DistribLattice L] [BoundedOrder L] :
    Function.Injective (boundedDistribLatticeSetRep L) :=
  fun _ _ h ↦ le_antisymm (boundedDistribLatticeSetRep_le_iff.mp h.le)
    (boundedDistribLatticeSetRep_le_iff.mp h.ge)

/-- **Exercise 19.7(4)(a) (General Distributive Lattice Set Representation)**
(Goldblatt §19.7, p. 272):
**Every** distributive lattice `L` (even without `⊤` or `⊥`!) is isomorphic to a lattice of sets:
there exists a type `X` and an injective `LatticeHom L (Set X)` reflecting `≤`! -/
theorem exercise_19_7_4_a_distribLattice_set_representation.{u} (L : Type u) [DistribLattice L] :
    ∃ (X : Type u) (f : LatticeHom L (Set X)),
      Function.Injective f ∧ ∀ x y : L, f x ⊆ f y ↔ x ≤ y := by
  let LB := WithTop (WithBot L)
  let emb : LatticeHom L LB :=
    { toFun := fun x ↦ ((x : WithBot L) : LB)
      map_sup' := fun x y ↦ rfl
      map_inf' := fun x y ↦ rfl }
  refine ⟨{a : HyperfiniteDistribLattice LB // IsJoinIrreducibleElem a},
    (boundedDistribLatticeSetRep LB).toLatticeHom.comp emb, ?_, ?_⟩
  · intro x y h
    have h' : emb x = emb y := boundedDistribLatticeSetRep_injective LB h
    exact WithBot.coe_inj.mp (WithTop.coe_inj.mp h')
  · intro x y
    change boundedDistribLatticeSetRep LB (emb x) ≤ boundedDistribLatticeSetRep LB (emb y) ↔ x ≤ y
    rw [boundedDistribLatticeSetRep_le_iff]
    exact WithTop.coe_le_coe.trans WithBot.coe_le_coe

/-- Goldblatt §19.7, Exercise 19.7(4)(b) (p. 272): A **lattice filter** of a bounded distributive
lattice `L`, together with the **prime filter** predicate (`⊥ ∉ P` and `x ⊔ y ∈ P → x ∈ P ∨ y ∈ P`). -/
structure LatticeFilter (L : Type*) [DistribLattice L] [BoundedOrder L] where
  /-- Carrier set of the filter. -/
  carrier : Set L
  /-- `⊤ ∈ F`. -/
  top_mem' : ⊤ ∈ carrier
  /-- Meet-closed (`x, y ∈ F → x ⊓ y ∈ F`). -/
  inf_mem' : ∀ {x y : L}, x ∈ carrier → y ∈ carrier → x ⊓ y ∈ carrier
  /-- Upward-closed (`x ∈ F → x ≤ y → y ∈ F`). -/
  mem_of_le' : ∀ {x y : L}, x ∈ carrier → x ≤ y → y ∈ carrier

namespace LatticeFilter

instance {L : Type*} [DistribLattice L] [BoundedOrder L] : SetLike (LatticeFilter L) L where
  coe F := F.carrier
  coe_injective F₁ F₂ h := by cases F₁; cases F₂; congr

/-- Properness (`⊥ ∉ F`). -/
def IsProper {L : Type*} [DistribLattice L] [BoundedOrder L] (F : LatticeFilter L) : Prop :=
  (⊥ : L) ∉ F

/-- **Prime filter** (Exercise 19.7(4)(b), Goldblatt p. 272): a proper filter `P` satisfying
`x ⊔ y ∈ P → x ∈ P ∨ y ∈ P`. -/
def IsPrime {L : Type*} [DistribLattice L] [BoundedOrder L] (P : LatticeFilter L) : Prop :=
  P.IsProper ∧ ∀ x y : L, x ⊔ y ∈ P → x ∈ P ∨ y ∈ P

theorem finset_inf_mem {L ι : Type*} [DistribLattice L] [BoundedOrder L] (F : LatticeFilter L)
    (s : Finset ι) {f : ι → L} (hs : ∀ i ∈ s, f i ∈ F) :
    s.inf f ∈ F := by
  classical
  induction s using Finset.induction with
  | empty =>
    rw [Finset.inf_empty]
    exact F.top_mem'
  | insert a s _ ih =>
    rw [Finset.inf_insert]
    exact F.inf_mem' (hs a (Finset.mem_insert_self a s))
      (ih fun i hi ↦ hs i (Finset.mem_insert_of_mem hi))

end LatticeFilter

/-- **Exercise 19.7(4)(b) (Birkhoff Prime Filter Theorem via Hyperfinite Approximation)**
(Goldblatt §19.7, pp. 272–273):
Let `F₀ : LatticeFilter L` be a filter of a bounded distributive lattice `L` and `y₀ ∉ F₀` (in
particular, for `y₀ = ⊥`, any proper filter `F₀`!). Then there exists a **prime filter**
`P : LatticeFilter L` extending `F₀` (`(F₀ : Set L) ⊆ P`) with `y₀ ∉ P`! -/
theorem exercise_19_7_4_b_exists_primeFilter_extending {L : Type*}
    [DistribLattice L] [BoundedOrder L]
    (F₀ : LatticeFilter L) {y₀ : L} (hy₀ : y₀ ∉ F₀) :
    ∃ P : LatticeFilter L, P.IsPrime ∧ (F₀ : Set L) ⊆ P ∧ y₀ ∉ P := by
  classical
  let bAt : Finset L → L := fun S ↦ ((distLatFinsetClosure S).filter (· ∈ F₀)).inf id
  have hbAt_mem_closure : ∀ S : Finset L, bAt S ∈ distLatFinsetClosure S := by
    intro S
    have hind : ∀ T : Finset L, T ⊆ distLatFinsetClosure S → T.inf id ∈ distLatFinsetClosure S := by
      intro T hT
      induction T using Finset.induction with
      | empty =>
        rw [Finset.inf_empty]
        exact top_mem_distLatFinsetClosure S
      | insert z T _ ih =>
        rw [Finset.inf_insert]
        exact inf_mem_distLatFinsetClosure S (hT (Finset.mem_insert_self z T))
          (ih fun w hw ↦ hT (Finset.mem_insert_of_mem hw))
    exact hind _ (Finset.filter_subset _ _)
  have hbAt_mem_F₀ : ∀ S : Finset L, bAt S ∈ F₀ :=
    fun S ↦ F₀.finset_inf_mem _ fun _ hx ↦ (Finset.mem_filter.mp hx).2
  have hbAt_not_le_y₀ : ∀ S : Finset L, ¬ bAt S ≤ y₀ :=
    fun S hle ↦ hy₀ (F₀.mem_of_le' (hbAt_mem_F₀ S) hle)
  let b : HyperfiniteDistribLattice L :=
    ⟨((bAt : Finset L → L) : StarElem L),
     coe_mem_internalApproxSet.mpr (Filter.Eventually.of_forall fun S ↦
       Finset.mem_coe.mpr (hbAt_mem_closure S))⟩
  have hnot_le_std : ¬ b ≤ HyperfiniteDistribLattice.ofStd L y₀ := by
    intro hle
    have hle' : ((bAt : Finset L → L) : StarElem L) ≤
        (((fun _ : Finset L ↦ y₀) : Finset L → L) : StarElem L) := hle
    have hev : ∀ᶠ S in (fineUltrafilter L : Filter (Finset L)), bAt S ≤ y₀ :=
      Germ.coe_le.mp hle'
    obtain ⟨S, hS⟩ := hev.exists
    exact hbAt_not_le_y₀ S hS
  obtain ⟨a, ha_ji, hab, hnot_ay₀⟩ :=
    HyperfiniteDistribLattice.exists_joinIrreducible_of_not_le hnot_le_std
  let P : LatticeFilter L :=
    { carrier := {x : L | a ≤ HyperfiniteDistribLattice.ofStd L x}
      top_mem' := by
        change a ≤ HyperfiniteDistribLattice.ofStd L ⊤
        rw [TopHomClass.map_top]; exact le_top
      inf_mem' := fun {x y} hx hy ↦ by
        change a ≤ HyperfiniteDistribLattice.ofStd L (x ⊓ y)
        rw [InfHomClass.map_inf]; exact le_inf hx hy
      mem_of_le' := fun hx hle ↦
        hx.trans (OrderHomClass.mono (HyperfiniteDistribLattice.ofStd L) hle) }
  refine ⟨P, ⟨?_, ?_⟩, ?_, hnot_ay₀⟩
  · intro hbot
    change a ≤ HyperfiniteDistribLattice.ofStd L ⊥ at hbot
    rw [BotHomClass.map_bot] at hbot
    exact ha_ji.1 (le_bot_iff.mp hbot)
  · intro x y hxy
    change a ≤ HyperfiniteDistribLattice.ofStd L (x ⊔ y) at hxy
    rw [SupHomClass.map_sup] at hxy
    exact (isJoinIrreducibleElem_iff_le_sup.mp ha_ji).2
      (HyperfiniteDistribLattice.ofStd L x) (HyperfiniteDistribLattice.ofStd L y) hxy
  · intro x hxF₀
    change a ≤ HyperfiniteDistribLattice.ofStd L x
    refine hab.trans ?_
    change ((bAt : Finset L → L) : StarElem L) ≤ stdElem x
    refine Germ.coe_le.mpr ((eventually_mem_fineUltrafilter x).mono fun S hxS ↦ ?_)
    exact Finset.inf_le (Finset.mem_filter.mpr ⟨subset_distLatFinsetClosure S hxS, hxF₀⟩)

/-- Direct corollary of Exercise 19.7(4)(b): every proper `LatticeFilter L` (`⊥ ∉ F₀`) extends to a
prime filter `P : LatticeFilter L`! -/
theorem exists_primeFilter_of_isProper {L : Type*} [DistribLattice L] [BoundedOrder L]
    (F₀ : LatticeFilter L) (hproper : F₀.IsProper) :
    ∃ P : LatticeFilter L, P.IsPrime ∧ (F₀ : Set L) ⊆ P := by
  obtain ⟨P, hP, hsub, _⟩ := exercise_19_7_4_b_exists_primeFilter_extending F₀ hproper
  exact ⟨P, hP, hsub⟩

end BooleanFiltersAndStone

/-! ## §19.8–19.9 Hyperfinite-Dimensional Vector Spaces & Exercises 19.8.1, 19.9(1)–(3)
(pp. 273–275) -/

section HyperfiniteVectorSpaces

/-- Scalar-tower compatibility between standard scalars `R` and ultrapower scalars `Germ l R`
acting on `Germ l E` (Goldblatt §19.8, p. 273). -/
instance instIsScalarTowerGerm {J R E : Type*} {l : Filter J}
    [SMul R R] [SMul R E] [IsScalarTower R R E] :
    IsScalarTower R (Germ l R) (Germ l E) where
  smul_assoc c x y :=
    Germ.inductionOn₂ x y fun f g ↦
      congrArg Germ.ofFun (funext fun j ↦ smul_assoc c (f j) (g j))

/-- Canonical `R`-algebra structure on any `Germ l R` (`[CommSemiring R]`), reusing the existing
`Module R (Germ l R)` scalar multiplication so there is zero `SMul` diamond
(Goldblatt §19.8, p. 273). -/
instance instAlgebraGerm {J R : Type*} {l : Filter J} [CommSemiring R] :
    Algebra R (Germ l R) where
  algebraMap := (Germ.coeRingHom l).comp (RingHom.pi fun _ ↦ RingHom.id R)
  commutes' _ _ := mul_comm _ _
  smul_def' _ x := Germ.inductionOn x fun _ ↦ rfl

@[simp]
theorem algebraMap_germ_apply {J R : Type*} {l : Filter J} [CommSemiring R] (c : R) :
    algebraMap R (Germ l R) c = (c : Germ l R) := rfl

/-- Action of a constant ultrapower scalar `(c : Germ l R)` on `x : Germ l E` agrees with standard
scalar multiplication `c • x` (Goldblatt §19.8, p. 273). -/
@[simp]
theorem const_smul_germ {J R E : Type*} {l : Filter J}
    [SMul R E] (c : R) (x : Germ l E) :
    (c : Germ l R) • x = c • x :=
  Germ.inductionOn x fun _ ↦ rfl

/-- Canonical `ℝ`-algebra (and hence `Module ℝ ℝ*`) structure on `ℝ*` (`Hyperreal`) induced by
`Hyperreal.coeRingHom : ℝ →+* ℝ*` (Goldblatt §19.8, p. 273). -/
instance instAlgebraRealHyperreal : Algebra ℝ ℝ* :=
  RingHom.toAlgebra Hyperreal.coeRingHom.toRingHom

@[simp]
theorem algebraMap_hyperreal_apply (c : ℝ) : algebraMap ℝ ℝ* c = (c : ℝ*) := rfl

@[simp]
theorem real_smul_hyperreal (c : ℝ) (x : ℝ*) : c • x = (c : ℝ*) * x := rfl

/-- Standard `R`-linear embedding `v ↦ (v : Germ l E)` of a module `E` into its filter power
`Germ l E` (Goldblatt §19.8, p. 273). -/
def germConstLinearMap {J : Type*} (l : Filter J) (R E : Type*)
    [Semiring R] [AddCommMonoid E] [Module R E] : E →ₗ[R] Germ l E where
  toFun v := (v : Germ l E)
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- `germConstLinearMap l R E` is injective whenever `l` is nontrivial (`[NeBot l]`). -/
theorem germConstLinearMap_injective {J : Type*} (l : Filter J) [NeBot l] (R E : Type*)
    [Semiring R] [AddCommMonoid E] [Module R E] :
    Function.Injective (germConstLinearMap l R E) :=
  fun _ _ h ↦ Germ.const_inj.mp h

/-- Hyperreal scalar field `*ℝ_E = Germ (fineUltrafilter E) ℝ` associated with the fine-ultrafilter
enlargement over `Finset E` (Goldblatt §19.8, p. 273). -/
abbrev StarReal (E : Type*) : Type _ :=
  Germ (fineUltrafilter E : Filter (Finset E)) ℝ

/-- Goldblatt §19.8 (p. 274): **Hyperfinite vector summation** `∑_{i < n_j} v_{j,i}` of an internal
hyperfinite sequence `(n : J → ℕ, v : ∀ j, Fin (n j) → E)` in `Germ l E`. -/
def hyperVecSum {J E : Type*} (l : Filter J) [AddCommMonoid E]
    (n : J → ℕ) (v : ∀ j, Fin (n j) → E) : Germ l E :=
  Germ.ofFun (fun j ↦ ∑ i : Fin (n j), v j i)

/-- Goldblatt §19.8 (p. 274): **Hyperfinite linear combination** `∑_{i < n_j} r_{j,i} • v_{j,i}` in
`Germ l E` with internal scalar sequence `r : ∀ j, Fin (n j) → R`. -/
def hyperLinComb {J R E : Type*} (l : Filter J) [Semiring R] [AddCommMonoid E] [Module R E]
    (n : J → ℕ) (r : ∀ j, Fin (n j) → R) (v : ∀ j, Fin (n j) → E) : Germ l E :=
  hyperVecSum l n (fun j i ↦ r j i • v j i)

/-- **Exercise 19.8.1 (Part 1)** (Goldblatt §19.8, p. 274): Transfer of vector addition and scalar
multiplication for hyperfinite vector sums `hyperVecSum` and hyperfinite linear combinations
`hyperLinComb`. -/
@[simp]
theorem hyperVecSum_zero {J E : Type*} (l : Filter J) [AddCommMonoid E] (n : J → ℕ) :
    hyperVecSum l n (fun _ _ ↦ (0 : E)) = 0 := by
  change (fun j ↦ ∑ _i : Fin (n j), (0 : E)) = ((0 : J → E) : Germ l E)
  exact congrArg Germ.ofFun (funext fun j ↦ Finset.sum_const_zero)

theorem hyperVecSum_add {J E : Type*} (l : Filter J) [AddCommMonoid E] (n : J → ℕ)
    (u v : ∀ j, Fin (n j) → E) :
    hyperVecSum l n u + hyperVecSum l n v = hyperVecSum l n (fun j i ↦ u j i + v j i) := by
  exact congrArg Germ.ofFun (funext fun j ↦ (Finset.sum_add_distrib).symm)

theorem hyperVecSum_smul {J R E : Type*} (l : Filter J)
    [Semiring R] [AddCommMonoid E] [Module R E]
    (n : J → ℕ) (c : J → R) (v : ∀ j, Fin (n j) → E) :
    (c : Germ l R) • hyperVecSum l n v = hyperVecSum l n (fun j i ↦ c j • v j i) := by
  exact congrArg Germ.ofFun (funext fun j ↦ Finset.smul_sum)

theorem hyperLinComb_add_scalars {J R E : Type*} (l : Filter J)
    [Semiring R] [AddCommMonoid E] [Module R E]
    (n : J → ℕ) (r s : ∀ j, Fin (n j) → R) (v : ∀ j, Fin (n j) → E) :
    hyperLinComb l n r v + hyperLinComb l n s v =
      hyperLinComb l n (fun j i ↦ r j i + s j i) v := by
  rw [hyperLinComb, hyperLinComb, hyperVecSum_add]
  exact congrArg Germ.ofFun (funext fun j ↦ Finset.sum_congr rfl fun i _ ↦ (add_smul _ _ _).symm)

theorem hyperLinComb_smul {J R E : Type*} (l : Filter J)
    [Semiring R] [AddCommMonoid E] [Module R E]
    (n : J → ℕ) (c : J → R) (r : ∀ j, Fin (n j) → R) (v : ∀ j, Fin (n j) → E) :
    (c : Germ l R) • hyperLinComb l n r v =
      hyperLinComb l n (fun j i ↦ c j * r j i) v := by
  rw [hyperLinComb, hyperVecSum_smul]
  exact congrArg Germ.ofFun (funext fun j ↦ Finset.sum_congr rfl fun i _ ↦ (mul_smul _ _ _).symm)

/-- Goldblatt §19.8 (p. 274): **Internal `*R`-subspace** `[j ↦ W j]` of `Germ l E` determined by an
indexed family of submodules `W : J → Submodule R E`. -/
def internalSubmodule {J R E : Type*} (l : Filter J)
    [Semiring R] [AddCommMonoid E] [Module R E] (W : J → Submodule R E) :
    Submodule (Germ l R) (Germ l E) where
  carrier := {x : Germ l E |
    Germ.LiftRel (· ∈ ·) x ((fun j ↦ (W j : Set E)) : Germ l (Set E))}
  zero_mem' := by
    change Germ.LiftRel (· ∈ ·) (0 : Germ l E) ((fun j ↦ (W j : Set E)) : Germ l (Set E))
    rw [← Germ.coe_zero]
    exact Germ.liftRel_coe.mpr (Eventually.of_forall fun j ↦ (W j).zero_mem)
  add_mem' {x y} hx hy := by
    induction x using Germ.inductionOn with | _ f =>
    induction y using Germ.inductionOn with | _ g =>
    change Germ.LiftRel (· ∈ ·) ((f : Germ l E) + (g : Germ l E))
      ((fun j ↦ (W j : Set E)) : Germ l (Set E))
    rw [← Germ.coe_add]
    exact Germ.liftRel_coe.mpr ((Germ.liftRel_coe.mp hx).mp <|
      (Germ.liftRel_coe.mp hy).mono fun j hg hf ↦ (W j).add_mem hf hg)
  smul_mem' c {x} hx := by
    induction c using Germ.inductionOn with | _ r =>
    induction x using Germ.inductionOn with | _ f =>
    change Germ.LiftRel (· ∈ ·) ((r : Germ l R) • (f : Germ l E))
      ((fun j ↦ (W j : Set E)) : Germ l (Set E))
    rw [← Germ.coe_smul']
    exact Germ.liftRel_coe.mpr ((Germ.liftRel_coe.mp hx).mono fun j hf ↦ (W j).smul_mem (r j) hf)

@[simp]
theorem coe_mem_internalSubmodule {J R E : Type*} {l : Filter J}
    [Semiring R] [AddCommMonoid E] [Module R E]
    {f : J → E} {W : J → Submodule R E} :
    (f : Germ l E) ∈ internalSubmodule l W ↔ ∀ᶠ j in l, f j ∈ W j :=
  Germ.liftRel_coe

/-- **Exercise 19.8.1 (Part 2)** (Goldblatt §19.8, p. 274): Every internal `*R`-subspace
`internalSubmodule l W` is closed under internal hyperfinite linear combinations `hyperLinComb`. -/
theorem hyperLinComb_mem_internalSubmodule {J R E : Type*} {l : Filter J}
    [Semiring R] [AddCommMonoid E] [Module R E]
    {W : J → Submodule R E} {n : J → ℕ}
    (r : ∀ j, Fin (n j) → R) {v : ∀ j, Fin (n j) → E}
    (hv : ∀ᶠ j in l, ∀ i : Fin (n j), v j i ∈ W j) :
    hyperLinComb l n r v ∈ internalSubmodule l W := by
  rw [hyperLinComb, hyperVecSum, coe_mem_internalSubmodule]
  exact hv.mono fun j hj ↦ (W j).sum_mem fun i _ ↦ (W j).smul_mem (r j i) (hj i)

/-- **Exercise 19.8.1 (Part 3 — Hyperfinite Basis Representation & Uniqueness)** (Goldblatt §19.8,
p. 274): If `W : J → Submodule ℝ E` is an internal family of finite-dimensional subspaces
(`W ∈ *Fin(V)`), with internal hyperfinite dimension `d j = Module.finrank ℝ (W j)`, then the
internal basis sequence `b_j : Fin (d j) → E` spans `internalSubmodule l W` with `l`-almost
everywhere unique hyperreal coordinates! -/
theorem exists_unique_hyperLinComb_of_finiteDimensional {J E : Type*} (l : Filter J)
    [AddCommGroup E] [Module ℝ E]
    (W : J → Submodule ℝ E) [∀ j, Module.Finite ℝ (W j)] :
    let d : J → ℕ := fun j ↦ Module.finrank ℝ (W j)
    let b : ∀ j, Fin (d j) → E := fun j i ↦ (Module.finBasis ℝ (W j) i : E)
    (∀ᶠ j in l, ∀ i : Fin (d j), b j i ∈ W j) ∧
      (∀ x ∈ internalSubmodule l W, ∃ r : ∀ j, Fin (d j) → ℝ, x = hyperLinComb l d r b) ∧
      (∀ r s : ∀ j, Fin (d j) → ℝ,
        hyperLinComb l d r b = hyperLinComb l d s b ↔ ∀ᶠ j in l, r j = s j) := by
  intro d b
  refine ⟨Eventually.of_forall fun j i ↦ (Module.finBasis ℝ (W j) i).2, ?_, ?_⟩
  · intro x hx
    induction x using Germ.inductionOn with | _ f =>
    rw [coe_mem_internalSubmodule] at hx
    let r : ∀ j, Fin (d j) → ℝ := fun j ↦
      if hf : f j ∈ W j then (Module.finBasis ℝ (W j)).equivFun ⟨f j, hf⟩ else 0
    refine ⟨r, Germ.coe_eq.mpr (hx.mono fun j hfj ↦ ?_)⟩
    change f j = ∑ i : Fin (d j), r j i • (Module.finBasis ℝ (W j) i : E)
    have hrj : r j = (Module.finBasis ℝ (W j)).equivFun ⟨f j, hfj⟩ :=
      dite_eq_left_of_eq_true (eq_true hfj)
    rw [hrj]
    have hsum := congrArg Subtype.val ((Module.finBasis ℝ (W j)).sum_equivFun ⟨f j, hfj⟩)
    simpa only [AddSubmonoidClass.coe_finsetSum, SetLike.val_smul] using hsum.symm
  · intro r s
    rw [hyperLinComb, hyperLinComb, hyperVecSum, hyperVecSum, Germ.coe_eq]
    refine Filter.eventually_congr (Eventually.of_forall fun j ↦ ?_)
    constructor
    · intro hsum
      have hsub : (Module.finBasis ℝ (W j)).equivFun.symm (r j) =
          (Module.finBasis ℝ (W j)).equivFun.symm (s j) := by
        apply Subtype.ext
        simp only [Module.Basis.equivFun_symm_apply, AddSubmonoidClass.coe_finsetSum,
          SetLike.val_smul]
        exact hsum
      exact (Module.finBasis ℝ (W j)).equivFun.symm.injective hsub
    · intro hrs
      dsimp only []
      rw [hrs]

/-- Internal range `{x_1, ..., x_{n_j}} ⊆ Germ l E` of an internal hyperfinite sequence
`(n : J → ℕ, v : ∀ j, Fin (n j) → E)` (Goldblatt §19.9, Exercise 19.9(1), p. 275). -/
def hyperSeqRange {J E : Type*} (l : Filter J) (n : J → ℕ) (v : ∀ j, Fin (n j) → E) :
    Set (Germ l E) :=
  {x : Germ l E | Germ.LiftRel (· ∈ ·) x ((fun j ↦ Set.range (v j)) : Germ l (Set E))}

/-- **Exercise 19.9(1)** (Goldblatt §19.9, p. 275): Let `(n, v)` be an internal hyperfinite
sequence in `*E = Germ U E` (for an ultrafilter `U : Ultrafilter J`). Define the internal family of
finite-dimensional subspaces `W j := Submodule.span ℝ (Set.range (v j))`. Then:
1. Each `W j` is finite-dimensional (`Module.Finite ℝ (W j)`), so `W⁺ = internalSubmodule U W`
   belongs to `*Fin(E)`.
2. **(i)** `W⁺` is the **smallest** internal `*ℝ`-subspace of `Germ U E` containing the terms
   `hyperSeqRange U n v` of the hyperfinite sequence.
3. **(ii)** The elements of `W⁺` are **precisely** the internal hyperfinite linear combinations
   `hyperLinComb U n r v`! -/
theorem exercise_19_9_1_hyperfinite_span {J E : Type*} (U : Ultrafilter J)
    [AddCommGroup E] [Module ℝ E] (n : J → ℕ) (v : ∀ j, Fin (n j) → E) :
    let W : J → Submodule ℝ E := fun j ↦ Submodule.span ℝ (Set.range (v j))
    (∀ j, Module.Finite ℝ (W j)) ∧
      hyperSeqRange (U : Filter J) n v ⊆ (internalSubmodule (U : Filter J) W : Set _) ∧
      (∀ L : J → Submodule ℝ E,
        hyperSeqRange (U : Filter J) n v ⊆ (internalSubmodule (U : Filter J) L : Set _) →
          internalSubmodule (U : Filter J) W ≤ internalSubmodule (U : Filter J) L) ∧
      ((internalSubmodule (U : Filter J) W : Set (Germ (U : Filter J) E)) =
        Set.range (fun r : ∀ j, Fin (n j) → ℝ ↦ hyperLinComb (U : Filter J) n r v)) := by
  intro W
  refine ⟨fun j ↦ Module.Finite.span_of_finite ℝ (Set.finite_range (v j)), ?_, ?_, ?_⟩
  · intro x hx
    induction x using Germ.inductionOn with | _ f =>
    exact Germ.liftRel_coe.mpr ((Germ.liftRel_coe.mp hx).mono fun j hfj ↦
      Submodule.subset_span hfj)
  · intro L hL x hx
    induction x using Germ.inductionOn with | _ f =>
    rw [coe_mem_internalSubmodule] at hx ⊢
    have hsub : ∀ᶠ j in (U : Filter J), Set.range (v j) ⊆ (L j : Set E) := by
      by_contra hnot
      have hev : ∀ᶠ j in (U : Filter J), ¬ (Set.range (v j) ⊆ (L j : Set E)) :=
        Ultrafilter.eventually_not.mpr hnot
      have hex : ∀ j : J, ¬ (Set.range (v j) ⊆ (L j : Set E)) →
          ∃ y : E, y ∈ Set.range (v j) ∧ y ∉ (L j : Set E) := fun _ h ↦ Set.not_subset.mp h
      let g : J → E := fun j ↦
        if h : ¬ (Set.range (v j) ⊆ (L j : Set E)) then (hex j h).choose else 0
      have hgRange : (g : Germ (U : Filter J) E) ∈ hyperSeqRange (U : Filter J) n v := by
        change Germ.LiftRel (· ∈ ·) (g : Germ (U : Filter J) E)
          ((fun j ↦ Set.range (v j)) : Germ (U : Filter J) (Set E))
        refine Germ.liftRel_coe.mpr (hev.mono fun j hj ↦ ?_)
        rw [show g j = (hex j hj).choose from dite_eq_left_of_eq_true (eq_true hj)]
        exact (hex j hj).choose_spec.1
      have hgL : (g : Germ (U : Filter J) E) ∈ internalSubmodule (U : Filter J) L := hL hgRange
      rw [coe_mem_internalSubmodule] at hgL
      obtain ⟨j, hj, hgLj⟩ := (hev.and hgL).exists
      rw [show g j = (hex j hj).choose from dite_eq_left_of_eq_true (eq_true hj)] at hgLj
      exact (hex j hj).choose_spec.2 hgLj
    exact (hx.and hsub).mono fun j ⟨hfj, hs⟩ ↦ (Submodule.span_le.mpr hs) hfj
  · ext x
    constructor
    · intro hx
      induction x using Germ.inductionOn with | _ f =>
      rw [SetLike.mem_coe, coe_mem_internalSubmodule] at hx
      have hex : ∀ j : J, f j ∈ W j → ∃ c : Fin (n j) → ℝ, ∑ i, c i • v j i = f j :=
        fun j hj ↦ (Submodule.mem_span_range_iff_exists_fun ℝ).mp hj
      let r : ∀ j, Fin (n j) → ℝ := fun j ↦
        if hj : f j ∈ W j then (hex j hj).choose else 0
      refine ⟨r, Germ.coe_eq.mpr (hx.mono fun j hj ↦ ?_)⟩
      change ∑ i, r j i • v j i = f j
      rw [show r j = (hex j hj).choose from dite_eq_left_of_eq_true (eq_true hj)]
      exact (hex j hj).choose_spec
    · rintro ⟨r, rfl⟩
      exact hyperLinComb_mem_internalSubmodule r
        (Eventually.of_forall fun j i ↦ Submodule.subset_span ⟨i, rfl⟩)

/-- Finite-dimensional subspace `spanAt F := Submodule.span ℝ (F : Set E)` spanned by a finite
subset `F : Finset E` (Goldblatt §19.8, Theorem 19.8.2, p. 275). -/
def spanAt {E : Type*} [AddCommGroup E] [Module ℝ E] (F : Finset E) : Submodule ℝ E :=
  Submodule.span ℝ (F : Set E)

instance instModuleFiniteSpanAt {E : Type*} [AddCommGroup E] [Module ℝ E] (F : Finset E) :
    Module.Finite ℝ (spanAt F) :=
  Module.Finite.span_of_finite ℝ F.finite_toSet

/-- `finrank ℝ (spanAt F) ≤ F.card` for every `F : Finset E` (Goldblatt §19.8, p. 275). -/
theorem finrank_spanAt_le_card {E : Type*} [AddCommGroup E] [Module ℝ E] (F : Finset E) :
    Module.finrank ℝ (spanAt F) ≤ F.card :=
  finrank_span_finset_le_card F

/-- Goldblatt §19.8, **Theorem 19.8.2** (pp. 274–275): The **hyperfinite-dimensional approximating
subspace** `V⁺ = hyperfiniteApproxSubspace E` of `StarElem E` over the hyperreal field
`StarReal E`, constructed as `internalSubmodule (fineUltrafilter E) spanAt`. -/
def hyperfiniteApproxSubspace (E : Type*) [AddCommGroup E] [Module ℝ E] :
    Submodule (StarReal E) (StarElem E) :=
  internalSubmodule (fineUltrafilter E : Filter (Finset E)) spanAt

/-- **Theorem 19.8.2 (Inclusion `E ⊆ V⁺`)** (Goldblatt §19.8, p. 275): Every standard vector
`stdElem v` (`v : E`) belongs to the hyperfinite-dimensional subspace
`hyperfiniteApproxSubspace E`! -/
theorem stdElem_mem_hyperfiniteApproxSubspace {E : Type*} [AddCommGroup E] [Module ℝ E] (v : E) :
    stdElem v ∈ hyperfiniteApproxSubspace E := by
  change ((fun _ : Finset E ↦ v) : StarElem E) ∈
    internalSubmodule (fineUltrafilter E : Filter (Finset E)) spanAt
  rw [coe_mem_internalSubmodule]
  exact (eventually_mem_fineUltrafilter v).mono fun F hvF ↦ Submodule.subset_span hvF

/-- Injective `ℝ`-linear embedding `v ↦ ⟨stdElem v, ...⟩` of any real vector space `E` into its
hyperfinite-dimensional approximating subspace `V⁺ = hyperfiniteApproxSubspace E`
(**Theorem 19.8.2**, Goldblatt §19.8, pp. 274–275). -/
def stdLinearEmbedding (E : Type*) [AddCommGroup E] [Module ℝ E] :
    E →ₗ[ℝ] ↥(hyperfiniteApproxSubspace E) where
  toFun v := ⟨stdElem v, stdElem_mem_hyperfiniteApproxSubspace v⟩
  map_add' _ _ := Subtype.ext rfl
  map_smul' _ _ := Subtype.ext rfl

/-- `stdLinearEmbedding E` is injective (`E ↪ₗ[ℝ] V⁺`, Goldblatt §19.8, Theorem 19.8.2). -/
theorem stdLinearEmbedding_injective (E : Type*) [AddCommGroup E] [Module ℝ E] :
    Function.Injective (stdLinearEmbedding E) := by
  intro x y hxy
  exact stdElem_injective E (congrArg Subtype.val hxy)

/-- **Theorem 19.8.2 (Hyperfinite-Dimensionality of `V⁺`)** (Goldblatt §19.8, pp. 274–275):
`hyperfiniteApproxSubspace E` contains `E` (via `stdElem`) AND admits a hyperfinite `*ℝ_E`-basis
of internal dimension `d F = Module.finrank ℝ (spanAt F) ≤ F.card` with almost-everywhere unique
coordinates! -/
theorem hyperfiniteApproxSubspace_has_hyperfinite_basis (E : Type*)
    [AddCommGroup E] [Module ℝ E] :
    let d : Finset E → ℕ := fun F ↦ Module.finrank ℝ (spanAt F)
    let b : ∀ F, Fin (d F) → E := fun F i ↦ (Module.finBasis ℝ (spanAt F) i : E)
    (∀ v : E, stdElem v ∈ hyperfiniteApproxSubspace E) ∧
      (∀ F : Finset E, d F ≤ F.card) ∧
      (∀ x ∈ hyperfiniteApproxSubspace E,
        ∃ r : ∀ F, Fin (d F) → ℝ,
          x = hyperLinComb (fineUltrafilter E : Filter (Finset E)) d r b) ∧
      (∀ r s : ∀ F, Fin (d F) → ℝ,
        hyperLinComb (fineUltrafilter E : Filter (Finset E)) d r b =
          hyperLinComb (fineUltrafilter E : Filter (Finset E)) d s b ↔
            ∀ᶠ F in (fineUltrafilter E : Filter (Finset E)), r F = s F) := by
  intro d b
  obtain ⟨_, hspan, huniq⟩ :=
    exists_unique_hyperLinComb_of_finiteDimensional
      (fineUltrafilter E : Filter (Finset E)) (spanAt (E := E))
  exact ⟨stdElem_mem_hyperfiniteApproxSubspace, finrank_spanAt_le_card, hspan, huniq⟩

/-- Helper for Exercise 19.9(2): if an ultrafilter-indexed function `f : J → α` eventually lands
in a finite set `S : Finset α`, then `f` is eventually constant equal to some `c ∈ S`! -/
theorem ultrafilter_eventually_eq_of_mem_finset {J α : Type*} (U : Ultrafilter J)
    {S : Finset α} {f : J → α} (h : ∀ᶠ j in (U : Filter J), f j ∈ S) :
    ∃ c ∈ S, ∀ᶠ j in (U : Filter J), f j = c := by
  induction S using Finset.induction with
  | empty =>
    exfalso
    obtain ⟨j, hj⟩ := h.exists
    exact Finset.notMem_empty (f j) hj
  | @insert a S ha ih =>
    have hor : (∀ᶠ j in (U : Filter J), f j = a) ∨ (∀ᶠ j in (U : Filter J), f j ∈ S) := by
      rw [← Ultrafilter.eventually_or]
      exact h.mono fun j hj ↦ Finset.mem_insert.mp hj
    rcases hor with ha_eq | hS
    · exact ⟨a, Finset.mem_insert_self a S, ha_eq⟩
    · obtain ⟨c, hcS, hc_eq⟩ := ih hS
      exact ⟨c, Finset.mem_insert_of_mem hcS, hc_eq⟩

/-- `ofSeq` as an `ℝ`-algebra homomorphism `(ℕ → ℝ) →ₐ[ℝ] ℝ*`. -/
def ofSeqAlgHom : (ℕ → ℝ) →ₐ[ℝ] ℝ* :=
  { Germ.coeRingHom (hyperfilter ℕ : Filter ℕ) with
    commutes' := fun _ ↦ rfl }

/-- Evaluating a real polynomial `P : Polynomial ℝ` at `ofSeq f : ℝ*` evaluates `P` indexwise:
`Polynomial.aeval (ofSeq f) P = ofSeq (fun n ↦ P.eval (f n))` (Goldblatt §19.9, p. 275). -/
theorem aeval_ofSeq (f : ℕ → ℝ) (P : Polynomial ℝ) :
    Polynomial.aeval (ofSeq f) P = ofSeq (fun n ↦ P.eval (f n)) := by
  change Polynomial.aeval (ofSeqAlgHom f) P = ofSeqAlgHom (fun n ↦ P.eval (f n))
  rw [Polynomial.aeval_algHom_apply]
  refine congrArg ofSeqAlgHom (funext fun n ↦ ?_)
  rw [Polynomial.aeval_pi_apply]
  dsimp only []
  rw [Polynomial.coe_aeval_eq_eval]

/-- **Exercise 19.9(2)(a)** (Goldblatt §19.9, p. 275): Every nonstandard hyperreal `r ∈ ℝ* \ ℝ`
is **transcendental over `ℝ`** — it is not a root of any nonzero polynomial `P : Polynomial ℝ` with
real coefficients! -/
theorem exercise_19_9_2_a_transcendental_of_not_std {r : ℝ*} (hr : ∀ c : ℝ, r ≠ (c : ℝ*))
    (P : Polynomial ℝ) (hP : Polynomial.aeval r P = 0) : P = 0 := by
  by_contra hP_ne
  obtain ⟨f, rfl⟩ := ofSeq_surjective r
  rw [aeval_ofSeq] at hP
  have hev0 : ∀ᶠ n in (hyperfilter ℕ : Filter ℕ), P.eval (f n) = 0 :=
    Germ.coe_eq.mp hP
  have hevS : ∀ᶠ n in (hyperfilter ℕ : Filter ℕ), f n ∈ P.roots.toFinset := by
    refine hev0.mono fun n hn ↦ ?_
    rw [Multiset.mem_toFinset, Polynomial.mem_roots hP_ne]
    exact hn
  obtain ⟨c, _, hfc⟩ := ultrafilter_eventually_eq_of_mem_finset (hyperfilter ℕ) hevS
  have heq : ofSeq f = (c : ℝ*) := Germ.coe_eq.mpr hfc
  exact hr c heq

/-- **Exercise 19.9(2)(b)** (Goldblatt §19.9, p. 275): For any nonstandard hyperreal `r ∈ ℝ* \ ℝ`,
the family `{r ^ n : n ∈ ℕ}` of finite powers of `r` is **linearly independent over `ℝ`**! -/
theorem exercise_19_9_2_b_linearIndependent_powers {r : ℝ*} (hr : ∀ c : ℝ, r ≠ (c : ℝ*)) :
    LinearIndependent ℝ (fun n : ℕ ↦ r ^ n) := by
  rw [linearIndependent_iff']
  intro s g hsum i₀ hi₀
  let P : Polynomial ℝ := ∑ i ∈ s, Polynomial.C (g i) * Polynomial.X ^ i
  have haeval : Polynomial.aeval r P = 0 := by
    simp only [P, map_sum, map_mul, map_pow, Polynomial.aeval_C, Polynomial.aeval_X,
      algebraMap_hyperreal_apply, ← real_smul_hyperreal]
    exact hsum
  have hP0 : P = 0 := exercise_19_9_2_a_transcendental_of_not_std hr P haeval
  have hcoeff : P.coeff i₀ = 0 := by rw [hP0, Polynomial.coeff_zero]
  simpa only [P, Polynomial.finsetSum_coeff, Polynomial.coeff_C_mul_X_pow,
    Finset.sum_ite_eq, hi₀, ite_true] using hcoeff

/-- **Exercise 19.9(2)(c)** (Goldblatt §19.9, p. 275): While `ℝ*` is 1-dimensional over itself,
`ℝ*` is **infinite-dimensional** as a vector space over `ℝ` (`¬ Module.Finite ℝ ℝ*`)! -/
theorem exercise_19_9_2_c_not_finiteDimensional_hyperreal :
    ¬ Module.Finite ℝ ℝ* := by
  intro hfin
  have hnot_std : ∀ c : ℝ, Hyperreal.omega ≠ (c : ℝ*) :=
    fun c hc ↦ (Hyperreal.coe_lt_omega c).ne' hc
  have : Finite ℕ := (exercise_19_9_2_b_linearIndependent_powers hnot_std).finite
  exact _root_.not_finite ℕ

/-- Goldblatt §19.9, **Exercise 19.9(3)** (p. 275): The set `𝕃` of **limited hyperreals** as a
real vector subspace `LimitedSubspace : Submodule ℝ ℝ*` of `ℝ*`. -/
def LimitedSubspace : Submodule ℝ ℝ* where
  carrier := {b : ℝ* | Goldblatt.IsLimited b}
  zero_mem' := Goldblatt.LimitedSubring.zero_mem
  add_mem' ha hb := Goldblatt.LimitedSubring.add_mem ha hb
  smul_mem' c {b} hb := by
    rw [real_smul_hyperreal]
    exact Goldblatt.LimitedSubring.mul_mem (Goldblatt.isLimited_coe c) hb

@[simp]
theorem mem_limitedSubspace_iff {b : ℝ*} : b ∈ LimitedSubspace ↔ Goldblatt.IsLimited b :=
  Iff.rfl

/-- **Exercise 19.9(3)** (Goldblatt §19.9, p. 275): The real vector space `𝕃` (`LimitedSubspace`)
of limited hyperreals is **infinite-dimensional** over `ℝ` (`¬ Module.Finite ℝ LimitedSubspace`),
witnessed by the `ℝ`-linearly independent powers `{ε ^ n : n ∈ ℕ}` of the nonzero infinitesimal
`Hyperreal.epsilon`! -/
theorem exercise_19_9_3_not_finiteDimensional_limitedSubspace :
    ¬ Module.Finite ℝ LimitedSubspace := by
  intro hfin
  have heps_not_std : ∀ c : ℝ, Hyperreal.epsilon ≠ (c : ℝ*) := by
    intro c hc
    have hinf : Goldblatt.IsInfinitesimal (c : ℝ*) := hc ▸ Goldblatt.isInfinitesimal_epsilon
    have hc0 : c = 0 := Goldblatt.isInfinitesimal_coe_iff.mp hinf
    exact Hyperreal.epsilon_ne_zero (hc.trans (by simp [hc0]))
  have hli_ambient := exercise_19_9_2_b_linearIndependent_powers heps_not_std
  let powLim : ℕ → LimitedSubspace := fun n ↦
    ⟨Hyperreal.epsilon ^ n,
      Goldblatt.LimitedSubring.pow_mem Goldblatt.isInfinitesimal_epsilon.isLimited n⟩
  have hli : LinearIndependent ℝ powLim := by
    rw [linearIndependent_iff'] at hli_ambient ⊢
    intro s g hsum i₀ hi₀
    apply hli_ambient s g _ i₀ hi₀
    simpa only [powLim, AddSubmonoidClass.coe_finsetSum, SetLike.val_smul,
      ZeroMemClass.coe_zero] using congrArg Subtype.val hsum
  have : Finite ℕ := hli.finite
  exact _root_.not_finite ℕ

end HyperfiniteVectorSpaces

/-! ## §19.10–19.11 The Nonstandard Hahn–Banach Theorem, Exercises 19.11(1)–(3), & Corollaries
(pp. 275–278) -/

section NonstandardHahnBanach

/-- Goldblatt §19.10 (p. 275): A functional `p : E → ℝ` on a real vector space `E` is **positively
homogeneous** if `p (c • x) = c * p x` for all `c ≥ 0` and `x ∈ E`. -/
def IsPosHomogeneous {E : Type*} [AddCommGroup E] [Module ℝ E] (p : E → ℝ) : Prop :=
  ∀ c : ℝ, 0 ≤ c → ∀ x : E, p (c • x) = c * p x

/-- Goldblatt §19.10 (pp. 275–276): A functional `p : E → ℝ` is **subadditive** if
`p (x + y) ≤ p x + p y` for all `x, y ∈ E`. -/
def IsSubadditive {E : Type*} [AddCommGroup E] [Module ℝ E] (p : E → ℝ) : Prop :=
  ∀ x y : E, p (x + y) ≤ p x + p y

/-- Goldblatt §19.10 (p. 276): A functional `p : E → ℝ` is **sublinear** if it is positively
homogeneous and subadditive. -/
def IsSublinear {E : Type*} [AddCommGroup E] [Module ℝ E] (p : E → ℝ) : Prop :=
  IsPosHomogeneous p ∧ IsSubadditive p

/-- Equivalence between `IsPosHomogeneous p` (`c ≥ 0`) and `p 0 = 0` plus positive homogeneity for
`c > 0`. -/
theorem isPosHomogeneous_iff_zero_and_pos {E : Type*} [AddCommGroup E] [Module ℝ E] {p : E → ℝ} :
    IsPosHomogeneous p ↔ p 0 = 0 ∧ ∀ c : ℝ, 0 < c → ∀ x : E, p (c • x) = c * p x := by
  constructor
  · intro hp
    refine ⟨?_, fun c hc x ↦ hp c hc.le x⟩
    have h0 := hp 0 le_rfl 0
    simpa using h0
  · rintro ⟨h0, hp⟩ c hc x
    rcases hc.eq_or_lt with rfl | hpos
    · simp [h0]
    · exact hp c hpos x

theorem IsSublinear.map_zero {E : Type*} [AddCommGroup E] [Module ℝ E] {p : E → ℝ}
    (hp : IsSublinear p) : p 0 = 0 :=
  (isPosHomogeneous_iff_zero_and_pos.mp hp.1).1

theorem IsSublinear.neg_le {E : Type*} [AddCommGroup E] [Module ℝ E] {p : E → ℝ}
    (hp : IsSublinear p) (x : E) : -p (-x) ≤ p x := by
  have h0 : 0 ≤ p x + p (-x) := by
    have h := hp.2 x (-x)
    rwa [add_neg_cancel, hp.map_zero] at h
  linarith

/-- Goldblatt §19.10 (p. 276): A linear functional `f : M →ₗ[ℝ] ℝ` on a subspace `M ≤ E` is
**dominated by `p`** if `f m ≤ p (m : E)` for all `m : M`. -/
def IsDominatedBy {E : Type*} [AddCommGroup E] [Module ℝ E]
    (M : Submodule ℝ E) (f : M →ₗ[ℝ] ℝ) (p : E → ℝ) : Prop :=
  ∀ m : M, f m ≤ p (m : E)

/-- Goldblatt §19.10 (p. 277): If `f : M →ₗ[ℝ] ℝ` is dominated by `p`, then
`-p (-(m : E)) ≤ f m` for all `m : M`. -/
theorem IsDominatedBy.neg_le {E : Type*} [AddCommGroup E] [Module ℝ E]
    {M : Submodule ℝ E} {f : M →ₗ[ℝ] ℝ} {p : E → ℝ}
    (hf : IsDominatedBy M f p) (m : M) : -p (-(m : E)) ≤ f m := by
  have h := hf (-m)
  rw [map_neg, Submodule.coe_neg] at h
  linarith

/-- Goldblatt §19.10, **Lemma 19.10.1** (p. 276): **One-Step Hahn–Banach Extension**.
Given a sublinear functional `p : E → ℝ`, a subspace `M : Submodule ℝ E`, a linear functional
`f : M →ₗ[ℝ] ℝ` dominated by `p`, and any vector `v : E`, there exists a linear functional
`h : ↥(M ⊔ Submodule.span ℝ {v}) →ₗ[ℝ] ℝ` extending `f` and dominated by `p`! -/
theorem hahn_banach_one_step {E : Type*} [AddCommGroup E] [Module ℝ E]
    {p : E → ℝ} (hp : IsSublinear p) {M : Submodule ℝ E} {f : M →ₗ[ℝ] ℝ}
    (hf : IsDominatedBy M f p) (v : E) :
    ∃ h : ↥(M ⊔ Submodule.span ℝ ({v} : Set E)) →ₗ[ℝ] ℝ,
      (∀ m : M, h ⟨(m : E), Submodule.mem_sup_left m.2⟩ = f m) ∧
      IsDominatedBy (M ⊔ Submodule.span ℝ ({v} : Set E)) h p := by
  let N : Submodule ℝ E := M ⊔ Submodule.span ℝ ({v} : Set E)
  by_cases hv : v ∈ M
  · have hle : Submodule.span ℝ ({v} : Set E) ≤ M :=
      Submodule.span_le.mpr (Set.singleton_subset_iff.mpr hv)
    have hNM : N ≤ M := sup_le le_rfl hle
    refine ⟨{
      toFun := fun z ↦ f ⟨(z : E), hNM z.2⟩
      map_add' := fun x y ↦ f.map_add ⟨(x : E), hNM x.2⟩ ⟨(y : E), hNM y.2⟩
      map_smul' := fun a x ↦ f.map_smul a ⟨(x : E), hNM x.2⟩
    }, ?_, ?_⟩
    · intro m
      rfl
    · intro z
      exact hf ⟨(z : E), hNM z.2⟩
  · -- Case `v ∉ M`: choose `c = sSup {-p(-y - v) - f(y) : y ∈ M}` by Dedekind completeness of `ℝ`
    let S : Set ℝ := Set.range (fun y : M ↦ -p (-(y : E) - v) - f y)
    have hNonempty : S.Nonempty := ⟨-p (-((0 : M) : E) - v) - f 0, ⟨0, rfl⟩⟩
    have hGap : ∀ y₁ y₂ : M, -p (-(y₁ : E) - v) - f y₁ ≤ p ((y₂ : E) + v) - f y₂ := by
      intro y₁ y₂
      have hdom : f (y₂ - y₁) ≤ p (((y₂ - y₁ : M) : E)) := hf (y₂ - y₁)
      rw [map_sub, Submodule.coe_sub] at hdom
      have heq : (y₂ : E) - (y₁ : E) = ((y₂ : E) + v) + (-(y₁ : E) - v) := by abel
      have hsub : p ((y₂ : E) - (y₁ : E)) ≤ p ((y₂ : E) + v) + p (-(y₁ : E) - v) := by
        rw [heq]
        exact hp.2 ((y₂ : E) + v) (-(y₁ : E) - v)
      linarith
    have hBdd : BddAbove S := by
      refine ⟨p (((0 : M) : E) + v) - f 0, ?_⟩
      rintro _ ⟨y₁, rfl⟩
      exact hGap y₁ 0
    let c : ℝ := sSup S
    have hc_ge : ∀ y : M, -p (-(y : E) - v) - f y ≤ c :=
      fun y ↦ le_csSup hBdd ⟨y, rfl⟩
    have hc_le : ∀ y : M, c ≤ p ((y : E) + v) - f y := by
      intro y₂
      refine csSup_le hNonempty ?_
      rintro _ ⟨y₁, rfl⟩
      exact hGap y₁ y₂
    -- Unique decomposition `z = m + t • v` for `z ∈ N` when `v ∉ M`
    have hDecomp : ∀ z : N, ∃ q : M × ℝ, (q.1 : E) + q.2 • v = (z : E) := by
      intro z
      rcases Submodule.mem_sup.mp z.2 with ⟨m, hm, w, hw, hmw⟩
      rcases Submodule.mem_span_singleton.mp hw with ⟨t, rfl⟩
      exact ⟨(⟨m, hm⟩, t), hmw⟩
    have hUnique : ∀ (m₁ m₂ : M) (t₁ t₂ : ℝ),
        (m₁ : E) + t₁ • v = (m₂ : E) + t₂ • v → m₁ = m₂ ∧ t₁ = t₂ := by
      intro m₁ m₂ t₁ t₂ heq
      have ht : t₁ = t₂ := by
        by_contra hne
        have hdiff : (t₁ - t₂) • v = (m₂ : E) - (m₁ : E) := by
          calc (t₁ - t₂) • v = ((m₁ : E) + t₁ • v) - (m₁ : E) - t₂ • v := by
                rw [sub_smul]; abel
            _ = ((m₂ : E) + t₂ • v) - (m₁ : E) - t₂ • v := by rw [heq]
            _ = (m₂ : E) - (m₁ : E) := by abel
        have hmemM : (t₁ - t₂) • v ∈ M := by
          rw [hdiff]
          exact M.sub_mem m₂.2 m₁.2
        have hvM : v ∈ M := by
          have hinv := M.smul_mem (t₁ - t₂)⁻¹ hmemM
          rwa [inv_smul_smul₀ (sub_ne_zero.mpr hne)] at hinv
        exact hv hvM
      subst ht
      have hm : (m₁ : E) = (m₂ : E) := add_right_cancel heq
      exact ⟨Subtype.ext hm, rfl⟩
    let hFun : N → ℝ := fun z ↦
      f (hDecomp z).choose.1 + (hDecomp z).choose.2 * c
    have hhFun : ∀ (m : M) (t : ℝ) (hz : (m : E) + t • v ∈ N),
        hFun ⟨(m : E) + t • v, hz⟩ = f m + t * c := by
      intro m t hz
      let z : N := ⟨(m : E) + t • v, hz⟩
      have hspec : ((hDecomp z).choose.1 : E) + (hDecomp z).choose.2 • v =
          (m : E) + t • v := (hDecomp z).choose_spec
      obtain ⟨hm_eq, ht_eq⟩ := hUnique (hDecomp z).choose.1 m (hDecomp z).choose.2 t hspec
      change f (hDecomp z).choose.1 + (hDecomp z).choose.2 * c = f m + t * c
      rw [hm_eq, ht_eq]
    refine ⟨{
      toFun := hFun
      map_add' := fun z₁ z₂ ↦ by
        obtain ⟨⟨m₁, t₁⟩, hz₁⟩ := hDecomp z₁
        obtain ⟨⟨m₂, t₂⟩, hz₂⟩ := hDecomp z₂
        have heq₁ : z₁ = ⟨(m₁ : E) + t₁ • v, hz₁.symm ▸ z₁.2⟩ := Subtype.ext hz₁.symm
        have heq₂ : z₂ = ⟨(m₂ : E) + t₂ • v, hz₂.symm ▸ z₂.2⟩ := Subtype.ext hz₂.symm
        have hsum_val : ((z₁ + z₂ : N) : E) = ((m₁ + m₂ : M) : E) + (t₁ + t₂) • v := by
          simp only [Submodule.coe_add, ← hz₁, ← hz₂, add_smul]
          abel
        have heq₁₂ : z₁ + z₂ = ⟨((m₁ + m₂ : M) : E) + (t₁ + t₂) • v,
            hsum_val ▸ (z₁ + z₂).2⟩ := Subtype.ext hsum_val
        rw [heq₁₂, hhFun (m₁ + m₂) (t₁ + t₂), heq₁, hhFun m₁ t₁, heq₂, hhFun m₂ t₂, map_add]
        ring
      map_smul' := fun a z ↦ by
        obtain ⟨⟨m, t⟩, hz⟩ := hDecomp z
        have heq : z = ⟨(m : E) + t • v, hz.symm ▸ z.2⟩ := Subtype.ext hz.symm
        have hsmul_val : ((a • z : N) : E) = ((a • m : M) : E) + (a * t) • v := by
          simp only [SetLike.val_smul, ← hz, smul_add, mul_smul]
        have heqa : a • z = ⟨((a • m : M) : E) + (a * t) • v,
            hsmul_val ▸ (a • z).2⟩ := Subtype.ext hsmul_val
        rw [heqa, hhFun (a • m) (a * t), heq, hhFun m t, map_smul, smul_eq_mul, RingHom.id_apply,
          smul_eq_mul]
        ring
    }, ?_, ?_⟩
    · intro m
      change hFun ⟨(m : E), Submodule.mem_sup_left m.2⟩ = f m
      have hmN : (m : E) + (0 : ℝ) • v ∈ N := by
        simpa using (Submodule.mem_sup_left m.2 : (m : E) ∈ N)
      have hm0 : (⟨(m : E), Submodule.mem_sup_left m.2⟩ : N) =
          ⟨(m : E) + (0 : ℝ) • v, hmN⟩ := by
        apply Subtype.ext
        simp
      rw [hm0, hhFun m 0]
      ring
    · intro z
      change hFun z ≤ p (z : E)
      obtain ⟨⟨m, t⟩, hz⟩ := hDecomp z
      have heq : z = ⟨(m : E) + t • v, hz.symm ▸ z.2⟩ := Subtype.ext hz.symm
      rw [heq, hhFun m t]
      change f m + t * c ≤ p ((m : E) + t • v)
      rcases lt_trichotomy t 0 with ht_neg | rfl | ht_pos
      · -- Case `t < 0`: let `s = -t > 0`
        let s : ℝ := -t
        have hs_pos : 0 < s := neg_pos.mpr ht_neg
        have hbound := hc_ge ((-s⁻¹) • m)
        have hvec : -((((-s⁻¹) • m : M) : E)) - v = s⁻¹ • ((m : E) + t • v) := by
          have hst : (-1 : ℝ) = s⁻¹ * t := by
            have h1 : s⁻¹ * (-s) = -1 := by rw [mul_neg, inv_mul_cancel₀ hs_pos.ne']
            have hts : -s = t := neg_neg t
            rw [← hts]
            exact h1.symm
          calc -((((-s⁻¹) • m : M) : E)) - v
              = s⁻¹ • (m : E) + (-1 : ℝ) • v := by
                rw [SetLike.val_smul, neg_smul, neg_neg, neg_one_smul, sub_eq_add_neg]
            _ = s⁻¹ • (m : E) + (s⁻¹ * t) • v := by rw [hst]
            _ = s⁻¹ • ((m : E) + t • v) := by rw [smul_add, smul_smul]
        have hp_scale : p ((m : E) + t • v) = s * p (s⁻¹ • ((m : E) + t • v)) := by
          rw [← hp.1 s hs_pos.le, smul_inv_smul₀ hs_pos.ne']
        have hf_scale : f ((-s⁻¹) • m) = -s⁻¹ * f m := by
          rw [map_smul, smul_eq_mul]
        rw [hvec, hf_scale] at hbound
        have hmul := mul_le_mul_of_nonneg_left hbound hs_pos.le
        have hcalc : s * (-p (s⁻¹ • ((m : E) + t • v)) - (-s⁻¹ * f m)) =
            -p ((m : E) + t • v) + f m := by
          have hs_inv : s * s⁻¹ = 1 := mul_inv_cancel₀ hs_pos.ne'
          calc s * (-p (s⁻¹ • ((m : E) + t • v)) - (-s⁻¹ * f m))
              = -(s * p (s⁻¹ • ((m : E) + t • v))) + (s * s⁻¹) * f m := by ring
            _ = -p ((m : E) + t • v) + f m := by rw [← hp_scale, hs_inv, one_mul]
        rw [hcalc] at hmul
        have hsc : s * c = -(t * c) := by dsimp [s]; ring
        linarith
      · -- Case `t = 0`
        simpa using hf m
      · -- Case `0 < t`
        have hbound := hc_le (t⁻¹ • m)
        have hvec : ((t⁻¹ • m : M) : E) + v = t⁻¹ • ((m : E) + t • v) := by
          simp only [SetLike.val_smul, smul_add, inv_smul_smul₀ ht_pos.ne']
        have hp_scale : p ((m : E) + t • v) = t * p (t⁻¹ • ((m : E) + t • v)) := by
          rw [← hp.1 t ht_pos.le, smul_inv_smul₀ ht_pos.ne']
        have hf_scale : f (t⁻¹ • m) = t⁻¹ * f m := by
          rw [map_smul, smul_eq_mul]
        rw [hvec, hf_scale] at hbound
        have hmul := mul_le_mul_of_nonneg_left hbound ht_pos.le
        have hcalc : t * (p (t⁻¹ • ((m : E) + t • v)) - t⁻¹ * f m) =
            p ((m : E) + t • v) - f m := by
          have ht_inv : t * t⁻¹ = 1 := mul_inv_cancel₀ ht_pos.ne'
          calc t * (p (t⁻¹ • ((m : E) + t • v)) - t⁻¹ * f m)
              = t * p (t⁻¹ • ((m : E) + t • v)) - (t * t⁻¹) * f m := by ring
            _ = p ((m : E) + t • v) - f m := by rw [← hp_scale, ht_inv, one_mul]
        linarith

/-- Goldblatt §19.10 (p. 277): **Finite-Dimensional Hahn–Banach Extension** obtained by iterating
Lemma 19.10.1 finitely many times over any `F : Finset E`. -/
theorem hahn_banach_finset {E : Type*} [AddCommGroup E] [Module ℝ E]
    {p : E → ℝ} (hp : IsSublinear p) {M : Submodule ℝ E} {f : M →ₗ[ℝ] ℝ}
    (hf : IsDominatedBy M f p) (F : Finset E) :
    ∃ h : ↥(M ⊔ spanAt F) →ₗ[ℝ] ℝ,
      (∀ m : M, h ⟨(m : E), Submodule.mem_sup_left m.2⟩ = f m) ∧
      IsDominatedBy (M ⊔ spanAt F) h p := by
  induction F using Finset.induction with
  | empty =>
    have hbot : spanAt (∅ : Finset E) = ⊥ := by
      simp [spanAt]
    have hsup : M ⊔ spanAt (∅ : Finset E) ≤ M := by
      rw [hbot, sup_bot_eq]
    refine ⟨{
      toFun := fun z ↦ f ⟨(z : E), hsup z.2⟩
      map_add' := fun x y ↦ f.map_add ⟨(x : E), hsup x.2⟩ ⟨(y : E), hsup y.2⟩
      map_smul' := fun a x ↦ f.map_smul a ⟨(x : E), hsup x.2⟩
    }, fun _ ↦ rfl, fun z ↦ hf ⟨(z : E), hsup z.2⟩⟩
  | @insert v F hvF ih =>
    obtain ⟨h₀, hh₀_ext, hh₀_dom⟩ := ih
    obtain ⟨h₁, hh₁_ext, hh₁_dom⟩ := hahn_banach_one_step hp hh₀_dom v
    have hsub_eq : M ⊔ spanAt (insert v F) ≤
        (M ⊔ spanAt F) ⊔ Submodule.span ℝ ({v} : Set E) := by
      rw [spanAt, Finset.coe_insert, Submodule.span_insert]
      exact sup_le (le_sup_of_le_left le_sup_left)
        (sup_le le_sup_right (le_sup_of_le_left le_sup_right))
    refine ⟨{
      toFun := fun z ↦ h₁ ⟨(z : E), hsub_eq z.2⟩
      map_add' := fun x y ↦ h₁.map_add ⟨(x : E), hsub_eq x.2⟩ ⟨(y : E), hsub_eq y.2⟩
      map_smul' := fun a x ↦ h₁.map_smul a ⟨(x : E), hsub_eq x.2⟩
    }, ?_, ?_⟩
    · intro m
      change h₁ ⟨(m : E), Submodule.mem_sup_left (Submodule.mem_sup_left m.2)⟩ = f m
      rw [hh₁_ext ⟨(m : E), Submodule.mem_sup_left m.2⟩, hh₀_ext m]
    · intro z
      exact hh₁_dom ⟨(z : E), hsub_eq z.2⟩

/-! ### Exercise 19.11(1): Limited Ultrapower Elements & Shadow Linear Functional (p. 278) -/

/-- **Exercise 19.11(1) (on `ℝ*`)** (Goldblatt §19.11, p. 278): The shadow map
`sh : 𝕃 → ℝ` (`Goldblatt.shadow`) is a **real linear functional** on the real vector space
`LimitedSubspace` (`𝕃 ⊆ ℝ*`)! -/
def shadowLinearMap : LimitedSubspace →ₗ[ℝ] ℝ where
  toFun x := Goldblatt.shadow x.1
  map_add' x y := Goldblatt.shadow_add x.2 y.2
  map_smul' c x := by
    change Goldblatt.shadow (c • x.1) = c * Goldblatt.shadow x.1
    rw [real_smul_hyperreal, Goldblatt.shadow_mul (Goldblatt.isLimited_coe c) x.2,
      Goldblatt.shadow_coe]

@[simp]
theorem shadowLinearMap_coe (r : ℝ) :
    shadowLinearMap ⟨(r : ℝ*), Goldblatt.isLimited_coe r⟩ = r :=
  Goldblatt.shadow_coe r

theorem shadowLinearMap_mono {x y : LimitedSubspace} (hxy : x.1 ≤ y.1) :
    shadowLinearMap x ≤ shadowLinearMap y :=
  Goldblatt.shadow_le_of_le x.2 y.2 hxy

/-- Limited elements `|x| ≤ B` (`B ∈ ℝ`) in ANY hyperreal ultrapower `Germ U ℝ` over an ultrafilter
`U : Ultrafilter J` (Goldblatt §19.10–19.11, pp. 277–278). -/
def IsLimitedGerm {J : Type*} (U : Ultrafilter J) (x : Germ (U : Filter J) ℝ) : Prop :=
  ∃ B : ℝ, 0 ≤ B ∧ |x| ≤ (B : Germ (U : Filter J) ℝ)

/-- Infinitesimal elements `|x| < ε` (`∀ ε > 0` in `ℝ`) in `Germ U ℝ`
(Goldblatt §19.10–19.11, pp. 277–278). -/
def IsInfinitesimalGerm {J : Type*} (U : Ultrafilter J) (x : Germ (U : Filter J) ℝ) : Prop :=
  ∀ ε : ℝ, 0 < ε → |x| < (ε : Germ (U : Filter J) ℝ)

theorem isLimitedGerm_const {J : Type*} (U : Ultrafilter J) (r : ℝ) :
    IsLimitedGerm U (r : Germ (U : Filter J) ℝ) :=
  ⟨|r|, abs_nonneg r, by rw [Germ.const_abs]⟩

theorem isLimitedGerm_of_sandwiched {J : Type*} (U : Ultrafilter J)
    {a b : ℝ} {x : Germ (U : Filter J) ℝ}
    (ha : (a : Germ (U : Filter J) ℝ) ≤ x) (hb : x ≤ (b : Germ (U : Filter J) ℝ)) :
    IsLimitedGerm U x := by
  let B : ℝ := max |a| |b|
  refine ⟨B, le_trans (abs_nonneg a) (le_max_left _ _), abs_le.mpr ⟨?_, ?_⟩⟩
  · have hBa : -B ≤ a := neg_le.mpr ((le_abs_self (-a)).trans (by simp [B]))
    exact (Germ.const_le hBa).trans ha
  · have hbB : b ≤ B := (le_abs_self b).trans (le_max_right _ _)
    exact hb.trans (Germ.const_le hbB)

theorem isInfinitesimalGerm_zero {J : Type*} (U : Ultrafilter J) :
    IsInfinitesimalGerm U 0 := by
  intro ε hε
  rw [abs_zero]
  exact Germ.const_lt hε

theorem IsInfinitesimalGerm.neg {J : Type*} {U : Ultrafilter J} {x : Germ (U : Filter J) ℝ}
    (hx : IsInfinitesimalGerm U x) : IsInfinitesimalGerm U (-x) := by
  intro ε hε
  rw [abs_neg]
  exact hx ε hε

theorem IsInfinitesimalGerm.add {J : Type*} {U : Ultrafilter J} {x y : Germ (U : Filter J) ℝ}
    (hx : IsInfinitesimalGerm U x) (hy : IsInfinitesimalGerm U y) :
    IsInfinitesimalGerm U (x + y) := by
  intro ε hε
  have h1 := hx (ε / 2) (half_pos hε)
  have h2 := hy (ε / 2) (half_pos hε)
  have hsum : ((ε / 2 : ℝ) : Germ (U : Filter J) ℝ) + ((ε / 2 : ℝ) : Germ (U : Filter J) ℝ) =
      (ε : Germ (U : Filter J) ℝ) := by
    change (((ε / 2 + ε / 2 : ℝ) : Germ (U : Filter J) ℝ)) = _
    rw [add_halves]
  exact (abs_add_le x y).trans_lt (by linarith)

theorem IsInfinitesimalGerm.smul {J : Type*} {U : Ultrafilter J} {x : Germ (U : Filter J) ℝ}
    (c : ℝ) (hx : IsInfinitesimalGerm U x) : IsInfinitesimalGerm U (c • x) := by
  intro ε hε
  rcases eq_or_ne c 0 with rfl | hc
  · rw [zero_smul, abs_zero]
    exact Germ.const_lt hε
  · rw [← const_smul_germ, smul_eq_mul, abs_mul, ← Germ.const_abs]
    have hc_pos : 0 < |c| := abs_pos.mpr hc
    have hlt := hx (ε / |c|) (div_pos hε hc_pos)
    have hmul := mul_lt_mul_of_pos_left hlt (Germ.const_lt hc_pos)
    have heq : ((|c| : ℝ) : Germ (U : Filter J) ℝ) * ((ε / |c| : ℝ) : Germ (U : Filter J) ℝ) =
        (ε : Germ (U : Filter J) ℝ) := by
      change (((|c| * (ε / |c|) : ℝ) : Germ (U : Filter J) ℝ)) = _
      rw [mul_div_cancel₀ ε hc_pos.ne']
    rwa [heq] at hmul

/-- Real vector subspace `LimitedGermSubmodule U` of limited elements in `Germ U ℝ`
(Goldblatt §19.10–19.11, pp. 277–278). -/
def LimitedGermSubmodule {J : Type*} (U : Ultrafilter J) :
    Submodule ℝ (Germ (U : Filter J) ℝ) where
  carrier := {x | IsLimitedGerm U x}
  zero_mem' := ⟨0, le_rfl, by rw [abs_zero]; rfl⟩
  add_mem' := by
    rintro x y ⟨B₁, hB₁, hx⟩ ⟨B₂, hB₂, hy⟩
    refine ⟨B₁ + B₂, add_nonneg hB₁ hB₂, ?_⟩
    have hcast : ((B₁ + B₂ : ℝ) : Germ (U : Filter J) ℝ) =
        (B₁ : Germ (U : Filter J) ℝ) + (B₂ : Germ (U : Filter J) ℝ) := rfl
    rw [hcast]
    exact (abs_add_le x y).trans (add_le_add hx hy)
  smul_mem' := by
    rintro c x ⟨B, hB, hx⟩
    refine ⟨|c| * B, mul_nonneg (abs_nonneg c) hB, ?_⟩
    rw [← const_smul_germ, smul_eq_mul, abs_mul, ← Germ.const_abs]
    have hcast : ((|c| * B : ℝ) : Germ (U : Filter J) ℝ) =
        ((|c| : ℝ) : Germ (U : Filter J) ℝ) * (B : Germ (U : Filter J) ℝ) := rfl
    rw [hcast]
    exact mul_le_mul_of_nonneg_left hx (Germ.const_le (abs_nonneg c))

/-- Dedekind-cut shadow `sh(x) = sSup {r ∈ ℝ | r ≤ x}` on any hyperreal ultrapower `Germ U ℝ`
(Goldblatt §19.10, p. 278; cf. §5.6). -/
def shadowGerm {J : Type*} (U : Ultrafilter J) (x : Germ (U : Filter J) ℝ) : ℝ :=
  sSup {r : ℝ | (r : Germ (U : Filter J) ℝ) ≤ x}

/-- Every limited element `x ∈ Germ U ℝ` is infinitely close to its shadow `shadowGerm U x`! -/
theorem isInfinitesimalGerm_sub_shadowGerm {J : Type*} (U : Ultrafilter J)
    {x : Germ (U : Filter J) ℝ} (hx : IsLimitedGerm U x) :
    IsInfinitesimalGerm U (x - (shadowGerm U x : Germ (U : Filter J) ℝ)) := by
  rcases hx with ⟨B, _, hB⟩
  rcases abs_le.mp hB with ⟨hlow, hhigh⟩
  let S : Set ℝ := {r : ℝ | (r : Germ (U : Filter J) ℝ) ≤ x}
  have hNonempty : S.Nonempty := ⟨-B, hlow⟩
  have hBdd : BddAbove S := ⟨B, fun r hr ↦ Germ.const_le_iff.mp (hr.trans hhigh)⟩
  intro ε hε
  rw [abs_sub_lt_iff]
  constructor
  · -- Show `x - shadowGerm U x < ε`
    have hlt : x < ((shadowGerm U x + ε : ℝ) : Germ (U : Filter J) ℝ) := by
      by_contra hnot
      have hle : ((shadowGerm U x + ε : ℝ) : Germ (U : Filter J) ℝ) ≤ x := le_of_not_gt hnot
      have hcsup : shadowGerm U x + ε ≤ shadowGerm U x := le_csSup hBdd hle
      linarith
    have hcast : ((shadowGerm U x + ε : ℝ) : Germ (U : Filter J) ℝ) =
        (shadowGerm U x : Germ (U : Filter J) ℝ) + (ε : Germ (U : Filter J) ℝ) := rfl
    rw [hcast] at hlt
    linarith
  · -- Show `shadowGerm U x - x < ε`
    have hgt : ((shadowGerm U x - ε : ℝ) : Germ (U : Filter J) ℝ) < x := by
      by_contra hnot
      have hle : x ≤ ((shadowGerm U x - ε : ℝ) : Germ (U : Filter J) ℝ) := le_of_not_gt hnot
      have hcsup : shadowGerm U x ≤ shadowGerm U x - ε :=
        csSup_le hNonempty fun r hr ↦ Germ.const_le_iff.mp (hr.trans hle)
      linarith
    have hcast : ((shadowGerm U x - ε : ℝ) : Germ (U : Filter J) ℝ) =
        (shadowGerm U x : Germ (U : Filter J) ℝ) - (ε : Germ (U : Filter J) ℝ) := rfl
    rw [hcast] at hgt
    linarith

/-- Uniqueness of shadow in `Germ U ℝ`: if `x - c` is infinitesimal for `c : ℝ`, then
`shadowGerm U x = c`! -/
theorem shadowGerm_eq_of_infinitesimal_sub {J : Type*} (U : Ultrafilter J)
    {x : Germ (U : Filter J) ℝ} {c : ℝ}
    (hxc : IsInfinitesimalGerm U (x - (c : Germ (U : Filter J) ℝ))) :
    shadowGerm U x = c := by
  have hx_lim : IsLimitedGerm U x := by
    have hlt := hxc 1 one_pos
    rcases abs_lt.mp hlt with ⟨hl, hr⟩
    have hl' : ((c - 1 : ℝ) : Germ (U : Filter J) ℝ) ≤ x := by
      have hc1 : ((c - 1 : ℝ) : Germ (U : Filter J) ℝ) =
          (c : Germ (U : Filter J) ℝ) - ((1 : ℝ) : Germ (U : Filter J) ℝ) := rfl
      rw [hc1]; linarith
    have hr' : x ≤ ((c + 1 : ℝ) : Germ (U : Filter J) ℝ) := by
      have hc1 : ((c + 1 : ℝ) : Germ (U : Filter J) ℝ) =
          (c : Germ (U : Filter J) ℝ) + ((1 : ℝ) : Germ (U : Filter J) ℝ) := rfl
      rw [hc1]; linarith
    exact isLimitedGerm_of_sandwiched U hl' hr'
  have hsh := isInfinitesimalGerm_sub_shadowGerm U hx_lim
  have hdiff : IsInfinitesimalGerm U
      (((shadowGerm U x - c : ℝ) : Germ (U : Filter J) ℝ)) := by
    have heq : ((shadowGerm U x - c : ℝ) : Germ (U : Filter J) ℝ) =
        (x - (c : Germ (U : Filter J) ℝ)) + (-(x - (shadowGerm U x : Germ (U : Filter J) ℝ))) := by
      change (shadowGerm U x : Germ (U : Filter J) ℝ) - (c : Germ (U : Filter J) ℝ) = _
      abel
    rw [heq]
    exact hxc.add hsh.neg
  by_contra hne
  have hpos : 0 < |shadowGerm U x - c| := abs_pos.mpr (sub_ne_zero.mpr hne)
  have hlt := hdiff (|shadowGerm U x - c|) hpos
  rw [← Germ.const_abs] at hlt
  exact lt_irrefl _ (Germ.const_lt_iff.mp hlt)

@[simp]
theorem shadowGerm_const {J : Type*} (U : Ultrafilter J) (c : ℝ) :
    shadowGerm U (c : Germ (U : Filter J) ℝ) = c := by
  apply shadowGerm_eq_of_infinitesimal_sub U
  rw [sub_self]
  exact isInfinitesimalGerm_zero U

theorem shadowGerm_le_of_le_const {J : Type*} (U : Ultrafilter J)
    {x : Germ (U : Filter J) ℝ} (hx : IsLimitedGerm U x) {b : ℝ}
    (hxb : x ≤ (b : Germ (U : Filter J) ℝ)) :
    shadowGerm U x ≤ b := by
  rcases hx with ⟨B, _, hB⟩
  rcases abs_le.mp hB with ⟨hlow, _⟩
  exact csSup_le ⟨-B, hlow⟩ fun r hr ↦ Germ.const_le_iff.mp (hr.trans hxb)

/-- **Exercise 19.11(1) (for general ultrapowers `Germ U ℝ`)** (Goldblatt §19.11, p. 278):
`shadowGermLinearMap U : LimitedGermSubmodule U →ₗ[ℝ] ℝ` is a real linear functional! -/
def shadowGermLinearMap {J : Type*} (U : Ultrafilter J) :
    LimitedGermSubmodule U →ₗ[ℝ] ℝ where
  toFun x := shadowGerm U x.1
  map_add' x y := by
    apply shadowGerm_eq_of_infinitesimal_sub U
    have hx := isInfinitesimalGerm_sub_shadowGerm U x.2
    have hy := isInfinitesimalGerm_sub_shadowGerm U y.2
    have heq : (x.1 + y.1) - ((shadowGerm U x.1 + shadowGerm U y.1 : ℝ) : Germ (U : Filter J) ℝ) =
        (x.1 - (shadowGerm U x.1 : Germ (U : Filter J) ℝ)) +
          (y.1 - (shadowGerm U y.1 : Germ (U : Filter J) ℝ)) := by
      change (x.1 + y.1) -
          ((shadowGerm U x.1 : Germ (U : Filter J) ℝ) +
            (shadowGerm U y.1 : Germ (U : Filter J) ℝ)) = _
      abel
    rw [Submodule.coe_add, heq]
    exact hx.add hy
  map_smul' c x := by
    change shadowGerm U (c • x.1) = c * shadowGerm U x.1
    apply shadowGerm_eq_of_infinitesimal_sub U
    have hx := (isInfinitesimalGerm_sub_shadowGerm U x.2).smul c
    have heq : c • x.1 - ((c * shadowGerm U x.1 : ℝ) : Germ (U : Filter J) ℝ) =
        c • (x.1 - (shadowGerm U x.1 : Germ (U : Filter J) ℝ)) := by
      rw [smul_sub, ← const_smul_germ, smul_eq_mul]
      rfl
    rw [heq]
    exact hx

/-! ### Exercise 19.11(2) & Goldblatt's Nonstandard Proof of the Hahn–Banach Theorem (pp. 277–278) -/

/-- Totalized evaluation `evalSubmoduleOrZero W h x` equal to `h ⟨x, hx⟩` when `x ∈ W` and `0`
otherwise (Goldblatt §19.10–19.11, pp. 277–278). -/
def evalSubmoduleOrZero {E : Type*} [AddCommGroup E] [Module ℝ E]
    (W : Submodule ℝ E) (h : W →ₗ[ℝ] ℝ) (x : E) : ℝ :=
  if hx : x ∈ W then h ⟨x, hx⟩ else 0

@[simp]
theorem evalSubmoduleOrZero_of_mem {E : Type*} [AddCommGroup E] [Module ℝ E]
    {W : Submodule ℝ E} (h : W →ₗ[ℝ] ℝ) {x : E} (hx : x ∈ W) :
    evalSubmoduleOrZero W h x = h ⟨x, hx⟩ :=
  dite_eq_left_of_eq_true (eq_true hx)

/-- Internal `*ℝ`-linear functional (`→ₗ[Germ l ℝ]`) on `internalSubmodule l W` lifted from an
indexed family of linear functionals `h : ∀ j, W j →ₗ[ℝ] ℝ` (Goldblatt §19.10, p. 277). -/
def liftInternalLinearFunctional {J E : Type*} (l : Filter J)
    [AddCommGroup E] [Module ℝ E]
    (W : J → Submodule ℝ E) (h : ∀ j, W j →ₗ[ℝ] ℝ) :
    ↥(internalSubmodule l W) →ₗ[Germ l ℝ] Germ l ℝ where
  toFun z :=
    Quotient.liftOn z.1
      (fun u ↦ ((fun j ↦ evalSubmoduleOrZero (W j) (h j) (u j)) : Germ l ℝ))
      (fun u₁ u₂ hu ↦ Germ.coe_eq.mpr (hu.mono fun j hj ↦ by dsimp only []; rw [hj]))
  map_add' z₁ z₂ := by
    rcases z₁ with ⟨x₁, hx₁⟩
    rcases z₂ with ⟨x₂, hx₂⟩
    induction x₁ using Germ.inductionOn with | _ u₁ =>
    induction x₂ using Germ.inductionOn with | _ u₂ =>
    rw [coe_mem_internalSubmodule] at hx₁ hx₂
    change ((fun j ↦ evalSubmoduleOrZero (W j) (h j) (u₁ j + u₂ j)) : Germ l ℝ) =
      ((fun j ↦ evalSubmoduleOrZero (W j) (h j) (u₁ j)) : Germ l ℝ) +
        ((fun j ↦ evalSubmoduleOrZero (W j) (h j) (u₂ j)) : Germ l ℝ)
    rw [← Germ.coe_add]
    refine Germ.coe_eq.mpr ((hx₁.and hx₂).mono fun j ⟨hu₁, hu₂⟩ ↦ ?_)
    have hu₁₂ : u₁ j + u₂ j ∈ W j := (W j).add_mem hu₁ hu₂
    dsimp only [Pi.add_apply]
    rw [evalSubmoduleOrZero_of_mem (h j) hu₁₂, evalSubmoduleOrZero_of_mem (h j) hu₁,
      evalSubmoduleOrZero_of_mem (h j) hu₂, ← (h j).map_add]
    rfl
  map_smul' c z := by
    rcases z with ⟨x, hx⟩
    induction c using Germ.inductionOn with | _ r =>
    induction x using Germ.inductionOn with | _ u =>
    rw [coe_mem_internalSubmodule] at hx
    change ((fun j ↦ evalSubmoduleOrZero (W j) (h j) (r j • u j)) : Germ l ℝ) =
      (r : Germ l ℝ) • ((fun j ↦ evalSubmoduleOrZero (W j) (h j) (u j)) : Germ l ℝ)
    rw [← Germ.coe_smul']
    refine Germ.coe_eq.mpr (hx.mono fun j hu ↦ ?_)
    have hru : r j • u j ∈ W j := (W j).smul_mem (r j) hu
    change evalSubmoduleOrZero (W j) (h j) (r j • u j) =
      r j * evalSubmoduleOrZero (W j) (h j) (u j)
    rw [evalSubmoduleOrZero_of_mem (h j) hru, evalSubmoduleOrZero_of_mem (h j) hu]
    exact (h j).map_smul (r j) ⟨u j, hu⟩

@[simp]
theorem liftInternalLinearFunctional_coe {J E : Type*} (l : Filter J)
    [AddCommGroup E] [Module ℝ E]
    (W : J → Submodule ℝ E) (h : ∀ j, W j →ₗ[ℝ] ℝ)
    (u : J → E) (hu : (u : Germ l E) ∈ internalSubmodule l W) :
    liftInternalLinearFunctional l W h ⟨(u : Germ l E), hu⟩ =
      ((fun j ↦ evalSubmoduleOrZero (W j) (h j) (u j)) : Germ l ℝ) :=
  rfl

/-- Domain `dom f⁺ = [F ↦ M ⊔ spanAt F]` of Goldblatt's hyperlinear extension `f⁺`
(Goldblatt §19.10, p. 277). -/
abbrev domHyperlinearExt {E : Type*} [AddCommGroup E] [Module ℝ E] (M : Submodule ℝ E) :
    Submodule (StarReal E) (StarElem E) :=
  internalSubmodule (fineUltrafilter E : Filter (Finset E)) (fun F ↦ M ⊔ spanAt F)

/-- `domHyperlinearExt M` contains `hyperfiniteApproxSubspace E` (`V⁺`), and hence contains every
standard vector `stdElem x` (`x ∈ E`)! -/
theorem hyperfiniteApproxSubspace_le_domHyperlinearExt {E : Type*} [AddCommGroup E] [Module ℝ E]
    (M : Submodule ℝ E) :
    hyperfiniteApproxSubspace E ≤ domHyperlinearExt M := by
  intro x hx
  induction x using Germ.inductionOn with | _ u =>
  rw [hyperfiniteApproxSubspace, coe_mem_internalSubmodule] at hx
  rw [domHyperlinearExt, coe_mem_internalSubmodule]
  exact hx.mono fun F hF ↦ Submodule.mem_sup_right hF

theorem stdElem_mem_domHyperlinearExt {E : Type*} [AddCommGroup E] [Module ℝ E]
    (M : Submodule ℝ E) (x : E) :
    stdElem x ∈ domHyperlinearExt M :=
  hyperfiniteApproxSubspace_le_domHyperlinearExt M (stdElem_mem_hyperfiniteApproxSubspace x)

/-- Goldblatt §19.10–19.11 (pp. 277–278), **Exercise 19.11(2)**: The **hyperlinear functional**
`f⁺ = hyperlinearExtension hp hf : ↥(domHyperlinearExt M) →ₗ[StarReal E] StarReal E` obtained by
assembling finite-dimensional Hahn–Banach extensions over `fineUltrafilter E`! -/
abbrev hyperlinearExtension {E : Type*} [AddCommGroup E] [Module ℝ E]
    {p : E → ℝ} (hp : IsSublinear p) {M : Submodule ℝ E} {f : M →ₗ[ℝ] ℝ}
    (hf : IsDominatedBy M f p) :
    ↥(domHyperlinearExt M) →ₗ[StarReal E] StarReal E :=
  liftInternalLinearFunctional (fineUltrafilter E : Filter (Finset E))
    (fun F ↦ M ⊔ spanAt F)
    (fun F ↦ (hahn_banach_finset hp hf F).choose)

/-- **Exercise 19.11(2)** (Goldblatt §19.10–19.11, pp. 277–278): Full verification of the four
transfer properties of `f⁺ = hyperlinearExtension hp hf`:
1. `dom f⁺ = domHyperlinearExt M` is a `*ℝ_E`-subspace of `StarElem E` containing `E` (and `V⁺`).
2. `f⁺` is **hyperlinear** (`*ℝ_E`-linear: additive and homogeneous for `*ℝ_E` scalars).
3. `f⁺` **extends `f`** on `M`: `f⁺(stdElem m) = (f m : StarReal E)` for all `m : M`.
4. `f⁺` is **dominated by `*p`** (`Germ.map p`): for every `z ∈ dom f⁺`,
   `-(Germ.map p (-z.1)) ≤ f⁺ z ∧ f⁺ z ≤ Germ.map p z.1`, and hence on standard `x : E`,
   `(-p (-x) : StarReal E) ≤ f⁺(stdElem x) ≤ (p x : StarReal E)`! -/
theorem exercise_19_11_2_hyperlinearExtension_properties {E : Type*} [AddCommGroup E] [Module ℝ E]
    {p : E → ℝ} (hp : IsSublinear p) {M : Submodule ℝ E} {f : M →ₗ[ℝ] ℝ}
    (hf : IsDominatedBy M f p) :
    let fPlus := hyperlinearExtension hp hf
    (∀ x : E, stdElem x ∈ domHyperlinearExt M) ∧
      (∀ (c : StarReal E) (z₁ z₂ : ↥(domHyperlinearExt M)),
        fPlus (c • z₁ + z₂) = c * fPlus z₁ + fPlus z₂) ∧
      (∀ m : M,
        fPlus ⟨stdElem (m : E), stdElem_mem_domHyperlinearExt M (m : E)⟩ =
          (f m : StarReal E)) ∧
      (∀ z : ↥(domHyperlinearExt M),
        -(Germ.map p (-z.1)) ≤ fPlus z ∧ fPlus z ≤ Germ.map p z.1) := by
  intro fPlus
  refine ⟨stdElem_mem_domHyperlinearExt M, ?_, ?_, ?_⟩
  · intro c z₁ z₂
    rw [map_add, map_smul, smul_eq_mul]
  · intro m
    change ((fun F ↦ evalSubmoduleOrZero (M ⊔ spanAt F)
      (hahn_banach_finset hp hf F).choose (m : E)) : StarReal E) =
      ((fun _ : Finset E ↦ f m) : StarReal E)
    refine Germ.coe_eq.mpr (Eventually.of_forall fun F ↦ ?_)
    have hmF : (m : E) ∈ M ⊔ spanAt F := Submodule.mem_sup_left m.2
    dsimp only []
    rw [evalSubmoduleOrZero_of_mem _ hmF]
    exact (hahn_banach_finset hp hf F).choose_spec.1 m
  · rintro ⟨x, hx⟩
    induction x using Germ.inductionOn with | _ u =>
    have hx' : ∀ᶠ F in (fineUltrafilter E : Filter (Finset E)), u F ∈ M ⊔ spanAt F :=
      coe_mem_internalSubmodule.mp hx
    change -(Germ.map p (-((u : StarElem E)))) ≤
        ((fun F ↦ evalSubmoduleOrZero (M ⊔ spanAt F)
          (hahn_banach_finset hp hf F).choose (u F)) : StarReal E) ∧
      ((fun F ↦ evalSubmoduleOrZero (M ⊔ spanAt F)
        (hahn_banach_finset hp hf F).choose (u F)) : StarReal E) ≤
        Germ.map p (u : StarElem E)
    rw [← Germ.coe_neg, Germ.map_coe, Germ.map_coe, ← Germ.coe_neg]
    constructor
    · refine Germ.coe_le.mpr (hx'.mono fun F huF ↦ ?_)
      dsimp only [Function.comp_apply, Pi.neg_apply]
      rw [evalSubmoduleOrZero_of_mem _ huF]
      exact (hahn_banach_finset hp hf F).choose_spec.2.neg_le ⟨u F, huF⟩
    · refine Germ.coe_le.mpr (hx'.mono fun F huF ↦ ?_)
      dsimp only [Function.comp_apply]
      rw [evalSubmoduleOrZero_of_mem _ huF]
      exact (hahn_banach_finset hp hf F).choose_spec.2 ⟨u F, huF⟩

/-- Goldblatt §19.10 (pp. 276–278): **The Nonstandard Hahn–Banach Extension Theorem**.
Let `p : E → ℝ` be a positively homogeneous and subadditive (`IsSublinear`) functional on a real
vector space `E`, and let `f : M →ₗ[ℝ] ℝ` be a linear functional on a subspace `M ≤ E` dominated by
`p`. Defining `g(x) := sh(f⁺(stdElem x))` via the hyperlinear extension `f⁺` and the ultrapower
shadow functional `shadowGermLinearMap (fineUltrafilter E)` produces a global linear functional
`g : E →ₗ[ℝ] ℝ` that extends `f` and is dominated by `p`! -/
theorem hahn_banach_extension {E : Type*} [AddCommGroup E] [Module ℝ E]
    {p : E → ℝ} (hp : IsSublinear p) {M : Submodule ℝ E} {f : M →ₗ[ℝ] ℝ}
    (hf : IsDominatedBy M f p) :
    ∃ g : E →ₗ[ℝ] ℝ,
      (∀ m : M, g (m : E) = f m) ∧
      (∀ x : E, g x ≤ p x) := by
  let fPlus := hyperlinearExtension hp hf
  obtain ⟨_, _, hfPlus_ext, hfPlus_dom⟩ := exercise_19_11_2_hyperlinearExtension_properties hp hf
  -- `stdToDom : E →ₗ[ℝ] domHyperlinearExt M` embeds standard `E` linearly into `dom f⁺`
  let stdToDom : E →ₗ[ℝ] ↥(domHyperlinearExt M) :=
    { toFun := fun x ↦ ⟨stdElem x, stdElem_mem_domHyperlinearExt M x⟩
      map_add' := fun _ _ ↦ Subtype.ext rfl
      map_smul' := fun _ _ ↦ Subtype.ext rfl }
  -- Compose with `f⁺` restricted to standard `ℝ` scalars
  let rawHyperEval : E →ₗ[ℝ] StarReal E :=
    (fPlus.restrictScalars ℝ).comp stdToDom
  -- Every `rawHyperEval x` is sandwiched between `-p(-x)` and `p(x)`, hence limited!
  have hSandwiched : ∀ x : E,
      ((-p (-x) : ℝ) : StarReal E) ≤ rawHyperEval x ∧
        rawHyperEval x ≤ ((p x : ℝ) : StarReal E) :=
    fun x ↦ hfPlus_dom (stdToDom x)
  have hLimited : ∀ x : E, rawHyperEval x ∈ LimitedGermSubmodule (fineUltrafilter E) :=
    fun x ↦ isLimitedGerm_of_sandwiched (fineUltrafilter E) (hSandwiched x).1 (hSandwiched x).2
  -- Take shadows: `g := sh ∘ rawHyperEval : E →ₗ[ℝ] ℝ`
  let g : E →ₗ[ℝ] ℝ :=
    (shadowGermLinearMap (fineUltrafilter E)).comp
      (rawHyperEval.codRestrict (LimitedGermSubmodule (fineUltrafilter E)) hLimited)
  refine ⟨g, ?_, ?_⟩
  · intro m
    change shadowGerm (fineUltrafilter E) (rawHyperEval (m : E)) = f m
    have hm_eq : rawHyperEval (m : E) = (f m : StarReal E) := hfPlus_ext m
    rw [hm_eq, shadowGerm_const]
  · intro x
    change shadowGerm (fineUltrafilter E) (rawHyperEval x) ≤ p x
    exact shadowGerm_le_of_le_const (fineUltrafilter E) (hLimited x) (hSandwiched x).2

/-! ### Exercise 19.11(3)(a)–(c): Luxemburg's Direct Ultrapower Proof of Hahn–Banach (p. 278) -/

/-- Index type `I = PartialDomExtension M f p` of all partial linear extensions `(W, h)` of `f`
dominated by `p` on subspaces `M ≤ W ≤ E` (W. A. J. Luxemburg, Goldblatt Exercise 19.11(3),
p. 278). -/
structure PartialDomExtension {E : Type*} [AddCommGroup E] [Module ℝ E]
    (M : Submodule ℝ E) (f : M →ₗ[ℝ] ℝ) (p : E → ℝ) where
  /-- Domain subspace `W` of the partial extension. -/
  W : Submodule ℝ E
  /-- Inclusion `M ≤ W`. -/
  le_W : M ≤ W
  /-- Linear functional `h : W →ₗ[ℝ] ℝ`. -/
  h : W →ₗ[ℝ] ℝ
  /-- `h` extends `f` on `M`. -/
  extends_f : ∀ m : M, h ⟨(m : E), le_W m.2⟩ = f m
  /-- `h` is dominated by `p` on `W`. -/
  dominated : IsDominatedBy W h p

/-- `A_x = {i ∈ I : x ∈ dom f_i}` (Luxemburg, Goldblatt Exercise 19.11(3), p. 278). -/
def luxemburgSet {E : Type*} [AddCommGroup E] [Module ℝ E]
    (M : Submodule ℝ E) (f : M →ₗ[ℝ] ℝ) (p : E → ℝ) (x : E) :
    Set (PartialDomExtension M f p) :=
  {i | x ∈ i.W}

/-- `r_x : I → ℝ` equal to `f_i(x)` on `A_x` and `0` outside `A_x`
(Luxemburg, Goldblatt Exercise 19.11(3), p. 278). -/
def luxemburgSeq {E : Type*} [AddCommGroup E] [Module ℝ E]
    (M : Submodule ℝ E) (f : M →ₗ[ℝ] ℝ) (p : E → ℝ) (x : E) :
    PartialDomExtension M f p → ℝ :=
  fun i ↦ evalSubmoduleOrZero i.W i.h x

/-- **Exercise 19.11(3)(a)** (Goldblatt §19.11, p. 278): The family `{A_x : x ∈ E}` has the
**finite intersection property** (for every `S : Finset E`, `⋂ x ∈ S, A_x` is nonempty), and hence
generates a proper filter extendable to an ultrafilter `F` on `PartialDomExtension M f p`! -/
theorem exercise_19_11_3_a_fip {E : Type*} [AddCommGroup E] [Module ℝ E]
    {p : E → ℝ} (hp : IsSublinear p) {M : Submodule ℝ E} {f : M →ₗ[ℝ] ℝ}
    (hf : IsDominatedBy M f p) :
    (∀ S : Finset E, (⋂ x ∈ S, luxemburgSet M f p x).Nonempty) ∧
      ∃ U : Ultrafilter (PartialDomExtension M f p),
        ∀ x : E, luxemburgSet M f p x ∈ U := by
  have hfip : ∀ S : Finset E, (⋂ x ∈ S, luxemburgSet M f p x).Nonempty := by
    intro S
    obtain ⟨hS, hhS_ext, hhS_dom⟩ := hahn_banach_finset hp hf S
    refine ⟨{
      W := M ⊔ spanAt S
      le_W := le_sup_left
      h := hS
      extends_f := hhS_ext
      dominated := hhS_dom
    }, ?_⟩
    rw [Set.mem_iInter₂]
    intro x hxS
    exact Submodule.mem_sup_right (Submodule.subset_span hxS)
  refine ⟨hfip, ?_⟩
  let gen := Filter.generate (Set.range (luxemburgSet M f p))
  have : Filter.NeBot gen := by
    rw [Filter.generate_neBot_iff]
    intro Y hY hYfin
    classical
    -- Pull each `B ∈ hYfin.toFinset` back to an `x_B : E`
    have hex : ∀ B : Set (PartialDomExtension M f p),
        B ∈ Set.range (luxemburgSet M f p) → ∃ x : E, luxemburgSet M f p x = B :=
      fun _ h ↦ h
    let pickX : {B // B ∈ hYfin.toFinset} → E :=
      fun B ↦ (hex B.1 (hY (hYfin.mem_toFinset.mp B.2))).choose
    let S : Finset E := Finset.univ.image pickX
    obtain ⟨i₀, hi₀⟩ := hfip S
    refine ⟨i₀, ?_⟩
    rw [Set.mem_sInter]
    intro B hBY
    have hBmem : B ∈ hYfin.toFinset := hYfin.mem_toFinset.mpr hBY
    have hpick : luxemburgSet M f p (pickX ⟨B, hBmem⟩) = B :=
      (hex B (hY hBY)).choose_spec
    have hxS : pickX ⟨B, hBmem⟩ ∈ S :=
      Finset.mem_image.mpr ⟨⟨B, hBmem⟩, Finset.mem_univ _, rfl⟩
    rw [← hpick]
    exact (Set.mem_iInter₂.mp hi₀) _ hxS
  exact ⟨Ultrafilter.of gen, fun x ↦
    Ultrafilter.of_le gen (Filter.mem_generate_of_mem ⟨x, rfl⟩)⟩

/-- **Exercise 19.11(3)(b)** (Goldblatt §19.11, p. 278): Given any ultrafilter `U` on
`PartialDomExtension M f p` containing `{A_x : x ∈ E}`, the map `f# (x) := [r_x]` defines a real
linear map `E →ₗ[ℝ] Germ U ℝ` extending `f` and sandwiched between `-p(-x)` and `p(x)`! -/
def luxemburgFSharp {E : Type*} [AddCommGroup E] [Module ℝ E]
    (M : Submodule ℝ E) (f : M →ₗ[ℝ] ℝ) (p : E → ℝ)
    (U : Ultrafilter (PartialDomExtension M f p))
    (hU : ∀ x : E, luxemburgSet M f p x ∈ U) :
    E →ₗ[ℝ] Germ (U : Filter (PartialDomExtension M f p)) ℝ where
  toFun x := (luxemburgSeq M f p x : Germ (U : Filter (PartialDomExtension M f p)) ℝ)
  map_add' x y := by
    rw [← Germ.coe_add]
    have hxU : ∀ᶠ i in (U : Filter (PartialDomExtension M f p)), x ∈ i.W := hU x
    have hyU : ∀ᶠ i in (U : Filter (PartialDomExtension M f p)), y ∈ i.W := hU y
    refine Germ.coe_eq.mpr ((hxU.and hyU).mono fun i ⟨hxi, hyi⟩ ↦ ?_)
    have hxyi : x + y ∈ i.W := i.W.add_mem hxi hyi
    dsimp only [luxemburgSeq, Pi.add_apply]
    rw [evalSubmoduleOrZero_of_mem i.h hxyi, evalSubmoduleOrZero_of_mem i.h hxi,
      evalSubmoduleOrZero_of_mem i.h hyi, ← i.h.map_add]
    rfl
  map_smul' c x := by
    change (luxemburgSeq M f p (c • x) : Germ (U : Filter (PartialDomExtension M f p)) ℝ) =
      ((fun _ : PartialDomExtension M f p ↦ c) :
        Germ (U : Filter (PartialDomExtension M f p)) ℝ) •
        (luxemburgSeq M f p x : Germ (U : Filter (PartialDomExtension M f p)) ℝ)
    rw [← Germ.coe_smul']
    have hxU : ∀ᶠ i in (U : Filter (PartialDomExtension M f p)), x ∈ i.W := hU x
    refine Germ.coe_eq.mpr (hxU.mono fun i hxi ↦ ?_)
    have hcxi : c • x ∈ i.W := i.W.smul_mem c hxi
    change evalSubmoduleOrZero i.W i.h (c • x) = c * evalSubmoduleOrZero i.W i.h x
    rw [evalSubmoduleOrZero_of_mem i.h hcxi, evalSubmoduleOrZero_of_mem i.h hxi]
    exact i.h.map_smul c ⟨x, hxi⟩

/-- **Exercise 19.11(3)(b)–(c)** (Goldblatt §19.11, p. 278): **Luxemburg's Direct Ultrapower Proof**
of the Hahn–Banach Theorem from `luxemburgFSharp` and `shadowGermLinearMap U`! -/
theorem exercise_19_11_3_c_hahn_banach_luxemburg {E : Type*} [AddCommGroup E] [Module ℝ E]
    {p : E → ℝ} (hp : IsSublinear p) {M : Submodule ℝ E} {f : M →ₗ[ℝ] ℝ}
    (hf : IsDominatedBy M f p) :
    ∃ g : E →ₗ[ℝ] ℝ,
      (∀ m : M, g (m : E) = f m) ∧
      (∀ x : E, g x ≤ p x) := by
  obtain ⟨_, U, hU⟩ := exercise_19_11_3_a_fip hp hf
  let fSharp := luxemburgFSharp M f p U hU
  have hBounds : ∀ x : E,
      ((-p (-x) : ℝ) : Germ (U : Filter (PartialDomExtension M f p)) ℝ) ≤ fSharp x ∧
        fSharp x ≤ ((p x : ℝ) : Germ (U : Filter (PartialDomExtension M f p)) ℝ) := by
    intro x
    have hxU : ∀ᶠ i in (U : Filter (PartialDomExtension M f p)), x ∈ i.W := hU x
    constructor
    · refine Germ.coe_le.mpr (hxU.mono fun i hxi ↦ ?_)
      dsimp only [luxemburgSeq]
      rw [evalSubmoduleOrZero_of_mem i.h hxi]
      exact i.dominated.neg_le ⟨x, hxi⟩
    · refine Germ.coe_le.mpr (hxU.mono fun i hxi ↦ ?_)
      dsimp only [luxemburgSeq]
      rw [evalSubmoduleOrZero_of_mem i.h hxi]
      exact i.dominated ⟨x, hxi⟩
  have hLim : ∀ x : E, fSharp x ∈ LimitedGermSubmodule U :=
    fun x ↦ isLimitedGerm_of_sandwiched U (hBounds x).1 (hBounds x).2
  let g : E →ₗ[ℝ] ℝ :=
    (shadowGermLinearMap U).comp (fSharp.codRestrict (LimitedGermSubmodule U) hLim)
  refine ⟨g, ?_, ?_⟩
  · intro m
    change shadowGerm U (fSharp (m : E)) = f m
    have hm_eq : fSharp (m : E) =
        (f m : Germ (U : Filter (PartialDomExtension M f p)) ℝ) := by
      refine Germ.coe_eq.mpr (Eventually.of_forall fun i ↦ ?_)
      dsimp only [luxemburgSeq]
      rw [evalSubmoduleOrZero_of_mem i.h (i.le_W m.2)]
      exact i.extends_f m
    rw [hm_eq, shadowGerm_const]
  · intro x
    change shadowGerm U (fSharp x) ≤ p x
    exact shadowGerm_le_of_le_const U (hLim x) (hBounds x).2

/-! ### Normed-Space Corollaries of our Nonstandard Hahn–Banach Theorem (§19.10) -/

/-- **Symmetric / Seminorm Hahn–Banach Theorem** derived directly from our nonstandard
`hahn_banach_extension`: if `p` is sublinear and symmetric (`p (-x) = p x`) and `|f m| ≤ p m` on
`M`, then `f` extends to `g : E →ₗ[ℝ] ℝ` with `|g x| ≤ p x` for all `x ∈ E`! -/
theorem hahn_banach_symmetric {E : Type*} [AddCommGroup E] [Module ℝ E]
    {p : E → ℝ} (hp : IsSublinear p) (hsym : ∀ x : E, p (-x) = p x)
    {M : Submodule ℝ E} {f : M →ₗ[ℝ] ℝ} (hf : ∀ m : M, |f m| ≤ p (m : E)) :
    ∃ g : E →ₗ[ℝ] ℝ,
      (∀ m : M, g (m : E) = f m) ∧
      (∀ x : E, |g x| ≤ p x) := by
  have hf_dom : IsDominatedBy M f p := fun m ↦ (le_abs_self (f m)).trans (hf m)
  obtain ⟨g, hg_ext, hg_le⟩ := hahn_banach_extension hp hf_dom
  refine ⟨g, hg_ext, fun x ↦ abs_le.mpr ⟨?_, hg_le x⟩⟩
  have hneg := hg_le (-x)
  rw [map_neg, hsym] at hneg
  linarith

/-- **Norm-Preserving Hahn–Banach Extension Theorem** for real normed spaces, proved directly from
our nonstandard `hahn_banach_symmetric` (with zero calls to Mathlib's `HahnBanach`): every
continuous linear functional `f : M →L[ℝ] ℝ` on a subspace `M ≤ E` extends to a continuous linear
functional `g : E →L[ℝ] ℝ` with `‖g‖ = ‖f‖`! -/
theorem hahn_banach_norm_preserving {E : Type*} [SeminormedAddCommGroup E] [NormedSpace ℝ E]
    (M : Submodule ℝ E) (f : M →L[ℝ] ℝ) :
    ∃ g : E →L[ℝ] ℝ, (∀ m : M, g (m : E) = f m) ∧ ‖g‖ = ‖f‖ := by
  let p : E → ℝ := fun x ↦ ‖f‖ * ‖x‖
  have hp : IsSublinear p := by
    refine ⟨?_, ?_⟩
    · intro c hc x
      simp only [p, norm_smul, Real.norm_eq_abs, abs_of_nonneg hc]
      ring
    · intro x y
      simp only [p]
      calc ‖f‖ * ‖x + y‖ ≤ ‖f‖ * (‖x‖ + ‖y‖) :=
            mul_le_mul_of_nonneg_left (norm_add_le x y) (norm_nonneg f)
        _ = ‖f‖ * ‖x‖ + ‖f‖ * ‖y‖ := mul_add _ _ _
  have hsym : ∀ x : E, p (-x) = p x := fun x ↦ by simp [p, norm_neg]
  have hf_bound : ∀ m : M, |f.toLinearMap m| ≤ p (m : E) := by
    intro m
    change |f m| ≤ ‖f‖ * ‖m‖
    simpa only [Real.norm_eq_abs] using f.le_opNorm m
  obtain ⟨g₀, hg₀_ext, hg₀_bound⟩ := hahn_banach_symmetric hp hsym hf_bound
  have hg₀_norm : ∀ x : E, ‖g₀ x‖ ≤ ‖f‖ * ‖x‖ := by
    intro x
    simpa only [Real.norm_eq_abs, p] using hg₀_bound x
  let g : E →L[ℝ] ℝ := g₀.mkContinuous ‖f‖ hg₀_norm
  refine ⟨g, hg₀_ext, le_antisymm ?_ ?_⟩
  · exact g₀.mkContinuous_norm_le (norm_nonneg f) hg₀_norm
  · refine ContinuousLinearMap.opNorm_le_bound f (norm_nonneg g) fun m ↦ ?_
    have heq : f m = g (m : E) := (hg₀_ext m).symm
    rw [heq]
    exact g.le_opNorm (m : E)

/-- **Dual Vector Existence Corollary** of our nonstandard Hahn–Banach Theorem: for every vector
`x : E` with `‖x‖ ≠ 0`, there exists a continuous linear functional `g : E →L[ℝ] ℝ` with
`‖g‖ = 1` and `g x = ‖x‖`! -/
theorem exists_dual_vector_norm {E : Type*} [SeminormedAddCommGroup E] [NormedSpace ℝ E]
    {x : E} (hx : ‖x‖ ≠ 0) :
    ∃ g : E →L[ℝ] ℝ, ‖g‖ = 1 ∧ g x = ‖x‖ := by
  have hx_pos : 0 < ‖x‖ := lt_of_le_of_ne (norm_nonneg x) hx.symm
  let M : Submodule ℝ E := Submodule.span ℝ ({x} : Set E)
  have hSpan : ∀ m : M, ∃ t : ℝ, t • x = (m : E) :=
    fun m ↦ Submodule.mem_span_singleton.mp m.2
  have hUnique : ∀ t₁ t₂ : ℝ, t₁ • x = t₂ • x → t₁ = t₂ := by
    intro t₁ t₂ heq
    have h0 : (t₁ - t₂) • x = 0 := by rw [sub_smul, sub_eq_zero]; exact heq
    have hnorm : |t₁ - t₂| * ‖x‖ = 0 := by
      simpa only [norm_smul, Real.norm_eq_abs, norm_zero] using congrArg norm h0
    rcases mul_eq_zero.mp hnorm with habs | hnx
    · exact sub_eq_zero.mp (abs_eq_zero.mp habs)
    · exact (hx hnx).elim
  let f₀Fun : M → ℝ := fun m ↦ (hSpan m).choose * ‖x‖
  have hf₀Fun : ∀ (t : ℝ) (hm : t • x ∈ M), f₀Fun ⟨t • x, hm⟩ = t * ‖x‖ := by
    intro t hm
    have ht := hUnique (hSpan ⟨t • x, hm⟩).choose t (hSpan ⟨t • x, hm⟩).choose_spec
    change (hSpan ⟨t • x, hm⟩).choose * ‖x‖ = t * ‖x‖
    rw [ht]
  let f₀ : M →ₗ[ℝ] ℝ := {
    toFun := f₀Fun
    map_add' := fun m₁ m₂ ↦ by
      obtain ⟨t₁, hm₁⟩ := hSpan m₁
      obtain ⟨t₂, hm₂⟩ := hSpan m₂
      have heq₁ : m₁ = ⟨t₁ • x, hm₁.symm ▸ m₁.2⟩ := Subtype.ext hm₁.symm
      have heq₂ : m₂ = ⟨t₂ • x, hm₂.symm ▸ m₂.2⟩ := Subtype.ext hm₂.symm
      have hsum : ((m₁ + m₂ : M) : E) = (t₁ + t₂) • x := by
        simp only [Submodule.coe_add, ← hm₁, ← hm₂, add_smul]
      have heq₁₂ : m₁ + m₂ = ⟨(t₁ + t₂) • x, hsum ▸ (m₁ + m₂).2⟩ := Subtype.ext hsum
      rw [heq₁₂, hf₀Fun (t₁ + t₂), heq₁, hf₀Fun t₁, heq₂, hf₀Fun t₂]
      ring
    map_smul' := fun c m ↦ by
      obtain ⟨t, hm⟩ := hSpan m
      have heq : m = ⟨t • x, hm.symm ▸ m.2⟩ := Subtype.ext hm.symm
      have hsmul : ((c • m : M) : E) = (c * t) • x := by
        simp only [SetLike.val_smul, ← hm, mul_smul]
      have heqc : c • m = ⟨(c * t) • x, hsmul ▸ (c • m).2⟩ := Subtype.ext hsmul
      rw [heqc, hf₀Fun (c * t), heq, hf₀Fun t, RingHom.id_apply, smul_eq_mul]
      ring
  }
  have hp : IsSublinear (norm : E → ℝ) :=
    ⟨fun c hc y ↦ by simp [norm_smul, Real.norm_eq_abs, abs_of_nonneg hc], norm_add_le⟩
  have hsym : ∀ y : E, ‖-y‖ = ‖y‖ := norm_neg
  have hf₀_bound : ∀ m : M, |f₀ m| ≤ ‖(m : E)‖ := by
    intro m
    obtain ⟨t, hm⟩ := hSpan m
    have heq : m = ⟨t • x, hm.symm ▸ m.2⟩ := Subtype.ext hm.symm
    change |f₀Fun m| ≤ ‖(m : E)‖
    rw [← hm, heq, hf₀Fun t, abs_mul, abs_of_nonneg (norm_nonneg x), norm_smul, Real.norm_eq_abs]
  obtain ⟨g₀, hg₀_ext, hg₀_bound⟩ := hahn_banach_symmetric hp hsym hf₀_bound
  let g : E →L[ℝ] ℝ := g₀.mkContinuous 1 fun y ↦ by
    simpa only [Real.norm_eq_abs, one_mul] using hg₀_bound y
  have hgx : g x = ‖x‖ := by
    have hxM : x ∈ M := Submodule.subset_span (Set.mem_singleton x)
    change g₀ x = ‖x‖
    rw [hg₀_ext ⟨x, hxM⟩]
    have hx1 : (⟨x, hxM⟩ : M) = ⟨(1 : ℝ) • x, by simpa using hxM⟩ := by
      apply Subtype.ext; simp
    change f₀Fun ⟨x, hxM⟩ = ‖x‖
    rw [hx1, hf₀Fun 1, one_mul]
  refine ⟨g, le_antisymm ?_ ?_, hgx⟩
  · exact g₀.mkContinuous_norm_le zero_le_one _
  · have hle : 1 * ‖x‖ ≤ ‖g‖ * ‖x‖ :=
      calc 1 * ‖x‖ = ‖g x‖ := by
            rw [one_mul, hgx, Real.norm_of_nonneg (norm_nonneg x)]
        _ ≤ ‖g‖ * ‖x‖ := g.le_opNorm x
    exact le_of_mul_le_mul_right hle hx_pos

/-- **Point Separation by Continuous Linear Functionals** in any real normed space `E`, proved from
our nonstandard Hahn–Banach Theorem: if `x ≠ y` in `E`, there exists `g : E →L[ℝ] ℝ` with
`‖g‖ = 1` and `g x ≠ g y`! -/
theorem separating_dual_of_ne {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    {x y : E} (hxy : x ≠ y) :
    ∃ g : E →L[ℝ] ℝ, ‖g‖ = 1 ∧ g x ≠ g y := by
  have hnorm : ‖x - y‖ ≠ 0 := norm_ne_zero_iff.mpr (sub_ne_zero.mpr hxy)
  obtain ⟨g, hg_norm, hg_sub⟩ := exists_dual_vector_norm hnorm
  refine ⟨g, hg_norm, fun heq ↦ hnorm ?_⟩
  rw [← hg_sub, map_sub, heq, sub_self]

end NonstandardHahnBanach

