import Mathlib.Algebra.Order.Archimedean.Real.Basic
import Mathlib.Basic.Real.Basic
import Mathlib.Order.Filter.Cofinite
import Mathlib.Order.Filter.Ultrafilter.Defs
import Mathlib.Order.Zorn

/-!
# Chapter 2: Large Sets (Goldblatt, *Lectures on the Hyperreals*, pp. 15–22)

This module formalizes Chapter 2 of Robert Goldblatt's *Lectures on the Hyperreals:
An Introduction to Nonstandard Analysis* (GTM 188, Springer, 1998).

## Overview of Contents

* **§2.1–2.2 Infinitesimals as Variable Quantities & Largeness** (pp. 15–17):
  * Motivating distinct real sequences agreeing cofinitely (`seqOneTwoThree`, `seqTwoTwoThree`).
  * Agreement sets `E_{rs}` (`agreementSet`) and strict comparison sets `L_{rs}` (`lessThanSet`),
    together with reflexivity, symmetry, and transitivity inclusion
    `agreementSet r s ∩ agreementSet s t ⊆ agreementSet r t`.
  * Alternating sequences `altEven = (1, 0, 1, 0, ...)` and `altOdd = (0, 1, 0, 1, ...)` (p. 17):
    their agreement set is empty, their comparison sets are `{n | ¬ Even n}` and `{n | Even n}`,
    and neither comparison set is cofinite—motivating the ultrafilter dichotomy.

* **§2.3 Filters and Ultrafilters** (p. 18):
  * `SetFilter`: concrete set-theoretic filter structure ordered by set inclusion `⊆`.
  * Membership of `Set.univ` (`univ_mem`), improper filter characterization
    (`empty_mem_iff_eq_univ`), properness (`SetFilter.IsProper`), smallest filter `{I}`
    (`indiscreteSetFilter` / `botFilter`), largest filter `𝒫(I)` (`powerSetFilter`),
    and ultrafilter predicate (`SetFilter.IsUltrafilter`) with subtype `SetUltrafilter`.
  * Explicit computable equivalences with Mathlib's `Filter` and `Ultrafilter`:
    `SetFilter.equivFilter`, `SetFilter.orderIsoFilterDual`, and
    `SetUltrafilter.equivUltrafilter`.

* **§2.4 Examples of Filters (1)–(4)** (p. 18):
  * (1) Principal ultrafilter `principalFilter i` (`F_i = {A ⊆ I : i ∈ A}`).
  * (2) Cofinite / Fréchet filter `cofiniteSetFilter I` (`F^{co}`): proper iff `Infinite I`,
    and never an ultrafilter (`not_isUltrafilter_cofiniteSetFilter_nat` and general `I`).
  * (3) Filter generated by a collection `H ⊆ 𝒫(I)` (`generatedSetFilter H`) and principal filter
    generated by a set `B ⊆ I` (`principalSetFilterOfSet B`).
  * (4) Union of a nonempty chain of filters (`chainUnionFilter` and `indexedChainUnionFilter`),
    preserving properness.

* **§2.5 Facts About Filters (1)–(8)** (p. 19):
  * Fact (1): Equivalence of filter axioms with `Set.univ ∈ S ∧ ∀ A B, A ∩ B ∈ S ↔ A ∈ S ∧ B ∈ S`.
  * Fact (2): For upward-closed `S`, `S.Nonempty ↔ Set.univ ∈ S`; hence `{Set.univ} ⊆ F.sets`.
  * Fact (3): Ultrafilter characterizations for `A ∩ B ∈ F`, `A ∪ B ∈ F`, and `Aᶜ ∈ F`.
  * Fact (4): Pairwise disjoint finite cover `(⋃ k : Fin n, A k) ∈ F` yields `∃! k, A k ∈ F`.
  * Fact (5): An ultrafilter containing a finite set is principal; hence every nonprincipal
    ultrafilter extends the cofinite filter `cofiniteSetFilter I`.
  * Fact (6): `F.IsUltrafilter ↔ Maximal SetFilter.IsProper F`.
  * Fact (7): Finite intersection property (`HasFIP`) and
    `(generatedSetFilter H).IsProper ↔ HasFIP H`.
  * Fact (8): `HasFIP H → ∀ A, HasFIP (insert A H) ∨ HasFIP (insert Aᶜ H)`.

* **§2.6 Zorn's Lemma, Ultrafilter Theorem & Nonprincipal Ultrafilters** (pp. 19–21):
  * **Theorem 2.6.1** (`exists_ultrafilter_extending_fip`): proved directly via `zorn_le` on proper
    filters extending `H`.
  * **Corollary 2.6.2** (`exists_nonprincipal_ultrafilter`): every infinite type admits a
    nonprincipal ultrafilter.

* **§2.7 Exercises on Filters (1)–(5)** (p. 21):
  * Exercise (1): Every nonempty set belongs to an ultrafilter
    (`exists_ultrafilter_mem_of_nonempty`).
  * Exercise (2): Existence of a nonprincipal ultrafilter on `ℕ` containing `{n | Even n}` and
    another containing `{n | Odd n}` (`exists_nonprincipal_ultrafilter_even`,
    `exists_nonprincipal_ultrafilter_odd`).
  * Exercise (3): Every ultrafilter on a finite type is principal
    (`exists_eq_principalFilter_of_finite`).
  * Exercise (4)(i)–(ii): `H ⊆ (generatedSetFilter H).sets` and minimality
    `H ⊆ G.sets → generatedSetFilter H ≤ G`.
  * Exercise (5)(i)–(ii): For proper `F`, `HasFIP (insert Aᶜ F.sets) ↔ A ∉ F`, and deduction of
    `F.IsUltrafilter ↔ Maximal SetFilter.IsProper F`.
-/

set_option relaxedAutoImplicit false

namespace Goldblatt

namespace Ch02

/-!
## §2.1 & §2.2 — Infinitesimals as Variable Quantities & Largeness (Goldblatt pp. 15–17)
-/

/-- Cauchy's motivating vanishing sequence `(1, 1/2, 1/3, 1/4, ...)` (0-indexed as `1 / (n + 1)`)
from Goldblatt §2.1 (p. 16). -/
noncomputable def harmonicSeq (n : ℕ) : ℝ :=
  1 / ((n : ℝ) + 1)

/-- Cauchy's second vanishing sequence `(1/2, 1/4, 1/6, 1/8, ...)` from Goldblatt §2.1 (p. 16),
which converges twice as quickly as `harmonicSeq`. -/
noncomputable def halfHarmonicSeq (n : ℕ) : ℝ :=
  1 / (2 * ((n : ℝ) + 1))

/-- Pointwise, `halfHarmonicSeq` is half of `harmonicSeq` (Goldblatt §2.1, p. 16). -/
theorem halfHarmonicSeq_eq_half_mul (n : ℕ) :
    halfHarmonicSeq n = (1 / 2 : ℝ) * harmonicSeq n := by
  simp only [halfHarmonicSeq, harmonicSeq, one_div, mul_inv_rev]
  rw [mul_comm]

/-- `harmonicSeq` vanishes in Cauchy's sense (`lim_{n → ∞} r_n = 0`, Goldblatt §2.1, pp. 15–16). -/
theorem harmonicSeq_vanishes :
    ∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ n : ℕ, N ≤ n → |harmonicSeq n| < ε := by
  intro ε hε
  obtain ⟨N, hN⟩ := exists_nat_gt (1 / ε)
  refine ⟨N, fun n hn ↦ ?_⟩
  have hn_pos : (0 : ℝ) < (n : ℝ) + 1 := Nat.cast_add_one_pos n
  rw [harmonicSeq, abs_of_pos (one_div_pos.mpr hn_pos), one_div_lt hn_pos hε]
  exact hN.trans (lt_of_le_of_lt (Nat.cast_le.mpr hn) (lt_add_one (n : ℝ)))

/-- The sequence `(1, 2, 3, 4, ...)` (0-indexed as `n ↦ n + 1`) from Goldblatt §2.1 (p. 16). -/
def seqOneTwoThree (n : ℕ) : ℝ :=
  (n : ℝ) + 1

/-- The sequence `(2, 4, 6, 8, ...)` from Goldblatt §2.1 (p. 16), which diverges twice as fast
as `seqOneTwoThree`. -/
def seqTwoFourSix (n : ℕ) : ℝ :=
  2 * ((n : ℝ) + 1)

/-- Pointwise, `seqTwoFourSix` is twice `seqOneTwoThree` (Goldblatt §2.1, p. 16). -/
theorem seqTwoFourSix_eq_two_mul (n : ℕ) :
    seqTwoFourSix n = 2 * seqOneTwoThree n :=
  rfl

/-- `seqOneTwoThree` diverges to `+∞` (`lim_{n → ∞} r_n = ∞`, Goldblatt §2.1, pp. 15–16). -/
theorem seqOneTwoThree_unbounded :
    ∀ M : ℝ, ∃ N : ℕ, ∀ n : ℕ, N ≤ n → M < seqOneTwoThree n := by
  intro M
  obtain ⟨N, hN⟩ := exists_nat_gt M
  refine ⟨N, fun n hn ↦ ?_⟩
  exact hN.trans (lt_of_le_of_lt (Nat.cast_le.mpr hn) (lt_add_one (n : ℝ)))

/-- The sequence `(2, 2, 3, 4, ...)` (0-indexed: `2` at `0`, `n + 1` for `n ≥ 1`) from
Goldblatt §2.1 (p. 16), which differs from `seqOneTwoThree` only at the first entry. -/
def seqTwoTwoThree (n : ℕ) : ℝ :=
  if n = 0 then 2 else (n : ℝ) + 1

/-- The agreement set `E_{rs} = {n : r_n = s_n}` of two sequences `r, s : ℕ → α`
(Goldblatt §2.2, p. 16). -/
def agreementSet {α : Type*} (r s : ℕ → α) : Set ℕ :=
  {n : ℕ | r n = s n}

/-- The strict comparison set `L_{rs} = {n : r_n < s_n}` of two real-valued sequences
`r, s : ℕ → ℝ` (Goldblatt §2.2, p. 17). -/
def lessThanSet (r s : ℕ → ℝ) : Set ℕ :=
  {n : ℕ | r n < s n}

@[simp]
theorem mem_agreementSet {α : Type*} {r s : ℕ → α} {n : ℕ} :
    n ∈ agreementSet r s ↔ r n = s n :=
  Iff.rfl

@[simp]
theorem mem_lessThanSet {r s : ℕ → ℝ} {n : ℕ} :
    n ∈ lessThanSet r s ↔ r n < s n :=
  Iff.rfl

/-- Distinct sequences `seqOneTwoThree` and `seqTwoTwoThree` agree on `{n | n ≠ 0}`, whose
complement `{0}` is finite (Goldblatt §2.1, p. 16). -/
theorem seqOneTwoThree_ne_seqTwoTwoThree :
    seqOneTwoThree ≠ seqTwoTwoThree ∧ (agreementSet seqOneTwoThree seqTwoTwoThree)ᶜ.Finite := by
  refine ⟨fun h ↦ ?_, ?_⟩
  · have h0 := congrFun h 0
    norm_num [seqOneTwoThree, seqTwoTwoThree] at h0
  · refine (Set.finite_singleton 0).subset ?_
    intro n hn
    simp only [Set.mem_compl_iff, mem_agreementSet, seqOneTwoThree, seqTwoTwoThree] at hn
    rw [Set.mem_singleton_iff]
    by_contra hne
    simp [hne] at hn

/-- Every sequence agrees with itself everywhere: `E_{rr} = ℕ` (Goldblatt §2.2, p. 16). -/
@[simp]
theorem agreementSet_refl {α : Type*} (r : ℕ → α) : agreementSet r r = Set.univ := by
  ext n
  simp

/-- Symmetry of agreement sets: `E_{rs} = E_{sr}` (Goldblatt §2.2, p. 16). -/
theorem agreementSet_symm {α : Type*} (r s : ℕ → α) : agreementSet r s = agreementSet s r := by
  ext n
  simp [eq_comm]

/-- Transitivity inclusion for agreement sets: `E_{rs} ∩ E_{st} ⊆ E_{rt}`
(Goldblatt §2.2, p. 17). -/
theorem agreementSet_inter_subset_trans {α : Type*} (r s t : ℕ → α) :
    agreementSet r s ∩ agreementSet s t ⊆ agreementSet r t := by
  rintro n ⟨hrs, hst⟩
  exact hrs.trans hst

/-- Pointwise trichotomy partitions `ℕ` into `E_{rs}`, `L_{rs}`, and `L_{sr}`
(Goldblatt §2.2, p. 17). -/
theorem agreementSet_union_lessThanSets (r s : ℕ → ℝ) :
    agreementSet r s ∪ lessThanSet r s ∪ lessThanSet s r = Set.univ := by
  ext n
  simp only [Set.mem_union, mem_agreementSet, mem_lessThanSet, Set.mem_univ, iff_true]
  rcases lt_trichotomy (r n) (s n) with hlt | heq | hgt
  · exact Or.inl (Or.inr hlt)
  · exact Or.inl (Or.inl heq)
  · exact Or.inr hgt

/-- `L_{rs}` and `L_{sr}` are disjoint. -/
theorem disjoint_lessThanSet_symm (r s : ℕ → ℝ) :
    Disjoint (lessThanSet r s) (lessThanSet s r) :=
  Set.disjoint_left.mpr fun _ h₁ h₂ ↦ lt_asymm (mem_lessThanSet.mp h₁) (mem_lessThanSet.mp h₂)

/-- The alternating sequence `(1, 0, 1, 0, ...)` taking value `1` on even indices and `0` on odd
indices (Goldblatt §2.2, p. 17). -/
def altEven (n : ℕ) : ℝ :=
  if Even n then (1 : ℝ) else 0

/-- The alternating sequence `(0, 1, 0, 1, ...)` taking value `0` on even indices and `1` on odd
indices (Goldblatt §2.2, p. 17). -/
def altOdd (n : ℕ) : ℝ :=
  if Even n then (0 : ℝ) else 1

/-- The agreement set of `altEven` and `altOdd` is empty, so they represent distinct equivalence
classes under any proper notion of largeness (Goldblatt §2.2, p. 17). -/
@[simp]
theorem agreementSet_altEven_altOdd : agreementSet altEven altOdd = ∅ := by
  ext n
  simp only [mem_agreementSet, altEven, altOdd, Set.mem_empty_iff_false, iff_false]
  split_ifs <;> norm_num

/-- `L_{altEven, altOdd}` is the set of non-even (odd) natural numbers (Goldblatt §2.2, p. 17). -/
theorem lessThanSet_altEven_altOdd : lessThanSet altEven altOdd = {n : ℕ | ¬ Even n} := by
  ext n
  simp only [mem_lessThanSet, altEven, altOdd, Set.mem_ofPred_eq]
  split_ifs with h <;> simp [h]

/-- `L_{altOdd, altEven}` is the set of even natural numbers (Goldblatt §2.2, p. 17). -/
theorem lessThanSet_altOdd_altEven : lessThanSet altOdd altEven = {n : ℕ | Even n} := by
  ext n
  simp only [mem_lessThanSet, altEven, altOdd, Set.mem_ofPred_eq]
  split_ifs with h <;> simp [h]

/-- `L_{altEven, altOdd}` and `L_{altOdd, altEven}` are complements of each other in `ℕ`
(Goldblatt §2.2, p. 17). -/
theorem lessThanSet_altEven_altOdd_compl :
    (lessThanSet altEven altOdd)ᶜ = lessThanSet altOdd altEven := by
  ext n
  simp [lessThanSet_altEven_altOdd, lessThanSet_altOdd_altEven]

/-- The set of even natural numbers is infinite. -/
theorem infinite_even_nat : {n : ℕ | Even n}.Infinite := by
  refine Set.infinite_of_injective_forall_mem (f := fun k : ℕ ↦ 2 * k)
    (fun a b h ↦ by dsimp at h; omega) ?_
  intro k
  exact ⟨k, Nat.two_mul k⟩

/-- The set of odd natural numbers is infinite. -/
theorem infinite_odd_nat : {n : ℕ | Odd n}.Infinite := by
  refine Set.infinite_of_injective_forall_mem (f := fun k : ℕ ↦ 2 * k + 1)
    (fun a b h ↦ by dsimp at h; omega) ?_
  intro k
  exact ⟨k, rfl⟩

/-- The set `{n : ℕ | ¬ Even n}` of non-even natural numbers is infinite. -/
theorem infinite_not_even_nat : {n : ℕ | ¬ Even n}.Infinite := by
  refine infinite_odd_nat.mono ?_
  intro n hn
  exact Nat.not_even_iff_odd.mpr hn

/-- `lessThanSet altEven altOdd` is not cofinite in `ℕ` (Goldblatt §2.2, p. 17). -/
theorem not_cofinite_lessThanSet_altEven_altOdd : ¬ (lessThanSet altEven altOdd)ᶜ.Finite := by
  rw [lessThanSet_altEven_altOdd_compl, lessThanSet_altOdd_altEven]
  exact infinite_even_nat

/-- `lessThanSet altOdd altEven` is not cofinite in `ℕ` (Goldblatt §2.2, p. 17). -/
theorem not_cofinite_lessThanSet_altOdd_altEven : ¬ (lessThanSet altOdd altEven)ᶜ.Finite := by
  have hcompl : (lessThanSet altOdd altEven)ᶜ = {n : ℕ | ¬ Even n} := by
    ext n
    simp [lessThanSet_altOdd_altEven]
  rw [hcompl]
  exact infinite_not_even_nat

/-- Goldblatt's combined largeness requirement (`A, B ∈ S` and `A ∩ B ⊆ C` imply `C ∈ S`,
§2.2, p. 17) is equivalent to closure under binary intersections and supersets. -/
theorem largeness_axiom_iff_inter_and_superset {I : Type*} (S : Set (Set I)) :
    (∀ ⦃A B C : Set I⦄, A ∈ S → B ∈ S → A ∩ B ⊆ C → C ∈ S) ↔
      ((∀ ⦃A B : Set I⦄, A ∈ S → B ∈ S → A ∩ B ∈ S) ∧
        (∀ ⦃A B : Set I⦄, A ∈ S → A ⊆ B → B ∈ S)) := by
  constructor
  · intro h
    refine ⟨fun A B hA hB ↦ h hA hB Set.Subset.rfl, fun A B hA hAB ↦ ?_⟩
    exact h hA hA ((Set.inter_self A).subset.trans hAB)
  · rintro ⟨hinter, hsup⟩ A B C hA hB hABC
    exact hsup (hinter hA hB) hABC

/-!
## §2.3 — Filters and Ultrafilters (Goldblatt p. 18)
-/

/-- A concrete set-theoretic filter on `I` following Goldblatt §2.3 (p. 18):
a nonempty collection `sets ⊆ 𝒫(I)` closed under binary intersections and supersets.

Unlike Bourbaki, Goldblatt allows the improper filter `𝒫(I)` and singles out proper filters via
`∅ ∉ F`, matching Mathlib's `Filter I` (except Goldblatt orders filters by inclusion `⊆`). -/
structure SetFilter (I : Type*) where
  /-- The underlying collection of subsets of `I` belonging to the filter. -/
  sets : Set (Set I)
  /-- A filter on `I` is a nonempty collection of subsets of `I`. -/
  nonempty : sets.Nonempty
  /-- Intersections axiom: if `A, B ∈ F`, then `A ∩ B ∈ F`. -/
  inter_mem : ∀ {A B : Set I}, A ∈ sets → B ∈ sets → A ∩ B ∈ sets
  /-- Supersets axiom: if `A ∈ F` and `A ⊆ B`, then `B ∈ F`. -/
  superset_mem : ∀ {A B : Set I}, A ∈ sets → A ⊆ B → B ∈ sets

namespace SetFilter

variable {I : Type*}

/-- Membership `A ∈ F` for `A : Set I` and `F : SetFilter I` (Goldblatt §2.3, p. 18). -/
instance instMembership : Membership (Set I) (SetFilter I) :=
  ⟨fun F A ↦ A ∈ F.sets⟩

@[simp]
theorem mem_sets {F : SetFilter I} {A : Set I} : A ∈ F.sets ↔ A ∈ F :=
  Iff.rfl

@[simp]
theorem mem_mk {S : Set (Set I)} {hne hinter hsup} {A : Set I} :
    A ∈ (⟨S, hne, hinter, hsup⟩ : SetFilter I) ↔ A ∈ S :=
  Iff.rfl

/-- Two filters on `I` are equal iff their underlying collections of sets are equal. -/
theorem ext_sets {F G : SetFilter I} (h : F.sets = G.sets) : F = G := by
  cases F
  cases G
  congr

/-- Extensionality for `SetFilter I`: two filters agree iff they contain the same subsets of `I`. -/
@[ext]
theorem ext {F G : SetFilter I} (h : ∀ A : Set I, A ∈ F ↔ A ∈ G) : F = G :=
  ext_sets (Set.ext h)

/-- Every filter on `I` contains the whole index set `I` (`Set.univ`) (Goldblatt §2.3, p. 18). -/
@[simp]
theorem univ_mem (F : SetFilter I) : (Set.univ : Set I) ∈ F := by
  obtain ⟨A, hA⟩ := F.nonempty
  exact F.superset_mem hA (Set.subset_univ A)

/-- Finite intersections of sets in a filter `F` belong to `F` (Goldblatt §2.3, p. 18). -/
theorem biInter_finset_mem (F : SetFilter I) {s : Finset (Set I)}
    (hs : (↑s : Set (Set I)) ⊆ F.sets) :
    (⋂ A ∈ s, A) ∈ F := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    simp
  | @insert A s _ ih =>
    rw [Finset.set_biInter_insert]
    have hA : A ∈ F := hs (Finset.mem_coe.mpr (Finset.mem_insert_self A s))
    have hs' : (↑s : Set (Set I)) ⊆ F.sets := fun B hB ↦
      hs (Finset.mem_coe.mpr (Finset.mem_insert_of_mem (Finset.mem_coe.mp hB)))
    exact F.inter_mem hA (ih hs')

/-- To show `B ∈ F`, it suffices to find finitely many sets in `F` whose intersection is a subset
of `B` (Goldblatt §2.3, p. 18). -/
theorem mem_of_finset_iInter_subset (F : SetFilter I) {B : Set I} {s : Finset (Set I)}
    (hs : (↑s : Set (Set I)) ⊆ F.sets) (hsub : (⋂ A ∈ s, A) ⊆ B) : B ∈ F :=
  F.superset_mem (F.biInter_finset_mem hs) hsub

/-- Goldblatt orders filters by set inclusion `F ⊆ G`
(Goldblatt §2.4(4), §2.5(6), §2.6, pp. 18–20). -/
instance instPartialOrder : PartialOrder (SetFilter I) where
  le F G := F.sets ⊆ G.sets
  le_refl _ := Set.Subset.rfl
  le_trans _ _ _ := Set.Subset.trans
  le_antisymm _ _ h₁ h₂ := ext_sets (Set.Subset.antisymm h₁ h₂)

theorem le_def {F G : SetFilter I} : F ≤ G ↔ F.sets ⊆ G.sets :=
  Iff.rfl

theorem le_iff_forall_mem {F G : SetFilter I} : F ≤ G ↔ ∀ A : Set I, A ∈ F → A ∈ G :=
  Iff.rfl

/-- A filter `F` contains the empty set `∅` iff `F = 𝒫(I)` (`F.sets = Set.univ`)
(Goldblatt §2.3, p. 18). -/
theorem empty_mem_iff_eq_univ (F : SetFilter I) : (∅ : Set I) ∈ F ↔ F.sets = Set.univ := by
  constructor
  · intro hempty
    ext A
    simp only [Set.mem_univ, iff_true]
    exact F.superset_mem hempty (Set.empty_subset A)
  · intro huniv
    change (∅ : Set I) ∈ F.sets
    rw [huniv]
    exact Set.mem_univ _

/-- A filter `F` on `I` is *proper* if `∅ ∉ F` (Goldblatt §2.3, p. 18). -/
def IsProper (F : SetFilter I) : Prop :=
  (∅ : Set I) ∉ F

theorem isProper_iff (F : SetFilter I) : F.IsProper ↔ (∅ : Set I) ∉ F :=
  Iff.rfl

/-- A filter `F` is proper iff `F ≠ 𝒫(I)` (Goldblatt §2.3, p. 18). -/
theorem isProper_iff_sets_ne_univ (F : SetFilter I) : F.IsProper ↔ F.sets ≠ Set.univ := by
  rw [IsProper, not_iff_not, empty_mem_iff_eq_univ]

/-- Every set in a proper filter is nonempty. -/
theorem IsProper.nonempty_of_mem {F : SetFilter I} (hF : F.IsProper) {A : Set I} (hA : A ∈ F) :
    A.Nonempty := by
  rw [Set.nonempty_iff_ne_empty]
  rintro rfl
  exact hF hA

/-- If `I` admits a proper filter, then `I` is nonempty. -/
theorem IsProper.nonempty_type {F : SetFilter I} (hF : F.IsProper) : Nonempty I := by
  obtain ⟨x, _⟩ := hF.nonempty_of_mem F.univ_mem
  exact ⟨x⟩

/-- In a proper filter, a set `A` and its complement `Aᶜ` cannot both belong to `F`
(Goldblatt §2.2, p. 17). -/
theorem IsProper.compl_not_mem {F : SetFilter I} (hF : F.IsProper) {A : Set I} (hA : A ∈ F) :
    Aᶜ ∉ F := by
  intro hAc
  have hempty : (∅ : Set I) ∈ F := by
    rw [← Set.inter_compl_self A]
    exact F.inter_mem hA hAc
  exact hF hempty

/-- An *ultrafilter* on `I` is a proper filter `F` such that for every `A ⊆ I`,
either `A ∈ F` or `Aᶜ ∈ F` (Goldblatt §2.3, p. 18). -/
def IsUltrafilter (F : SetFilter I) : Prop :=
  F.IsProper ∧ ∀ A : Set I, A ∈ F ∨ Aᶜ ∈ F

theorem IsUltrafilter.isProper {F : SetFilter I} (hF : F.IsUltrafilter) : F.IsProper :=
  hF.1

theorem IsUltrafilter.mem_or_compl_mem {F : SetFilter I} (hF : F.IsUltrafilter) (A : Set I) :
    A ∈ F ∨ Aᶜ ∈ F :=
  hF.2 A

/-- Convert a Goldblatt `SetFilter I` into a Mathlib `Filter I`. -/
def toFilter (F : SetFilter I) : Filter I where
  sets := F.sets
  univ_sets := F.univ_mem
  sets_of_superset := F.superset_mem
  inter_sets := F.inter_mem

/-- Convert a Mathlib `Filter I` into a Goldblatt `SetFilter I`. -/
def ofFilter (f : Filter I) : SetFilter I where
  sets := f.sets
  nonempty := ⟨Set.univ, f.univ_sets⟩
  inter_mem := f.inter_sets
  superset_mem := f.sets_of_superset

@[simp]
theorem mem_toFilter {F : SetFilter I} {A : Set I} : A ∈ F.toFilter ↔ A ∈ F :=
  Iff.rfl

@[simp]
theorem mem_ofFilter {f : Filter I} {A : Set I} : A ∈ ofFilter f ↔ A ∈ f :=
  Iff.rfl

@[simp]
theorem ofFilter_toFilter (F : SetFilter I) : ofFilter F.toFilter = F :=
  rfl

@[simp]
theorem toFilter_ofFilter (f : Filter I) : (ofFilter f).toFilter = f :=
  rfl

/-- Explicit bijection `SetFilter I ≃ Filter I` preserving set membership. -/
def equivFilter (I : Type*) : SetFilter I ≃ Filter I where
  toFun := toFilter
  invFun := ofFilter
  left_inv := ofFilter_toFilter
  right_inv := toFilter_ofFilter

/-- Goldblatt orders filters by set inclusion `F.sets ⊆ G.sets`, whereas Mathlib orders `Filter I`
by refinement `g.sets ⊆ f.sets`; thus `toFilter` reverses the partial order. -/
@[simp]
theorem toFilter_le_toFilter_iff {F G : SetFilter I} : F.toFilter ≤ G.toFilter ↔ G ≤ F :=
  Iff.rfl

/-- Order isomorphism between Goldblatt's `SetFilter I` (ordered by `⊆`) and the order dual
`(Filter I)ᵒᵈ` of Mathlib's `Filter I`. -/
def orderIsoFilterDual (I : Type*) : SetFilter I ≃o (Filter I)ᵒᵈ where
  toEquiv := (equivFilter I).trans OrderDual.toDual
  map_rel_iff' := Iff.rfl

/-- Properness of `F : SetFilter I` corresponds to `Filter.NeBot F.toFilter` in Mathlib. -/
theorem toFilter_neBot_iff {F : SetFilter I} : F.toFilter.NeBot ↔ F.IsProper := by
  rw [Filter.neBot_iff, Ne, Filter.ext_iff]
  simp only [mem_toFilter, Filter.mem_bot, iff_true]
  rw [IsProper, empty_mem_iff_eq_univ, Set.eq_univ_iff_forall]
  rfl

end SetFilter

export SetFilter (univ_mem empty_mem_iff_eq_univ IsProper IsUltrafilter)

/-- The type of ultrafilters on `I` as a subtype of `SetFilter I` (Goldblatt §2.3, p. 18). -/
abbrev SetUltrafilter (I : Type*) : Type _ :=
  {F : SetFilter I // F.IsUltrafilter}

namespace SetUltrafilter

variable {I : Type*}

instance instMembership : Membership (Set I) (SetUltrafilter I) :=
  ⟨fun U A ↦ A ∈ U.1⟩

@[simp]
theorem mem_val {U : SetUltrafilter I} {A : Set I} : A ∈ U.1 ↔ A ∈ U :=
  Iff.rfl

@[ext]
theorem ext {U V : SetUltrafilter I} (h : ∀ A : Set I, A ∈ U ↔ A ∈ V) : U = V :=
  Subtype.ext (SetFilter.ext h)

/-- Convert a Goldblatt `SetUltrafilter I` into a Mathlib `Ultrafilter I`. -/
def toUltrafilter (U : SetUltrafilter I) : Ultrafilter I :=
  Ultrafilter.ofComplNotMemIff U.1.toFilter fun A ↦
    ⟨fun hAc ↦ (U.2.mem_or_compl_mem A).resolve_right hAc,
     fun hA ↦ U.2.isProper.compl_not_mem hA⟩

/-- Convert a Mathlib `Ultrafilter I` into a Goldblatt `SetUltrafilter I`. -/
def ofUltrafilter (u : Ultrafilter I) : SetUltrafilter I :=
  ⟨SetFilter.ofFilter u.toFilter,
   ⟨Ultrafilter.empty_notMem, fun A ↦ u.mem_or_compl_mem A⟩⟩

@[simp]
theorem mem_toUltrafilter {U : SetUltrafilter I} {A : Set I} : A ∈ U.toUltrafilter ↔ A ∈ U :=
  Iff.rfl

@[simp]
theorem mem_ofUltrafilter {u : Ultrafilter I} {A : Set I} : A ∈ ofUltrafilter u ↔ A ∈ u :=
  Iff.rfl

/-- Explicit equivalence `{F : SetFilter I // F.IsUltrafilter} ≃ Ultrafilter I` preserving
membership (Goldblatt §2.3, p. 18). -/
def equivUltrafilter (I : Type*) : SetUltrafilter I ≃ Ultrafilter I where
  toFun := toUltrafilter
  invFun := ofUltrafilter
  left_inv _ := Subtype.ext rfl
  right_inv _ := Ultrafilter.ext fun _ ↦ Iff.rfl

end SetUltrafilter

/-- The indiscrete (trivial) filter `{I}` (`{Set.univ}`), which is the smallest filter on `I`
with respect to set inclusion (Goldblatt §2.3, p. 18). -/
def indiscreteSetFilter (I : Type*) : SetFilter I where
  sets := {Set.univ}
  nonempty := ⟨Set.univ, Set.mem_singleton _⟩
  inter_mem {A B} hA hB := by
    rw [Set.mem_singleton_iff] at hA hB ⊢
    rw [hA, hB, Set.univ_inter]
  superset_mem {A B} hA hAB := by
    rw [Set.mem_singleton_iff] at hA ⊢
    rw [hA] at hAB
    exact Set.univ_subset_iff.mp hAB

/-- Alias for `indiscreteSetFilter I` as the bottom element under `⊆` (Goldblatt §2.3, p. 18). -/
abbrev botFilter (I : Type*) : SetFilter I :=
  indiscreteSetFilter I

@[simp]
theorem mem_indiscreteSetFilter {I : Type*} {A : Set I} :
    A ∈ indiscreteSetFilter I ↔ A = Set.univ :=
  Set.mem_singleton_iff

/-- `{I}` is the smallest filter on `I`: `indiscreteSetFilter I ≤ F` for every filter `F`
(Goldblatt §2.3, p. 18; §2.5(2), p. 19). -/
theorem indiscreteSetFilter_le {I : Type*} (F : SetFilter I) : indiscreteSetFilter I ≤ F := by
  rintro A rfl
  exact F.univ_mem

/-- `{I}` is proper iff `I` is nonempty (Goldblatt §2.3, p. 18). -/
theorem indiscreteSetFilter_isProper_iff {I : Type*} :
    (indiscreteSetFilter I).IsProper ↔ Nonempty I := by
  rw [SetFilter.IsProper, mem_indiscreteSetFilter, eq_comm, Set.univ_eq_empty_iff, not_isEmpty_iff]

theorem indiscreteSetFilter_isProper (I : Type*) [Nonempty I] :
    (indiscreteSetFilter I).IsProper :=
  indiscreteSetFilter_isProper_iff.mpr ‹Nonempty I›

/-- The improper power-set filter `𝒫(I)` containing all subsets of `I`, which is the largest
filter on `I` under `⊆` (Goldblatt §2.3, p. 18). -/
def powerSetFilter (I : Type*) : SetFilter I where
  sets := Set.univ
  nonempty := ⟨Set.univ, Set.mem_univ _⟩
  inter_mem _ _ := Set.mem_univ _
  superset_mem _ _ := Set.mem_univ _

@[simp]
theorem mem_powerSetFilter {I : Type*} {A : Set I} : A ∈ powerSetFilter I :=
  Set.mem_univ A

instance instBoundedOrderSetFilter (I : Type*) : BoundedOrder (SetFilter I) where
  top := powerSetFilter I
  le_top _ _ _ := Set.mem_univ _
  bot := indiscreteSetFilter I
  bot_le := indiscreteSetFilter_le

/-!
## §2.4 — Examples of Filters (1)–(4) (Goldblatt p. 18)
-/

/-- **Example 2.4(1)** (Goldblatt p. 18): The principal ultrafilter `F_i = {A ⊆ I : i ∈ A}`
generated by an element `i : I`. -/
def principalFilter {I : Type*} (i : I) : SetFilter I where
  sets := {A : Set I | i ∈ A}
  nonempty := ⟨Set.univ, Set.mem_univ i⟩
  inter_mem hA hB := ⟨hA, hB⟩
  superset_mem hA hAB := hAB hA

@[simp]
theorem mem_principalFilter {I : Type*} {i : I} {A : Set I} :
    A ∈ principalFilter i ↔ i ∈ A :=
  Iff.rfl

/-- `{i}` belongs to the principal filter `principalFilter i`. -/
@[simp]
theorem singleton_mem_principalFilter {I : Type*} (i : I) :
    ({i} : Set I) ∈ principalFilter i :=
  Set.mem_singleton i

/-- `principalFilter i` is an ultrafilter on `I` (Goldblatt §2.4(1), p. 18). -/
theorem principalFilter_isUltrafilter {I : Type*} (i : I) :
    (principalFilter i).IsUltrafilter :=
  ⟨fun h ↦ h, fun A ↦ Classical.em (i ∈ A)⟩

/-- `principalFilter i` bundled as a `SetUltrafilter I`. -/
def principalUltrafilter {I : Type*} (i : I) : SetUltrafilter I :=
  ⟨principalFilter i, principalFilter_isUltrafilter i⟩

/-- Distinct elements of `I` generate distinct principal ultrafilters. -/
theorem principalFilter_injective (I : Type*) :
    Function.Injective (principalFilter : I → SetFilter I) := by
  intro i j hij
  have hmem : ({i} : Set I) ∈ principalFilter j := hij ▸ singleton_mem_principalFilter i
  exact (Set.mem_singleton_iff.mp hmem).symm

/-- `principalFilter i` corresponds to Mathlib's `pure i : Filter I`. -/
@[simp]
theorem toFilter_principalFilter {I : Type*} (i : I) :
    (principalFilter i).toFilter = pure i :=
  rfl

/-- **Example 2.4(2)** (Goldblatt p. 18): The cofinite (Fréchet) filter
`F^{co} = {A ⊆ I : I \ A is finite}`. -/
def cofiniteSetFilter (I : Type*) : SetFilter I where
  sets := {A : Set I | Aᶜ.Finite}
  nonempty := ⟨Set.univ, by simp⟩
  inter_mem {A B} hA hB := by
    change (A ∩ B)ᶜ.Finite
    rw [Set.compl_inter]
    exact hA.union hB
  superset_mem {A B} hA hAB := hA.subset (Set.compl_subset_compl.mpr hAB)

@[simp]
theorem mem_cofiniteSetFilter {I : Type*} {A : Set I} :
    A ∈ cofiniteSetFilter I ↔ Aᶜ.Finite :=
  Iff.rfl

/-- `cofiniteSetFilter I` corresponds to Mathlib's `Filter.cofinite`. -/
@[simp]
theorem toFilter_cofiniteSetFilter (I : Type*) :
    (cofiniteSetFilter I).toFilter = Filter.cofinite :=
  rfl

/-- The cofinite filter `F^{co}` on `I` is proper iff `I` is infinite
(Goldblatt §2.4(2), p. 18). -/
theorem cofiniteSetFilter_isProper_iff_infinite (I : Type*) :
    (cofiniteSetFilter I).IsProper ↔ Infinite I := by
  rw [SetFilter.IsProper, mem_cofiniteSetFilter, Set.compl_empty]
  exact Set.infinite_univ_iff

/-- The cofinite filter on `ℕ` is *not* an ultrafilter, because neither `{n | Even n}` nor its
complement has finite complement (Goldblatt §2.4(2), p. 18). -/
theorem not_isUltrafilter_cofiniteSetFilter_nat :
    ¬ (cofiniteSetFilter ℕ).IsUltrafilter := by
  intro ⟨_, hdich⟩
  rcases hdich {n : ℕ | Even n} with heven | hodd
  · exact infinite_not_even_nat heven
  · rw [mem_cofiniteSetFilter, compl_compl] at hodd
    exact infinite_even_nat hodd

/-- More generally, `cofiniteSetFilter I` is *never* an ultrafilter on *any* type `I`:
if `I` is finite it is improper, and if `I` is infinite we can split an embedded copy of `ℕ`
into two disjoint infinite sets (Goldblatt §2.4(2), p. 18). -/
theorem not_isUltrafilter_cofiniteSetFilter (I : Type*) :
    ¬ (cofiniteSetFilter I).IsUltrafilter := by
  by_cases hInf : Infinite I
  · intro ⟨_, hdich⟩
    let e : ℕ ↪ I := Infinite.natEmbedding I
    let A : Set I := Set.range fun k : ℕ ↦ e (2 * k)
    let B : Set I := Set.range fun k : ℕ ↦ e (2 * k + 1)
    have hA_inf : A.Infinite :=
      Set.infinite_range_of_injective fun a b hab ↦ by
        have := e.injective hab
        omega
    have hB_inf : B.Infinite :=
      Set.infinite_range_of_injective fun a b hab ↦ by
        have := e.injective hab
        omega
    have hBAc : B ⊆ Aᶜ := by
      rintro _ ⟨a, rfl⟩ ⟨b, hb⟩
      have := e.injective hb
      omega
    rcases hdich A with hA | hAc
    · exact (hB_inf.mono hBAc) hA
    · rw [mem_cofiniteSetFilter, compl_compl] at hAc
      exact hA_inf hAc
  · intro ⟨hprop, _⟩
    exact hInf ((cofiniteSetFilter_isProper_iff_infinite I).mp hprop)

/-- **Example 2.4(3)** (Goldblatt p. 18): The filter `F^ℋ` generated by `H : Set (Set I)`,
consisting of all `A ⊆ I` that include a finite intersection `⋂ B ∈ s, B` of members of `H`.

Note that when `s = ∅`, `⋂ B ∈ ∅, B = Set.univ`, so for `H = ∅` this yields `{Set.univ}` (`{I}`),
matching Goldblatt's convention `F^∅ = {I}` automatically. -/
def generatedSetFilter {I : Type*} (H : Set (Set I)) : SetFilter I where
  sets := {A : Set I | ∃ s : Finset (Set I), (↑s : Set (Set I)) ⊆ H ∧ (⋂ B ∈ s, B) ⊆ A}
  nonempty := ⟨Set.univ, ∅, by simp, by simp⟩
  inter_mem {A₁ A₂} h₁ h₂ := by
    classical
    rcases h₁ with ⟨s₁, hs₁, hsub₁⟩
    rcases h₂ with ⟨s₂, hs₂, hsub₂⟩
    refine ⟨s₁ ∪ s₂, ?_, ?_⟩
    · rw [Finset.coe_union]
      exact Set.union_subset hs₁ hs₂
    · intro x hx
      simp only [Set.mem_iInter, Finset.mem_union] at hx
      exact ⟨hsub₁ (Set.mem_iInter₂.mpr fun B hB ↦ hx B (Or.inl hB)),
             hsub₂ (Set.mem_iInter₂.mpr fun B hB ↦ hx B (Or.inr hB))⟩
  superset_mem {A B} hA hAB := by
    rcases hA with ⟨s, hs, hsub⟩
    exact ⟨s, hs, hsub.trans hAB⟩

@[simp]
theorem mem_generatedSetFilter {I : Type*} {H : Set (Set I)} {A : Set I} :
    A ∈ generatedSetFilter H ↔
      ∃ s : Finset (Set I), (↑s : Set (Set I)) ⊆ H ∧ (⋂ B ∈ s, B) ⊆ A :=
  Iff.rfl

/-- For `H = ∅`, `generatedSetFilter ∅ = indiscreteSetFilter I` (`F^∅ = {I}`, Goldblatt p. 18). -/
@[simp]
theorem generatedSetFilter_empty (I : Type*) :
    generatedSetFilter (∅ : Set (Set I)) = indiscreteSetFilter I := by
  ext A
  simp only [mem_generatedSetFilter, Set.subset_empty_iff, Finset.coe_eq_empty, exists_eq_left,
    Finset.notMem_empty, Set.iInter_of_empty, Set.iInter_univ, Set.univ_subset_iff,
    mem_indiscreteSetFilter]

/-- When `H` is nonempty, `A ∈ generatedSetFilter H` iff `A` contains a *nonempty* finite
intersection of sets in `H` (matching Goldblatt's `B₁ ∩ ⋯ ∩ Bₙ ⊆ A` with `n ≥ 1`, p. 18). -/
theorem mem_generatedSetFilter_of_nonempty {I : Type*} {H : Set (Set I)} (hH : H.Nonempty)
    {A : Set I} :
    A ∈ generatedSetFilter H ↔
      ∃ s : Finset (Set I), s.Nonempty ∧ (↑s : Set (Set I)) ⊆ H ∧ (⋂ B ∈ s, B) ⊆ A := by
  constructor
  · rintro ⟨s, hsH, hsub⟩
    rcases s.eq_empty_or_nonempty with rfl | hsne
    · obtain ⟨B₀, hB₀⟩ := hH
      simp only [Finset.notMem_empty, Set.iInter_of_empty, Set.iInter_univ,
        Set.univ_subset_iff] at hsub
      refine ⟨{B₀}, Finset.singleton_nonempty B₀, ?_, ?_⟩
      · simpa using hB₀
      · rw [hsub]
        exact Set.subset_univ _
    · exact ⟨s, hsne, hsH, hsub⟩
  · rintro ⟨s, _, hsH, hsub⟩
    exact ⟨s, hsH, hsub⟩

/-- **Example 2.4(3)** (Goldblatt p. 18): The principal filter `{A ⊆ I : B ⊆ A}` generated by a
single subset `B : Set I`. -/
def principalSetFilterOfSet {I : Type*} (B : Set I) : SetFilter I where
  sets := {A : Set I | B ⊆ A}
  nonempty := ⟨Set.univ, Set.subset_univ B⟩
  inter_mem h₁ h₂ := Set.subset_inter h₁ h₂
  superset_mem h₁ h₂ := h₁.trans h₂

@[simp]
theorem mem_principalSetFilterOfSet {I : Type*} {B A : Set I} :
    A ∈ principalSetFilterOfSet B ↔ B ⊆ A :=
  Iff.rfl

/-- If `H = {B}`, then `generatedSetFilter {B} = principalSetFilterOfSet B`
(Goldblatt §2.4(3), p. 18). -/
@[simp]
theorem generatedSetFilter_singleton {I : Type*} (B : Set I) :
    generatedSetFilter ({B} : Set (Set I)) = principalSetFilterOfSet B := by
  ext A
  simp only [mem_generatedSetFilter, mem_principalSetFilterOfSet]
  constructor
  · rintro ⟨s, hs, hsub⟩
    refine Set.Subset.trans ?_ hsub
    intro x hx
    simp only [Set.mem_iInter]
    intro C hC
    have hCB : C = B := Set.mem_singleton_iff.mp (hs (Finset.mem_coe.mpr hC))
    rwa [hCB]
  · intro hBA
    refine ⟨{B}, by simp, ?_⟩
    simpa using hBA

/-- The principal ultrafilter `principalFilter i` is the special case of `principalSetFilterOfSet`
when `B = {i}` (Goldblatt §2.4(3), p. 18). -/
@[simp]
theorem principalSetFilterOfSet_singleton {I : Type*} (i : I) :
    principalSetFilterOfSet ({i} : Set I) = principalFilter i := by
  ext A
  simp

/-- **Example 2.4(4)** (Goldblatt p. 18): The union of a nonempty chain of filters on `I`
(linearly ordered by `⊆`) is a filter on `I`. -/
def chainUnionFilter {I : Type*} {C : Set (SetFilter I)} (hC : IsChain (· ≤ ·) C)
    (hne : C.Nonempty) : SetFilter I where
  sets := {A : Set I | ∃ F ∈ C, A ∈ F}
  nonempty := by
    obtain ⟨F, hF⟩ := hne
    exact ⟨Set.univ, F, hF, F.univ_mem⟩
  inter_mem {A B} hA hB := by
    rcases hA with ⟨F₁, hF₁, hAF₁⟩
    rcases hB with ⟨F₂, hF₂, hBF₂⟩
    rcases hC.total hF₁ hF₂ with h₁₂ | h₂₁
    · exact ⟨F₂, hF₂, F₂.inter_mem (h₁₂ hAF₁) hBF₂⟩
    · exact ⟨F₁, hF₁, F₁.inter_mem hAF₁ (h₂₁ hBF₂)⟩
  superset_mem {A B} hA hAB := by
    rcases hA with ⟨F, hF, hAF⟩
    exact ⟨F, hF, F.superset_mem hAF hAB⟩

@[simp]
theorem mem_chainUnionFilter {I : Type*} {C : Set (SetFilter I)} {hC : IsChain (· ≤ ·) C}
    {hne : C.Nonempty} {A : Set I} :
    A ∈ chainUnionFilter hC hne ↔ ∃ F ∈ C, A ∈ F :=
  Iff.rfl

/-- Every filter in the chain `C` is included in `chainUnionFilter hC hne`. -/
theorem le_chainUnionFilter {I : Type*} {C : Set (SetFilter I)} (hC : IsChain (· ≤ ·) C)
    (hne : C.Nonempty) {F : SetFilter I} (hF : F ∈ C) :
    F ≤ chainUnionFilter hC hne :=
  fun _ hA ↦ ⟨F, hF, hA⟩

/-- If every filter in a nonempty chain `C` is proper, then their union is proper
(used in Goldblatt Theorem 2.6.1, p. 20). -/
theorem chainUnionFilter_isProper {I : Type*} {C : Set (SetFilter I)} (hC : IsChain (· ≤ ·) C)
    (hne : C.Nonempty) (hprop : ∀ F ∈ C, F.IsProper) :
    (chainUnionFilter hC hne).IsProper := by
  rintro ⟨F, hFC, hempty⟩
  exact hprop F hFC hempty

/-- Indexed version of **Example 2.4(4)** (Goldblatt p. 18): for a nonempty index type `X` and
a family `F : X → SetFilter I` linearly ordered by `⊆`, `⋃ x, F x` is a filter on `I`. -/
def indexedChainUnionFilter {I X : Type*} [Nonempty X] (F : X → SetFilter I)
    (hlin : ∀ x y : X, F x ≤ F y ∨ F y ≤ F x) : SetFilter I where
  sets := {A : Set I | ∃ x : X, A ∈ F x}
  nonempty :=
    let ⟨x₀⟩ := ‹Nonempty X›
    ⟨Set.univ, x₀, (F x₀).univ_mem⟩
  inter_mem {A B} := by
    rintro ⟨x, hx⟩ ⟨y, hy⟩
    rcases hlin x y with hxy | hyx
    · exact ⟨y, (F y).inter_mem (hxy hx) hy⟩
    · exact ⟨x, (F x).inter_mem hx (hyx hy)⟩
  superset_mem {A B} := by
    rintro ⟨x, hx⟩ hAB
    exact ⟨x, (F x).superset_mem hx hAB⟩

/-!
## §2.5 — Facts About Filters (1)–(8) (Goldblatt p. 19)
-/

/-- **Fact 2.5(1)** (Goldblatt p. 19): A collection `S ⊆ 𝒫(I)` satisfies the filter axioms
(nonempty, closed under intersections, closed under supersets) iff `I ∈ S` and
`∀ A B, A ∩ B ∈ S ↔ A ∈ S ∧ B ∈ S`. -/
theorem filter_axioms_iff_univ_and_inter_iff {I : Type*} (S : Set (Set I)) :
    (S.Nonempty ∧
      (∀ ⦃A B : Set I⦄, A ∈ S → B ∈ S → A ∩ B ∈ S) ∧
      (∀ ⦃A B : Set I⦄, A ∈ S → A ⊆ B → B ∈ S)) ↔
    ((Set.univ : Set I) ∈ S ∧ ∀ A B : Set I, A ∩ B ∈ S ↔ A ∈ S ∧ B ∈ S) := by
  constructor
  · rintro ⟨⟨A₀, hA₀⟩, hinter, hsup⟩
    refine ⟨hsup hA₀ (Set.subset_univ A₀), fun A B ↦ ⟨fun hAB ↦ ?_, fun ⟨hA, hB⟩ ↦ hinter hA hB⟩⟩
    exact ⟨hsup hAB Set.inter_subset_left, hsup hAB Set.inter_subset_right⟩
  · rintro ⟨huniv, hinter⟩
    refine ⟨⟨Set.univ, huniv⟩, fun A B hA hB ↦ (hinter A B).mpr ⟨hA, hB⟩, fun A B hA hAB ↦ ?_⟩
    have h_eq : A ∩ B = A := Set.inter_eq_left.mpr hAB
    have hAB_mem : A ∩ B ∈ S := h_eq.symm ▸ hA
    exact ((hinter A B).mp hAB_mem).2

/-- **Fact 2.5(1)** for a nonempty collection `S ⊆ 𝒫(I)` (Goldblatt p. 19): the intersection and
superset axioms together are equivalent to `∀ A B, A ∩ B ∈ S ↔ A ∈ S ∧ B ∈ S`. -/
theorem filter_axioms_of_nonempty_iff_inter_iff {I : Type*} {S : Set (Set I)} (hne : S.Nonempty) :
    ((∀ ⦃A B : Set I⦄, A ∈ S → B ∈ S → A ∩ B ∈ S) ∧
      (∀ ⦃A B : Set I⦄, A ∈ S → A ⊆ B → B ∈ S)) ↔
    (∀ A B : Set I, A ∩ B ∈ S ↔ A ∈ S ∧ B ∈ S) := by
  constructor
  · intro ⟨hinter, hsup⟩
    exact ((filter_axioms_iff_univ_and_inter_iff S).mp ⟨hne, hinter, hsup⟩).2
  · intro hinter
    obtain ⟨A₀, hA₀⟩ := hne
    have huniv : (Set.univ : Set I) ∈ S := by
      have h_eq : A₀ ∩ Set.univ = A₀ := Set.inter_univ A₀
      exact ((hinter A₀ Set.univ).mp (h_eq.symm ▸ hA₀)).2
    exact ((filter_axioms_iff_univ_and_inter_iff S).mpr ⟨huniv, hinter⟩).2

/-- In any filter `F`, `A ∩ B ∈ F ↔ A ∈ F ∧ B ∈ F` (Goldblatt §2.5(1), p. 19). -/
@[simp]
theorem SetFilter.inter_mem_iff {I : Type*} {F : SetFilter I} {A B : Set I} :
    A ∩ B ∈ F ↔ A ∈ F ∧ B ∈ F :=
  ⟨fun h ↦ ⟨F.superset_mem h Set.inter_subset_left, F.superset_mem h Set.inter_subset_right⟩,
   fun ⟨hA, hB⟩ ↦ F.inter_mem hA hB⟩

/-- **Fact 2.5(2)** (Goldblatt p. 19): If `S ⊆ 𝒫(I)` satisfies the superset axiom, then
`S` is nonempty iff `I ∈ S` (`Set.univ ∈ S`). -/
theorem nonempty_iff_univ_mem_of_superset {I : Type*} {S : Set (Set I)}
    (hsup : ∀ ⦃A B : Set I⦄, A ∈ S → A ⊆ B → B ∈ S) :
    S.Nonempty ↔ (Set.univ : Set I) ∈ S :=
  ⟨fun ⟨A, hA⟩ ↦ hsup hA (Set.subset_univ A), fun huniv ↦ ⟨Set.univ, huniv⟩⟩

/-- **Fact 2.5(2), second sentence** (Goldblatt p. 19): `{I} ⊆ F` for any filter `F` on `I`. -/
theorem singleton_univ_subset_sets {I : Type*} (F : SetFilter I) :
    ({Set.univ} : Set (Set I)) ⊆ F.sets :=
  Set.singleton_subset_iff.mpr F.univ_mem

/-- **Fact 2.5(3a)** (Goldblatt p. 19): For an ultrafilter `F`, `A ∩ B ∈ F ↔ A ∈ F ∧ B ∈ F`. -/
theorem SetFilter.IsUltrafilter.inter_mem_iff {I : Type*} {F : SetFilter I}
    (_hF : F.IsUltrafilter) {A B : Set I} :
    A ∩ B ∈ F ↔ A ∈ F ∧ B ∈ F :=
  SetFilter.inter_mem_iff

/-- **Fact 2.5(3c)** (Goldblatt p. 19): For an ultrafilter `F`, `Aᶜ ∈ F ↔ A ∉ F`. -/
theorem SetFilter.IsUltrafilter.compl_mem_iff_not_mem {I : Type*} {F : SetFilter I}
    (hF : F.IsUltrafilter) {A : Set I} :
    Aᶜ ∈ F ↔ A ∉ F := by
  constructor
  · intro hAc hA
    exact hF.isProper.compl_not_mem hA hAc
  · intro hnotA
    exact (hF.mem_or_compl_mem A).resolve_left hnotA

/-- Dual form of Fact 2.5(3c): for an ultrafilter `F`, `A ∈ F ↔ Aᶜ ∉ F`. -/
theorem SetFilter.IsUltrafilter.mem_iff_compl_not_mem {I : Type*} {F : SetFilter I}
    (hF : F.IsUltrafilter) {A : Set I} :
    A ∈ F ↔ Aᶜ ∉ F := by
  rw [hF.compl_mem_iff_not_mem, not_not]

/-- **Fact 2.5(3b)** (Goldblatt p. 19): For an ultrafilter `F`, `A ∪ B ∈ F ↔ A ∈ F ∨ B ∈ F`. -/
theorem SetFilter.IsUltrafilter.union_mem_iff {I : Type*} {F : SetFilter I}
    (hF : F.IsUltrafilter) {A B : Set I} :
    A ∪ B ∈ F ↔ A ∈ F ∨ B ∈ F := by
  constructor
  · intro hAB
    by_contra hnot
    push Not at hnot
    have hAc : Aᶜ ∈ F := hF.compl_mem_iff_not_mem.mpr hnot.1
    have hBc : Bᶜ ∈ F := hF.compl_mem_iff_not_mem.mpr hnot.2
    have hcompl : (A ∪ B)ᶜ ∈ F := by
      rw [Set.compl_union]
      exact F.inter_mem hAc hBc
    exact hF.isProper.compl_not_mem hAB hcompl
  · rintro (hA | hB)
    · exact F.superset_mem hA Set.subset_union_left
    · exact F.superset_mem hB Set.subset_union_right

/-- Finite union property for ultrafilters: `(⋃ x ∈ s, A x) ∈ F ↔ ∃ x ∈ s, A x ∈ F`. -/
theorem SetFilter.IsUltrafilter.biUnion_finset_mem_iff {I α : Type*} {F : SetFilter I}
    (hF : F.IsUltrafilter) {s : Finset α} {A : α → Set I} :
    (⋃ x ∈ s, A x) ∈ F ↔ ∃ x ∈ s, A x ∈ F := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    simp [show (∅ : Set I) ∉ F from hF.isProper]
  | @insert a s _ ih =>
    rw [Finset.set_biUnion_insert, hF.union_mem_iff, ih]
    simp

/-- **Fact 2.5(4)** (Goldblatt p. 19): If `F` is an ultrafilter and `A : Fin n → Set I` is a
pairwise disjoint finite family whose union `(⋃ k, A k)` belongs to `F`, then `A k ∈ F` for
a *unique* `k : Fin n`. -/
theorem SetFilter.IsUltrafilter.existsUnique_mem_of_iUnion_fin {I : Type*} {F : SetFilter I}
    (hF : F.IsUltrafilter) {n : ℕ} {A : Fin n → Set I}
    (hdisj : Pairwise fun j k ↦ Disjoint (A j) (A k))
    (hunion : (⋃ k : Fin n, A k) ∈ F) :
    ∃! k : Fin n, A k ∈ F := by
  have hunion' : (⋃ k ∈ (Finset.univ : Finset (Fin n)), A k) ∈ F := by
    simpa using hunion
  obtain ⟨k, _, hk⟩ := hF.biUnion_finset_mem_iff.mp hunion'
  refine ⟨k, hk, fun j hj ↦ ?_⟩
  by_contra hjk
  have hempty : A j ∩ A k = ∅ := Set.disjoint_iff_inter_eq_empty.mp (hdisj hjk)
  have hinter : A j ∩ A k ∈ F := F.inter_mem hj hk
  rw [hempty] at hinter
  exact hF.isProper hinter

/-- An ultrafilter `F` contains a singleton `{i}` iff `F = principalFilter i`
(Goldblatt §2.5(5), p. 19). -/
theorem SetFilter.IsUltrafilter.singleton_mem_iff_eq_principalFilter {I : Type*}
    {F : SetFilter I} (hF : F.IsUltrafilter) {i : I} :
    ({i} : Set I) ∈ F ↔ F = principalFilter i := by
  constructor
  · intro hi
    ext B
    simp only [mem_principalFilter]
    constructor
    · intro hB
      obtain ⟨x, hx_i, hx_B⟩ := hF.isProper.nonempty_of_mem (F.inter_mem hi hB)
      rwa [Set.mem_singleton_iff.mp hx_i] at hx_B
    · intro hiB
      exact F.superset_mem hi (Set.singleton_subset_iff.mpr hiB)
  · rintro rfl
    exact singleton_mem_principalFilter i

/-- **Fact 2.5(5), first sentence** (Goldblatt p. 19): If an ultrafilter `F` contains a finite set
`A`, then it contains a one-element subset `{i}` with `i ∈ A` and `F = principalFilter i`. -/
theorem SetFilter.IsUltrafilter.exists_eq_principalFilter_of_finite_mem {I : Type*}
    {F : SetFilter I} (hF : F.IsUltrafilter) {A : Set I} (hA_mem : A ∈ F) (hA_fin : A.Finite) :
    ∃ i ∈ A, F = principalFilter i := by
  let s : Finset I := hA_fin.toFinset
  have hunion : (⋃ i ∈ s, ({i} : Set I)) ∈ F := by
    have h_eq : (⋃ i ∈ s, ({i} : Set I)) = A := by
      ext x
      simp [s]
    rwa [h_eq]
  obtain ⟨i, hi_s, hi_mem⟩ := hF.biUnion_finset_mem_iff.mp hunion
  exact ⟨i, hA_fin.mem_toFinset.mp hi_s, hF.singleton_mem_iff_eq_principalFilter.mp hi_mem⟩

/-- **Fact 2.5(5), second sentence** (Goldblatt p. 19): Every nonprincipal ultrafilter
(`∀ i, F ≠ principalFilter i`) contains all cofinite sets (`cofiniteSetFilter I ≤ F`). -/
theorem SetFilter.IsUltrafilter.cofiniteSetFilter_le_of_nonprincipal {I : Type*}
    {F : SetFilter I} (hF : F.IsUltrafilter) (hnp : ∀ i : I, F ≠ principalFilter i) :
    cofiniteSetFilter I ≤ F := by
  intro A hA_cof
  by_contra hA_not
  have hAc_mem : Aᶜ ∈ F := hF.compl_mem_iff_not_mem.mpr hA_not
  obtain ⟨i, _, hFi⟩ := hF.exists_eq_principalFilter_of_finite_mem hAc_mem hA_cof
  exact hnp i hFi

/-- Exact characterization of nonprincipal ultrafilters: an ultrafilter `F` is nonprincipal iff
`cofiniteSetFilter I ≤ F` (Goldblatt §2.5(5), p. 19; Corollary 2.6.2, p. 21). -/
theorem SetFilter.IsUltrafilter.nonprincipal_iff_cofiniteSetFilter_le {I : Type*}
    {F : SetFilter I} (hF : F.IsUltrafilter) :
    (∀ i : I, F ≠ principalFilter i) ↔ cofiniteSetFilter I ≤ F := by
  refine ⟨hF.cofiniteSetFilter_le_of_nonprincipal, fun hcof i hFi ↦ ?_⟩
  have hcompl_mem : ({i} : Set I)ᶜ ∈ cofiniteSetFilter I := by simp
  have h_in : ({i} : Set I)ᶜ ∈ F := hcof hcompl_mem
  rw [hFi, mem_principalFilter] at h_in
  exact h_in (Set.mem_singleton i)

/-- **Fact 2.5(6)** (Goldblatt p. 19): A filter `F` on `I` is an ultrafilter iff it is a maximal
proper filter on `I` (`Maximal SetFilter.IsProper F`).

(See also §2.7 Exercise 5(ii) below for the explicit deduction from `HasFIP`.) -/
theorem SetFilter.isUltrafilter_iff_maximal_isProper {I : Type*} {F : SetFilter I} :
    F.IsUltrafilter ↔ Maximal SetFilter.IsProper F := by
  constructor
  · intro hF
    refine ⟨hF.isProper, fun G hG hFG A hAG ↦ ?_⟩
    by_contra hAF
    have hAcF : Aᶜ ∈ F := hF.compl_mem_iff_not_mem.mpr hAF
    exact hG.compl_not_mem hAG (hFG hAcF)
  · intro ⟨hF_prop, hmax⟩
    refine ⟨hF_prop, fun A ↦ ?_⟩
    by_cases hAF : A ∈ F
    · exact Or.inl hAF
    · right
      let G : SetFilter I := generatedSetFilter (insert Aᶜ F.sets)
      have hG_prop : G.IsProper := by
        rintro ⟨s, hs, hsub⟩
        classical
        let s' : Finset (Set I) := s.erase Aᶜ
        have hs' : (↑s' : Set (Set I)) ⊆ F.sets := by
          intro B hB
          have hBs : B ∈ s := Finset.mem_of_mem_erase (Finset.mem_coe.mp hB)
          have hBne : B ≠ Aᶜ := Finset.ne_of_mem_erase (Finset.mem_coe.mp hB)
          exact (Set.mem_insert_iff.mp (hs hBs)).resolve_left hBne
        have hC_mem : (⋂ B ∈ s', B) ∈ F := F.biInter_finset_mem hs'
        have hCA : (⋂ B ∈ s', B) ⊆ A := by
          intro x hx
          by_contra hxA
          have hx_s : x ∈ ⋂ B ∈ s, B := by
            simp only [Set.mem_iInter] at hx ⊢
            intro B hB
            by_cases hBAc : B = Aᶜ
            · rwa [hBAc]
            · exact hx B (Finset.mem_erase.mpr ⟨hBAc, hB⟩)
          exact hsub hx_s
        exact hAF (F.superset_mem hC_mem hCA)
      have hFG : F ≤ G := fun B hB ↦
        ⟨{B}, by simpa using Set.mem_insert_of_mem Aᶜ hB, by simp⟩
      have hAcG : Aᶜ ∈ G :=
        ⟨{Aᶜ}, by simp, by simp⟩
      exact hmax hG_prop hFG hAcG

/-- **Fact 2.5(7), definition** (Goldblatt p. 19): A collection `H ⊆ 𝒫(I)` has the *finite
intersection property* (`HasFIP H`) if every finite subcollection `s` of `H` has nonempty
intersection `(⋂ B ∈ s, B).Nonempty`.

Including `s = ∅` (where `⋂ B ∈ ∅, B = Set.univ`) makes `(generatedSetFilter H).IsProper ↔ HasFIP H`
hold unconditionally even when `H = ∅` or `I` is empty; for `[Nonempty I]`, see
`hasFIP_iff_nonempty_finset` for equivalence with quantifying only over `s.Nonempty`. -/
def HasFIP {I : Type*} (H : Set (Set I)) : Prop :=
  ∀ s : Finset (Set I), (↑s : Set (Set I)) ⊆ H → (⋂ B ∈ s, B).Nonempty

/-- On a nonempty index set `I`, `HasFIP H` is equivalent to Goldblatt's formulation quantifying
over *nonempty* finite subcollections of `H` (Goldblatt §2.5(7), p. 19). -/
theorem hasFIP_iff_nonempty_finset {I : Type*} [Nonempty I] {H : Set (Set I)} :
    HasFIP H ↔
      ∀ s : Finset (Set I), s.Nonempty → (↑s : Set (Set I)) ⊆ H → (⋂ B ∈ s, B).Nonempty := by
  refine ⟨fun h s _ hs ↦ h s hs, fun h s hs ↦ ?_⟩
  rcases s.eq_empty_or_nonempty with rfl | hsne
  · simp [Set.univ_nonempty]
  · exact h s hsne hs

/-- **Fact 2.5(7)** (Goldblatt p. 19): The filter `F^ℋ` (`generatedSetFilter H`) generated by `H`
is proper iff `H` has the finite intersection property (`HasFIP H`). -/
theorem generatedSetFilter_isProper_iff_hasFIP {I : Type*} {H : Set (Set I)} :
    (generatedSetFilter H).IsProper ↔ HasFIP H := by
  constructor
  · intro hprop s hs
    rw [Set.nonempty_iff_ne_empty]
    intro hempty
    exact hprop ⟨s, hs, hempty.subset⟩
  · rintro hfip ⟨s, hs, hsub⟩
    obtain ⟨x, hx⟩ := hfip s hs
    exact hsub hx

/-- Every proper filter's underlying set family has the finite intersection property. -/
theorem SetFilter.isProper_iff_hasFIP {I : Type*} {F : SetFilter I} :
    F.IsProper ↔ HasFIP F.sets := by
  constructor
  · intro hF s hs
    exact hF.nonempty_of_mem (F.biInter_finset_mem hs)
  · intro hfip hempty
    obtain ⟨x, hx⟩ := hfip {∅} (by simpa using hempty)
    simp at hx

/-- **Fact 2.5(8)** (Goldblatt p. 19): If `H` has the finite intersection property, then for any
`A ⊆ I`, at least one of `H ∪ {A}` (`insert A H`) and `H ∪ {Aᶜ}` (`insert Aᶜ H`) has the finite
intersection property. -/
theorem HasFIP.insert_or_insert_compl {I : Type*} {H : Set (Set I)} (hH : HasFIP H) (A : Set I) :
    HasFIP (insert A H) ∨ HasFIP (insert Aᶜ H) := by
  classical
  by_contra hnot
  push Not at hnot
  obtain ⟨hnot₁, hnot₂⟩ := hnot
  unfold HasFIP at hnot₁ hnot₂
  push Not at hnot₁ hnot₂
  rcases hnot₁ with ⟨s₁, hs₁, hempty₁⟩
  rcases hnot₂ with ⟨s₂, hs₂, hempty₂⟩
  let t₁ : Finset (Set I) := s₁.erase A
  let t₂ : Finset (Set I) := s₂.erase Aᶜ
  have ht₁ : (↑t₁ : Set (Set I)) ⊆ H := fun B hB ↦
    (Set.mem_insert_iff.mp (hs₁ (Finset.mem_of_mem_erase (Finset.mem_coe.mp hB)))).resolve_left
      (Finset.ne_of_mem_erase (Finset.mem_coe.mp hB))
  have ht₂ : (↑t₂ : Set (Set I)) ⊆ H := fun B hB ↦
    (Set.mem_insert_iff.mp (hs₂ (Finset.mem_of_mem_erase (Finset.mem_coe.mp hB)))).resolve_left
      (Finset.ne_of_mem_erase (Finset.mem_coe.mp hB))
  have ht_union : (↑(t₁ ∪ t₂) : Set (Set I)) ⊆ H := by
    rw [Finset.coe_union]
    exact Set.union_subset ht₁ ht₂
  obtain ⟨x, hx⟩ := hH (t₁ ∪ t₂) ht_union
  simp only [Set.mem_iInter, Finset.mem_union] at hx
  by_cases hxA : x ∈ A
  · have hx_s₁ : x ∈ ⋂ B ∈ s₁, B := by
      simp only [Set.mem_iInter]
      intro B hB
      by_cases hBA : B = A
      · rwa [hBA]
      · exact hx B (Or.inl (Finset.mem_erase.mpr ⟨hBA, hB⟩))
    rw [hempty₁] at hx_s₁
    exact hx_s₁
  · have hx_s₂ : x ∈ ⋂ B ∈ s₂, B := by
      simp only [Set.mem_iInter]
      intro B hB
      by_cases hBAc : B = Aᶜ
      · rwa [hBAc]
      · exact hx B (Or.inr (Finset.mem_erase.mpr ⟨hBAc, hB⟩))
    rw [hempty₂] at hx_s₂
    exact hx_s₂

/-!
## §2.6 — Zorn's Lemma, Theorem 2.6.1, and Corollary 2.6.2 (Goldblatt pp. 19–21)
-/

/-- Auxiliary inclusion `H ⊆ (generatedSetFilter H).sets`
(Goldblatt §2.4(3), Exercise 2.7(4)(i)). -/
theorem subset_generatedSetFilter {I : Type*} (H : Set (Set I)) :
    H ⊆ (generatedSetFilter H).sets := fun B hB ↦
  ⟨{B}, by simpa using hB, by simp⟩

/-- **Theorem 2.6.1 (Ultrafilter Theorem)** (Goldblatt §2.6, p. 20):
Any collection `H` of subsets of `I` with the finite intersection property can be extended to an
ultrafilter on `I`.

Proved directly via `zorn_le` on the poset `P = {F : SetFilter I // F.IsProper ∧ H ⊆ F.sets}`
ordered by set inclusion `⊆`, following Goldblatt's exact argument on p. 20. -/
theorem exists_ultrafilter_extending_fip {I : Type*} {H : Set (Set I)} (hH : HasFIP H) :
    ∃ F : SetFilter I, F.IsUltrafilter ∧ H ⊆ F.sets := by
  let P := {F : SetFilter I // F.IsProper ∧ H ⊆ F.sets}
  have hF₀ : (generatedSetFilter H).IsProper ∧ H ⊆ (generatedSetFilter H).sets :=
    ⟨generatedSetFilter_isProper_iff_hasFIP.mpr hH, subset_generatedSetFilter H⟩
  obtain ⟨⟨F, hF_prop, hHF⟩, hF_max⟩ := zorn_le (α := P) fun c hc ↦ by
    rcases c.eq_empty_or_nonempty with rfl | hc_ne
    · exact ⟨⟨generatedSetFilter H, hF₀⟩, fun _ hx ↦ hx.elim⟩
    · let C : Set (SetFilter I) := Subtype.val '' c
      have hC_ne : C.Nonempty := hc_ne.image Subtype.val
      have hC_chain : IsChain (· ≤ ·) C := by
        rintro _ ⟨x, hxc, rfl⟩ _ ⟨y, hyc, rfl⟩ hne
        exact hc hxc hyc fun hxy ↦ hne (congrArg Subtype.val hxy)
      have hC_prop : ∀ G ∈ C, G.IsProper := by
        rintro _ ⟨x, _, rfl⟩
        exact x.2.1
      have hU_prop : (chainUnionFilter hC_chain hC_ne).IsProper :=
        chainUnionFilter_isProper hC_chain hC_ne hC_prop
      obtain ⟨x₀, hx₀⟩ := hc_ne
      have hHU : H ⊆ (chainUnionFilter hC_chain hC_ne).sets :=
        x₀.2.2.trans (le_chainUnionFilter hC_chain hC_ne ⟨x₀, hx₀, rfl⟩)
      refine ⟨⟨chainUnionFilter hC_chain hC_ne, hU_prop, hHU⟩, ?_⟩
      intro x hxc
      exact le_chainUnionFilter hC_chain hC_ne ⟨x, hxc, rfl⟩
  have hmax_proper : Maximal SetFilter.IsProper F := by
    refine ⟨hF_prop, fun G hG_prop hFG ↦ ?_⟩
    have hHG : H ⊆ G.sets := hHF.trans hFG
    exact @hF_max ⟨G, hG_prop, hHG⟩ hFG
  exact ⟨F, SetFilter.isUltrafilter_iff_maximal_isProper.mpr hmax_proper, hHF⟩

/-- Every proper filter on `I` can be extended to an ultrafilter on `I`
(Goldblatt §2.6, Theorem 2.6.1, p. 20). -/
theorem exists_ultrafilter_extending_proper {I : Type*} {F₀ : SetFilter I} (hF₀ : F₀.IsProper) :
    ∃ F : SetFilter I, F.IsUltrafilter ∧ F₀ ≤ F :=
  exists_ultrafilter_extending_fip (SetFilter.isProper_iff_hasFIP.mp hF₀)

/-- **Corollary 2.6.2** (Goldblatt §2.6, p. 21):
Any infinite type `I` admits a nonprincipal ultrafilter on it. -/
theorem exists_nonprincipal_ultrafilter (I : Type*) [Infinite I] :
    ∃ F : SetFilter I, F.IsUltrafilter ∧ ∀ i : I, F ≠ principalFilter i := by
  have hcof_prop : (cofiniteSetFilter I).IsProper :=
    (cofiniteSetFilter_isProper_iff_infinite I).mpr ‹Infinite I›
  obtain ⟨F, hF_ultra, hcof_le⟩ := exists_ultrafilter_extending_proper hcof_prop
  refine ⟨F, hF_ultra, fun i hFi ↦ ?_⟩
  have hcompl_cof : ({i} : Set I)ᶜ ∈ cofiniteSetFilter I := by simp
  have hcompl_F : ({i} : Set I)ᶜ ∈ F := hcof_le hcompl_cof
  have hi_not_F : ({i} : Set I) ∉ F := hF_ultra.compl_mem_iff_not_mem.mp hcompl_F
  exact hi_not_F (hFi ▸ singleton_mem_principalFilter i)

/-!
## §2.7 — Exercises on Filters (1)–(5) (Goldblatt p. 21)
-/

/-- A singleton collection `{A}` has the finite intersection property whenever `A` is nonempty. -/
theorem hasFIP_singleton_of_nonempty {I : Type*} {A : Set I} (hA : A.Nonempty) :
    HasFIP ({A} : Set (Set I)) := by
  obtain ⟨x, hx⟩ := hA
  intro s hs
  refine ⟨x, Set.mem_iInter₂.mpr fun B hB ↦ ?_⟩
  have hBA : B = A := Set.mem_singleton_iff.mp (hs (Finset.mem_coe.mpr hB))
  rwa [hBA]

/-- **Exercise 2.7(1)** (Goldblatt p. 21):
If `∅ ≠ A ⊆ I`, then there is an ultrafilter `F` on `I` with `A ∈ F`. -/
theorem exists_ultrafilter_mem_of_nonempty {I : Type*} {A : Set I} (hA : A.Nonempty) :
    ∃ F : SetFilter I, F.IsUltrafilter ∧ A ∈ F := by
  obtain ⟨F, hF, hAF⟩ := exists_ultrafilter_extending_fip (hasFIP_singleton_of_nonempty hA)
  exact ⟨F, hF, hAF (Set.mem_singleton A)⟩

/-- General helper for **Exercise 2.7(2)**: If `A ⊆ I` is infinite, then adding `A` to the
cofinite filter `(cofiniteSetFilter I).sets` preserves the finite intersection property, hence
yields a nonprincipal ultrafilter on `I` containing `A`. -/
theorem exists_nonprincipal_ultrafilter_mem_of_infinite {I : Type*} {A : Set I} (hA : A.Infinite) :
    ∃ F : SetFilter I, F.IsUltrafilter ∧ (∀ i : I, F ≠ principalFilter i) ∧ A ∈ F := by
  have hfip : HasFIP (insert A (cofiniteSetFilter I).sets) := by
    classical
    intro s hs
    let s' : Finset (Set I) := s.erase A
    have hs' : (↑s' : Set (Set I)) ⊆ (cofiniteSetFilter I).sets := fun B hB ↦
      (Set.mem_insert_iff.mp (hs (Finset.mem_of_mem_erase (Finset.mem_coe.mp hB)))).resolve_left
        (Finset.ne_of_mem_erase (Finset.mem_coe.mp hB))
    have hC_cof : (⋂ B ∈ s', B) ∈ cofiniteSetFilter I :=
      (cofiniteSetFilter I).biInter_finset_mem hs'
    have hAC_inf : (A ∩ ⋂ B ∈ s', B).Infinite := by
      refine (hA.sdiff hC_cof).mono ?_
      intro x ⟨hxA, hx_not_compl⟩
      exact ⟨hxA, Set.notMem_compl_iff.mp hx_not_compl⟩
    obtain ⟨x, hxA, hxC⟩ := hAC_inf.nonempty
    refine ⟨x, Set.mem_iInter₂.mpr fun B hB ↦ ?_⟩
    by_cases hBA : B = A
    · rwa [hBA]
    · exact Set.mem_iInter₂.mp hxC B (Finset.mem_erase.mpr ⟨hBA, hB⟩)
  obtain ⟨F, hF_ultra, hsub⟩ := exists_ultrafilter_extending_fip hfip
  have hcof_le : cofiniteSetFilter I ≤ F := fun B hB ↦ hsub (Set.mem_insert_of_mem A hB)
  exact ⟨F, hF_ultra, hF_ultra.nonprincipal_iff_cofiniteSetFilter_le.mpr hcof_le,
    hsub (Set.mem_insert A _)⟩

/-- **Exercise 2.7(2), first part** (Goldblatt p. 21):
There exists a nonprincipal ultrafilter on `ℕ` containing the set of even natural numbers. -/
theorem exists_nonprincipal_ultrafilter_even :
    ∃ F : SetFilter ℕ,
      F.IsUltrafilter ∧ (∀ n : ℕ, F ≠ principalFilter n) ∧ {n : ℕ | Even n} ∈ F :=
  exists_nonprincipal_ultrafilter_mem_of_infinite infinite_even_nat

/-- **Exercise 2.7(2), second part** (Goldblatt p. 21):
There exists a nonprincipal ultrafilter on `ℕ` containing the set of odd natural numbers. -/
theorem exists_nonprincipal_ultrafilter_odd :
    ∃ F : SetFilter ℕ,
      F.IsUltrafilter ∧ (∀ n : ℕ, F ≠ principalFilter n) ∧ {n : ℕ | Odd n} ∈ F :=
  exists_nonprincipal_ultrafilter_mem_of_infinite infinite_odd_nat

/-- **Exercise 2.7(2), combined** (Goldblatt p. 21):
There exist two distinct nonprincipal ultrafilters on `ℕ`, one containing `{n | Even n}` and
the other containing `{n | Odd n}` (answering the question posed at the end of §2.2, p. 17). -/
theorem exists_nonprincipal_ultrafilters_even_and_odd :
    ∃ F_even F_odd : SetFilter ℕ,
      F_even ≠ F_odd ∧
      F_even.IsUltrafilter ∧ (∀ n : ℕ, F_even ≠ principalFilter n) ∧ {n : ℕ | Even n} ∈ F_even ∧
      F_odd.IsUltrafilter ∧ (∀ n : ℕ, F_odd ≠ principalFilter n) ∧ {n : ℕ | Odd n} ∈ F_odd := by
  obtain ⟨F_even, hFe_u, hFe_np, hFe_mem⟩ := exists_nonprincipal_ultrafilter_even
  obtain ⟨F_odd, hFo_u, hFo_np, hFo_mem⟩ := exists_nonprincipal_ultrafilter_odd
  refine ⟨F_even, F_odd, ?_, hFe_u, hFe_np, hFe_mem, hFo_u, hFo_np, hFo_mem⟩
  intro heq
  have hodd_in_even : {n : ℕ | Odd n} ∈ F_even := heq ▸ hFo_mem
  obtain ⟨n, hn_even, hn_odd⟩ :=
    hFe_u.isProper.nonempty_of_mem (F_even.inter_mem hFe_mem hodd_in_even)
  exact (Nat.not_even_iff_odd.mpr hn_odd) hn_even

/-- **Exercise 2.7(3)** (Goldblatt p. 21; also §2.4(1), p. 18):
Every ultrafilter on a finite type `I` must be principal (`∃ i : I, F = principalFilter i`). -/
theorem exists_eq_principalFilter_of_finite {I : Type*} [Finite I] {F : SetFilter I}
    (hF : F.IsUltrafilter) :
    ∃ i : I, F = principalFilter i := by
  obtain ⟨i, _, rfl⟩ := hF.exists_eq_principalFilter_of_finite_mem F.univ_mem Set.finite_univ
  exact ⟨i, rfl⟩

/-- **Exercise 2.7(4)(i)** (Goldblatt p. 21):
For `H ⊆ 𝒫(I)`, `generatedSetFilter H` is a filter on `I` that includes `H`
(`H ⊆ (generatedSetFilter H).sets`). -/
theorem exercise_2_7_4_i {I : Type*} (H : Set (Set I)) :
    H ⊆ (generatedSetFilter H).sets :=
  subset_generatedSetFilter H

/-- **Exercise 2.7(4)(ii)** (Goldblatt p. 21):
`generatedSetFilter H` is included in any filter `G` on `I` that includes `H`. -/
theorem generatedSetFilter_le {I : Type*} {H : Set (Set I)} {G : SetFilter I}
    (hHG : H ⊆ G.sets) :
    generatedSetFilter H ≤ G := by
  rintro A ⟨s, hsH, hsub⟩
  exact G.mem_of_finset_iInter_subset (hsH.trans hHG) hsub

/-- Combined characterization for **Exercise 2.7(4)(i)–(ii)**:
`generatedSetFilter H ≤ G ↔ H ⊆ G.sets`
(`generatedSetFilter` is left adjoint to `SetFilter.sets`). -/
@[simp]
theorem generatedSetFilter_le_iff {I : Type*} {H : Set (Set I)} {G : SetFilter I} :
    generatedSetFilter H ≤ G ↔ H ⊆ G.sets :=
  ⟨fun h ↦ (subset_generatedSetFilter H).trans h, generatedSetFilter_le⟩

/-- `generatedSetFilter H` corresponds to Mathlib's `Filter.generate H`. -/
@[simp]
theorem toFilter_generatedSetFilter {I : Type*} (H : Set (Set I)) :
    (generatedSetFilter H).toFilter = Filter.generate H := by
  apply le_antisymm
  · rw [Filter.le_generate_iff]
    exact subset_generatedSetFilter H
  · change generatedSetFilter H ≤ SetFilter.ofFilter (Filter.generate H)
    rw [generatedSetFilter_le_iff]
    exact fun B hB ↦ Filter.mem_generate_of_mem hB

/-- **Exercise 2.7(5)(i)** (Goldblatt p. 21):
For a proper filter `F` on `I` and any `A ⊆ I`, `F ∪ {Aᶜ}` (`insert Aᶜ F.sets`) has the finite
intersection property iff `A ∉ F`. -/
theorem hasFIP_insert_compl_iff_not_mem {I : Type*} {F : SetFilter I} (_hF : F.IsProper)
    (A : Set I) :
    HasFIP (insert Aᶜ F.sets) ↔ A ∉ F := by
  classical
  constructor
  · intro hfip hAF
    have hs : (↑({Aᶜ, A} : Finset (Set I)) : Set (Set I)) ⊆ insert Aᶜ F.sets := by
      intro B hB
      simp only [Finset.coe_insert, Finset.coe_singleton, Set.mem_insert_iff,
        Set.mem_singleton_iff] at hB
      rcases hB with rfl | rfl
      · exact Set.mem_insert _ _
      · exact Set.mem_insert_of_mem _ hAF
    obtain ⟨x, hx⟩ := hfip {Aᶜ, A} hs
    simp only [Finset.mem_insert, Finset.mem_singleton, Set.mem_iInter, forall_eq_or_imp,
      forall_eq] at hx
    exact hx.1 hx.2
  · intro hnotAF s hs
    let s' : Finset (Set I) := s.erase Aᶜ
    have hs' : (↑s' : Set (Set I)) ⊆ F.sets := fun B hB ↦
      (Set.mem_insert_iff.mp (hs (Finset.mem_of_mem_erase (Finset.mem_coe.mp hB)))).resolve_left
        (Finset.ne_of_mem_erase (Finset.mem_coe.mp hB))
    have hC_mem : (⋂ B ∈ s', B) ∈ F := F.biInter_finset_mem hs'
    rw [Set.nonempty_iff_ne_empty]
    intro hempty
    have hCA : (⋂ B ∈ s', B) ⊆ A := by
      intro x hx
      by_contra hxA
      have hx_s : x ∈ ⋂ B ∈ s, B := by
        simp only [Set.mem_iInter] at hx ⊢
        intro B hB
        by_cases hBAc : B = Aᶜ
        · rwa [hBAc]
        · exact hx B (Finset.mem_erase.mpr ⟨hBAc, hB⟩)
      rw [hempty] at hx_s
      exact hx_s
    exact hnotAF (F.superset_mem hC_mem hCA)

/-- **Exercise 2.7(5)(ii)** (Goldblatt p. 21):
Deduction of **Fact 2.5(6)** (`F.IsUltrafilter ↔ Maximal SetFilter.IsProper F`) directly from
Exercise 2.7(5)(i) (`hasFIP_insert_compl_iff_not_mem`), Fact 2.5(7)
(`generatedSetFilter_isProper_iff_hasFIP`), and Exercise 2.7(4)(i) (`subset_generatedSetFilter`),
without invoking `SetFilter.isUltrafilter_iff_maximal_isProper`. -/
theorem isUltrafilter_iff_maximal_isProper_of_hasFIP {I : Type*} (F : SetFilter I) :
    F.IsUltrafilter ↔ Maximal SetFilter.IsProper F := by
  constructor
  · intro ⟨hF_prop, hdich⟩
    refine ⟨hF_prop, fun G hG_prop hFG A hAG ↦ ?_⟩
    by_contra hAF
    have hAcG : Aᶜ ∈ G := hFG ((hdich A).resolve_left hAF)
    have hinsert_eq : insert Aᶜ G.sets = G.sets := Set.insert_eq_of_mem hAcG
    have hfip_insert : HasFIP (insert Aᶜ G.sets) := by
      rw [hinsert_eq]
      exact SetFilter.isProper_iff_hasFIP.mp hG_prop
    exact ((hasFIP_insert_compl_iff_not_mem hG_prop A).mp hfip_insert) hAG
  · intro ⟨hF_prop, hmax⟩
    refine ⟨hF_prop, fun A ↦ ?_⟩
    by_cases hAF : A ∈ F
    · exact Or.inl hAF
    · right
      have hfip : HasFIP (insert Aᶜ F.sets) :=
        (hasFIP_insert_compl_iff_not_mem hF_prop A).mpr hAF
      have hG_prop : (generatedSetFilter (insert Aᶜ F.sets)).IsProper :=
        generatedSetFilter_isProper_iff_hasFIP.mpr hfip
      have hsub : insert Aᶜ F.sets ⊆ (generatedSetFilter (insert Aᶜ F.sets)).sets :=
        subset_generatedSetFilter (insert Aᶜ F.sets)
      have hFG : F ≤ generatedSetFilter (insert Aᶜ F.sets) :=
        fun B hB ↦ hsub (Set.mem_insert_of_mem Aᶜ hB)
      have hGF : generatedSetFilter (insert Aᶜ F.sets) ≤ F :=
        hmax hG_prop hFG
      exact hGF (hsub (Set.mem_insert Aᶜ F.sets))

/-- Filter-based sequence equivalence `r ≈_F s ↔ agreementSet r s ∈ F` motivated in
Goldblatt §2.2 (pp. 16–17) and used in Chapter 3 to construct `*ℝ`. -/
def agreementEquiv {α : Type*} (F : SetFilter ℕ) (r s : ℕ → α) : Prop :=
  agreementSet r s ∈ F

/-- For *any* filter `F` on `ℕ`, `agreementEquiv F` is an equivalence relation on `ℕ → α`
(Goldblatt §2.2, pp. 16–17). -/
theorem agreementEquiv_equivalence {α : Type*} (F : SetFilter ℕ) :
    Equivalence (agreementEquiv (α := α) F) where
  refl r := by
    change agreementSet r r ∈ F
    rw [agreementSet_refl]
    exact F.univ_mem
  symm {r s} hrs := by
    change agreementSet s r ∈ F
    rwa [agreementSet_symm]
  trans {r s t} hrs hst :=
    F.superset_mem (F.inter_mem hrs hst) (agreementSet_inter_subset_trans r s t)

/-- If `F` is an ultrafilter on `ℕ`, then for any two real sequences `r, s : ℕ → ℝ`,
exactly one of `E_{rs} ∈ F`, `L_{rs} ∈ F`, or `L_{sr} ∈ F` holds (fulfilling the linear-order
motivation of Goldblatt §2.2, p. 17). -/
theorem SetFilter.IsUltrafilter.sequence_trichotomy {F : SetFilter ℕ} (hF : F.IsUltrafilter)
    (r s : ℕ → ℝ) :
    (agreementSet r s ∈ F ∧ lessThanSet r s ∉ F ∧ lessThanSet s r ∉ F) ∨
    (agreementSet r s ∉ F ∧ lessThanSet r s ∈ F ∧ lessThanSet s r ∉ F) ∨
    (agreementSet r s ∉ F ∧ lessThanSet r s ∉ F ∧ lessThanSet s r ∈ F) := by
  have huniv : agreementSet r s ∪ lessThanSet r s ∪ lessThanSet s r ∈ F := by
    rw [agreementSet_union_lessThanSets]
    exact F.univ_mem
  have hnot_eq_lt : ¬ (agreementSet r s ∈ F ∧ lessThanSet r s ∈ F) := by
    rintro ⟨heq, hlt⟩
    obtain ⟨n, hn_eq, hn_lt⟩ := hF.isProper.nonempty_of_mem (F.inter_mem heq hlt)
    exact (ne_of_lt hn_lt) hn_eq
  have hnot_eq_gt : ¬ (agreementSet r s ∈ F ∧ lessThanSet s r ∈ F) := by
    rintro ⟨heq, hgt⟩
    obtain ⟨n, hn_eq, hn_gt⟩ := hF.isProper.nonempty_of_mem (F.inter_mem heq hgt)
    exact (ne_of_gt hn_gt) hn_eq
  have hnot_lt_gt : ¬ (lessThanSet r s ∈ F ∧ lessThanSet s r ∈ F) := by
    rintro ⟨hlt, hgt⟩
    obtain ⟨n, hn_lt, hn_gt⟩ := hF.isProper.nonempty_of_mem (F.inter_mem hlt hgt)
    exact lt_asymm (mem_lessThanSet.mp hn_lt) (mem_lessThanSet.mp hn_gt)
  rcases hF.union_mem_iff.mp huniv with h_eq_or_lt | hgt
  · rcases hF.union_mem_iff.mp h_eq_or_lt with heq | hlt
    · exact Or.inl ⟨heq, fun hlt ↦ hnot_eq_lt ⟨heq, hlt⟩, fun hgt ↦ hnot_eq_gt ⟨heq, hgt⟩⟩
    · exact Or.inr (Or.inl ⟨fun heq ↦ hnot_eq_lt ⟨heq, hlt⟩, hlt,
        fun hgt ↦ hnot_lt_gt ⟨hlt, hgt⟩⟩)
  · exact Or.inr (Or.inr ⟨fun heq ↦ hnot_eq_gt ⟨heq, hgt⟩,
      fun hlt ↦ hnot_lt_gt ⟨hlt, hgt⟩, hgt⟩)

end Ch02

